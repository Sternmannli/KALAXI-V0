+"""
+similarity.py — Structural Similarity Scoring
+
+Computes similarity between event fingerprints using a weighted
+combination of Jaccard set overlap and exact-match scalars.
+
+Used for automatic echo detection: surfacing pairs of events that
+share hidden structural similarity above a configurable threshold.
+
+Reference: Temporal Knowledge Graph reasoning literature, 2025.
+"""
+
+from typing import Any, Dict, List, Set
+
+
+def structural_fingerprint(event: dict, set_fields: List[str],
+                           scalar_fields: List[str]) -> dict:
+    """
+    Extract a structural fingerprint from an event dict.
+
+    Args:
+        event: the event dictionary
+        set_fields: keys whose values are lists (converted to sets for Jaccard)
+        scalar_fields: keys whose values are compared for exact match
+
+    Returns:
+        Fingerprint dict with sets and scalars separated.
+    """
+    fp = {"sets": {}, "scalars": {}}
+    for f in set_fields:
+        val = event.get(f, [])
+        fp["sets"][f] = set(val) if isinstance(val, (list, tuple, set)) else set()
+    for f in scalar_fields:
+        fp["scalars"][f] = event.get(f)
+    return fp
+
+
+def jaccard(a: set, b: set) -> float:
+    """Jaccard similarity between two sets."""
+    if not a and not b:
+        return 0.0
+    union = a | b
+    inter = a & b
+    return len(inter) / len(union) if union else 0.0
+
+
+def structural_similarity(fp_a: dict, fp_b: dict,
+                          set_weights: Dict[str, float] = None,
+                          scalar_weights: Dict[str, float] = None) -> float:
+    """
+    Compute weighted structural similarity between two fingerprints.
+
+    Args:
+        fp_a, fp_b: fingerprints from structural_fingerprint()
+        set_weights: {field_name: weight} for set fields (Jaccard)
+        scalar_weights: {field_name: weight} for scalar fields (exact match)
+
+    Returns:
+        Similarity score in [0.0, 1.0].
+    """
+    set_weights = set_weights or {}
+    scalar_weights = scalar_weights or {}
+    score = 0.0
+    total_weight = 0.0
+
+    for field, weight in set_weights.items():
+        total_weight += weight
+        a_set = fp_a["sets"].get(field, set())
+        b_set = fp_b["sets"].get(field, set())
+        score += weight * jaccard(a_set, b_set)
+
+    for field, weight in scalar_weights.items():
+        total_weight += weight
+        if fp_a["scalars"].get(field) == fp_b["scalars"].get(field):
+            score += weight
+
+    return round(score / total_weight, 4) if total_weight > 0 else 0.0
+
+
+def detect_echoes(events: List[dict],
+                  set_fields: List[str],
+                  scalar_fields: List[str],
+                  set_weights: Dict[str, float],
+                  scalar_weights: Dict[str, float],
+                  threshold: float = 0.6,
+                  recent_n: int = 30,
+                  id_field: str = "event_id") -> List[dict]:
+    """
+    Scan recent events against older events for structural echoes.
+
+    Args:
+        events: list of event dicts (ordered by time)
+        set_fields: fields to treat as sets for Jaccard
+        scalar_fields: fields to compare as exact match
+        set_weights: weight per set field
+        scalar_weights: weight per scalar field
+        threshold: minimum similarity to report
+        recent_n: how many recent events to scan
+        id_field: key for event identifier
+
+    Returns:
+        List of echo dicts with event pair and similarity score.
+    """
+    recent = events[-recent_n:]
+    older = events[:-recent_n] if len(events) > recent_n else []
+    detected = []
+
+    for evt_a in recent:
+        fp_a = structural_fingerprint(evt_a, set_fields, scalar_fields)
+        for evt_b in older:
+            fp_b = structural_fingerprint(evt_b, set_fields, scalar_fields)
+            sim = structural_similarity(fp_a, fp_b, set_weights, scalar_weights)
+            if sim >= threshold:
+                detected.append({
+                    "event_a": evt_a.get(id_field),
+                    "event_b": evt_b.get(id_field),
+                    "similarity": sim,
+                })
+
+    # Deduplicate by pair, keep highest similarity
+    seen = {}
+    for echo in detected:
+        pair = tuple(sorted([echo["event_a"], echo["event_b"]]))
+        if pair not in seen or echo["similarity"] > seen[pair]["similarity"]:
+            seen[pair] = echo
+    return list(seen.values())
