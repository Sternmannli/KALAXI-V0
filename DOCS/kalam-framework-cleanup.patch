+"""
+change_detector.py — Rupture vs Smooth Change Detection
+
+Classifies metric trajectories into four modes:
+  - RUPTURE: sudden large drop in a single step
+  - SMOOTH: gradual decline over multiple steps
+  - RECOVERY: upward movement after prior decline
+  - STABLE: no significant change
+
+Key insight: gradual decline and sudden collapse require fundamentally
+different responses. This detector distinguishes them.
+
+Reference: Temporal Knowledge Graph reasoning literature, 2025.
+"""
+
+from enum import Enum
+from typing import List, Tuple
+
+
+class ChangeMode(Enum):
+    """Classification of metric trajectory change."""
+    SMOOTH = "smooth"
+    RUPTURE = "rupture"
+    STABLE = "stable"
+    RECOVERY = "recovery"
+
+
+def detect_change_mode(
+    readings: List[Tuple[float, str]],
+    rupture_threshold: float = 0.4,
+    smooth_window: int = 3,
+    smooth_total_drop: float = 0.3,
+) -> dict:
+    """
+    Classify a sequence of metric readings into a change mode.
+
+    Args:
+        readings: list of (score, reading_id) tuples, ordered by time
+        rupture_threshold: single-step drop >= this triggers RUPTURE
+        smooth_window: number of recent readings to check for gradual decline
+        smooth_total_drop: cumulative drop over window for SMOOTH classification
+
+    Returns:
+        dict with keys: mode, message, response, details
+    """
+    if len(readings) < 2:
+        return {
+            "mode": ChangeMode.STABLE.value,
+            "message": "Insufficient readings for change detection.",
+            "response": "Continue monitoring.",
+            "details": {},
+        }
+
+    current = readings[-1][0]
+    previous = readings[-2][0]
+    step_delta = current - previous
+
+    # Rupture: sudden large drop
+    if step_delta <= -rupture_threshold:
+        return {
+            "mode": ChangeMode.RUPTURE.value,
+            "message": (
+                f"Rupture detected. Score dropped {abs(step_delta):.2f} in one step "
+                f"(from {previous:.2f} to {current:.2f})."
+            ),
+            "response": "Immediate investigation required. Treat as incident, not trend.",
+            "details": {
+                "step_delta": round(step_delta, 4),
+                "current": current,
+                "previous": previous,
+                "reading_id": readings[-1][1],
+            },
+        }
+
+    # Smooth decline: gradual drop over window
+    window = readings[-smooth_window:]
+    if len(window) >= smooth_window:
+        total_drop = window[0][0] - window[-1][0]
+        all_declining = all(
+            window[i][0] >= window[i + 1][0]
+            for i in range(len(window) - 1)
+        )
+        if all_declining and total_drop >= smooth_total_drop:
+            return {
+                "mode": ChangeMode.SMOOTH.value,
+                "message": (
+                    f"Smooth decline detected. Score dropped {total_drop:.2f} over "
+                    f"{len(window)} readings (from {window[0][0]:.2f} to {window[-1][0]:.2f})."
+                ),
+                "response": "Review pattern across recent sessions. Gradual, not sudden.",
+                "details": {
+                    "total_drop": round(total_drop, 4),
+                    "window_size": len(window),
+                    "start": window[0][0],
+                    "end": window[-1][0],
+                },
+            }
+
+    # Recovery: upward after prior decline
+    if step_delta > 0 and len(readings) >= 3:
+        if readings[-3][0] > readings[-2][0] and current > previous:
+            return {
+                "mode": ChangeMode.RECOVERY.value,
+                "message": f"Recovery detected. Score rising from {previous:.2f} to {current:.2f}.",
+                "response": "Continue current approach.",
+                "details": {
+                    "step_delta": round(step_delta, 4),
+                    "current": current,
+                },
+            }
+
+    return {
+        "mode": ChangeMode.STABLE.value,
+        "message": f"Stable. Score={current:.2f}, delta={step_delta:.2f}.",
+        "response": "Continue monitoring.",
+        "details": {"current": current, "step_delta": round(step_delta, 4)},
+    }
