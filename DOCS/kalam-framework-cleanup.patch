+"""
+temporal_index.py — Dual-Track Temporal Index
+
+Splits a time-series event store into two windows:
+  - Short-term: last N days (default 7)
+  - Long-term: everything before
+
+Cross-track discovery identifies patterns that span both windows.
+The insight: short-term and long-term patterns are qualitatively
+different when analyzed separately vs mixed together.
+
+Reference: Temporal Knowledge Graph reasoning literature, 2025.
+"""
+
+from datetime import datetime, timedelta, timezone
+from typing import Any, Dict, List, Optional, Tuple
+
+
+class DualTemporalIndex:
+    """
+    Maintains two temporal tracks for event indexing.
+
+    Events are assigned to short-term or long-term based on
+    a configurable day boundary. Periodic rebalancing moves
+    aged-out events from short to long.
+
+    Usage:
+        index = DualTemporalIndex(short_term_days=7)
+        index.add("2026-03-12T10:00:00+00:00", event_id="EVT-001", metadata={...})
+        short = index.query_short_term()
+        long = index.query_long_term()
+        cross = index.cross_track_matches(match_fn=lambda a, b: a["tag"] == b["tag"])
+    """
+
+    def __init__(self, short_term_days: int = 7):
+        self._short_term_days = short_term_days
+        self._short: List[Tuple[str, str, dict]] = []  # (timestamp, event_id, metadata)
+        self._long: List[Tuple[str, str, dict]] = []
+
+    def _cutoff(self) -> datetime:
+        return datetime.now(timezone.utc) - timedelta(days=self._short_term_days)
+
+    def add(self, timestamp: str, event_id: str, metadata: Optional[dict] = None):
+        """Add an event to the appropriate temporal track."""
+        meta = metadata or {}
+        try:
+            ts = datetime.fromisoformat(timestamp)
+        except (ValueError, TypeError):
+            self._long.append((timestamp, event_id, meta))
+            return
+        if ts >= self._cutoff():
+            self._short.append((timestamp, event_id, meta))
+        else:
+            self._long.append((timestamp, event_id, meta))
+
+    def rebalance(self):
+        """Move aged-out events from short-term to long-term."""
+        cutoff = self._cutoff()
+        still_short = []
+        for ts_str, eid, meta in self._short:
+            try:
+                ts = datetime.fromisoformat(ts_str)
+                if ts >= cutoff:
+                    still_short.append((ts_str, eid, meta))
+                else:
+                    self._long.append((ts_str, eid, meta))
+            except (ValueError, TypeError):
+                self._long.append((ts_str, eid, meta))
+        self._short = still_short
+
+    def query_short_term(self) -> List[Tuple[str, str, dict]]:
+        """Return all short-term events."""
+        self.rebalance()
+        return list(self._short)
+
+    def query_long_term(self) -> List[Tuple[str, str, dict]]:
+        """Return all long-term events."""
+        self.rebalance()
+        return list(self._long)
+
+    def cross_track_matches(self, match_fn) -> List[dict]:
+        """
+        Find pairs where a short-term event matches a long-term event.
+
+        Args:
+            match_fn: callable(short_meta, long_meta) -> bool
+
+        Returns:
+            List of match dicts with short/long event IDs.
+        """
+        self.rebalance()
+        matches = []
+        for s_ts, s_id, s_meta in self._short:
+            for l_ts, l_id, l_meta in self._long:
+                if match_fn(s_meta, l_meta):
+                    matches.append({
+                        "short_term_event": s_id,
+                        "long_term_event": l_id,
+                        "short_timestamp": s_ts,
+                        "long_timestamp": l_ts,
+                    })
+        return matches
+
+    @property
+    def short_count(self) -> int:
+        return len(self._short)
+
+    @property
+    def long_count(self) -> int:
+        return len(self._long)
+
+    @property
+    def total_count(self) -> int:
