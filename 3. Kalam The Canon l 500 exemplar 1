FILLIN_DIR = Path("fillins")
TEMPLATE_FILE = Path("templates/templates.json")

def load_jsonl(filepath: Path) -> List[Dict]:
    """Load a JSONL file (one JSON object per line)."""
    if not filepath.exists():
        return []
    with open(filepath, 'r', encoding='utf-8') as f:
        return [json.loads(line) for line in f]

def load_json(filepath: Path) -> Any:
    with open(filepath, 'r', encoding='utf-8') as f:
        return json.load(f)

def load_fillins() -> Dict[str, List[Dict]]:
    """Load all fill‑in categories."""
    return {
        "concepts": load_json(FILLIN_DIR / "concepts.json"),
        "proverbs": load_json(FILLIN_DIR / "proverbs.json"),
        "go_responses": load_json(FILLIN_DIR / "go_responses.json"),
        "silence_responses": load_json(FILLIN_DIR / "silence_responses.json"),
        "refusal_responses": load_json(FILLIN_DIR / "refusal_responses.json"),
        "themes": load_json(FILLIN_DIR / "themes.json"),
        "anomalies": load_json(FILLIN_DIR / "anomalies.json"),
        "identity_lines": load_json(FILLIN_DIR / "identity_lines.json"),
        "meta_responses": load_json(FILLIN_DIR / "meta_responses.json"),
        "ritual_responses": load_json(FILLIN_DIR / "ritual_responses.json"),
    }

FILLINS = load_fillins()
TEMPLATES = load_json(TEMPLATE_FILE)

# Counters for fill‑in usage (tiered max_uses)
usage_counter = defaultdict(lambda: defaultdict(int))

# Tiered max_uses
MAX_USES = {
    "prime": 30,
    "experiment": 15,
    "foundational": 10,
    "default": 5
}

def get_tier(proverb: Dict) -> str:
    return proverb.get("tier", "default")

def can_use(fill_type: str, item_id: str, item: Dict) -> bool:
    """Check if an item can be used based on its tier's max_uses."""
    tier = get_tier(item) if fill_type == "proverbs" else "default"
    max_allowed = MAX_USES.get(tier, MAX_USES["default"])
    return usage_counter[fill_type][item_id] < max_allowed

def use_item(fill_type: str, item_id: str):
    usage_counter[fill_type][item_id] += 1

