    """Return False if completion contains blacklisted words, True otherwise."""
    low = any(word in completion.lower() for word in LOW_CERTAINTY_BLACKLIST)
    high = any(word in completion.lower() for word in HIGH_CERTAINTY_BLACKLIST)
    if low or high:
        return False
    return True

def generate_example(type_code: str) -> Optional[Dict]:
    """Generate one example of the given type, or None if impossible."""
    tdef = TEMPLATES[type_code]
    prompt_templates = tdef["prompt_templates"]
    completion_templates = tdef["completion_templates"]
    fillins_needed = tdef.get("fillins", {})
    constraints = tdef.get("constraints", {})

    # Choose a random prompt template
    prompt_template = random.choice(prompt_templates)
    completion_template = random.choice(completion_templates)

    # Prepare fill‑in values
    fill_values = {}
    for placeholder, source in fillins_needed.items():
        if "." in source:
            cat, attr = source.split(".")
            item = pick_random(cat)
            if item is None:
                return None
            fill_values[placeholder] = item.get(attr, str(item))
        else:
            # For simple categories, we may need tag filtering
            if placeholder == "proverb" and constraints.get("proverb_theme_match") and "theme" in fill_values:
                # We need a theme already chosen (for T05)
                theme = fill_values["theme"]
                # Find a proverb that matches the theme
                proverb = pick_fill_by_tags("proverbs", [theme])
                if proverb is None:
                    # Fallback to any proverb
                    proverb = pick_random("proverbs")
                if proverb is None:
                    return None
                fill_values["proverb"] = proverb["text"]
            elif placeholder == "concept":
                concept = pick_random("concepts")
                if concept is None:
                    return None
                fill_values["concept"] = concept["text"]
                if "definition" not in fill_values and "definition" in concept:
                    fill_values["definition"] = concept["definition"]
            elif placeholder == "theme":
                theme = random.choice(FILLINS["themes"])
                fill_values["theme"] = theme
            else:
                item = pick_random(source)
                if item is None:
                    return None
                fill_values[placeholder] = item.get("text", str(item))

    # For T07 (corrections), we need to handle the correction placeholder specially
    if type_code == "T07" and "correction" in fillins_needed:
        # Use a definition as a correction
        concept = pick_random("concepts")
        if concept is None:
            return None
        fill_values["correction"] = f"{concept['text']} is actually {concept['definition']}"

    # For T06, anomaly_response should be something like "That anomaly is logged..."
    if type_code == "T06" and "anomaly_desc" in fill_values:
        fill_values["anomaly_response"] = f"That anomaly is now logged. Anomalies are the system's memory of its own edges. It may become a seed for a new proverb."

    # Render prompt and completion
    try:
        prompt = prompt_template.format(**fill_values)
        completion = completion_template.format(**fill_values)
    except KeyError as e:
        print(f"Missing fill‑in: {e}", file=sys.stderr)
        return None

    # Apply adversarial mutation if this example is selected
    if random.random() < ADVERSARIAL_RATE:
        prompt = apply_adversarial_mutation(prompt)

    # Automated certainty check
    if not check_certainty(completion):
        return None

    # Build metadata
    meta = {
        "type": type_code,
        "sources": [],  # Could be filled with IDs of used fill‑ins
        "themes": fill_values.get("themes", []),
        "template_id": id(prompt_template),  # Not great, but placeholder
        "seed": SEED,
        "version": "1.0"
    }

    example = {
        "prompt": prompt,
        "completion": completion,
        "_meta": meta
    }
    return example

# ----------------------------------------------------------------------
# Main generation loop
# ----------------------------------------------------------------------
def generate_all() -> List[Dict]:
    examples = []
    counts = Counter(TARGET_DISTRIBUTION)

    # Shuffle the order to mix types
    type_pool = []
    for t, cnt in TARGET_DISTRIBUTION.items():
        type_pool.extend([t] * cnt)
    random.shuffle(type_pool)

    for typ in type_pool:
        # Try up to 10 times to generate an example of this type
        for attempt in range(10):
            ex = generate_example(typ)
            if ex:
                examples.append(ex)
                break
        else:
            print(f"Warning: failed to generate {typ} after 10 attempts", file=sys.stderr)

    return examples

# ----------------------------------------------------------------------
# JSON Schema validation (simplified)
# ----------------------------------------------------------------------
def validate_example(ex: Dict) -> bool:
    """Check that the example has required fields."""
    required = ["prompt", "completion", "_meta"]
    return all(k in ex for k in required)

# ----------------------------------------------------------------------
# Save output
# ----------------------------------------------------------------------
def save_jsonl(examples: List[Dict], filename: str):
    with open(filename, 'w', encoding='utf-8') as f:
        for ex in examples:
            f.write(json.dumps(ex, ensure_ascii=False) + '\n')
    print(f"Saved {len(examples)} examples to {filename}")

if __name__ == "__main__":
    examples = generate_all()
    # Validate all examples
    examples = [ex for ex in examples if validate_example(ex)]
    # Trim to exactly 500 (if we have more due to fallback)
    examples = examples[:500]
    save_jsonl(examples, "kalaxi_training_500.jsonl")
