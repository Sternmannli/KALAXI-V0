def apply_adversarial_mutation(prompt: str) -> str:
    """Apply random mutations to a prompt (case noise, punctuation, typos)."""
    # Case noise
    if random.random() < 0.3:
        prompt = prompt.swapcase()
    # Extra punctuation
    if random.random() < 0.3:
        prompt += "!!!" if random.random() < 0.5 else "???"
    # Typos (swap adjacent letters occasionally)
    if random.random() < 0.2 and len(prompt) > 3:
        idx = random.randint(1, len(prompt)-2)
        lst = list(prompt)
        lst[idx], lst[idx+1] = lst[idx+1], lst[idx]
        prompt = ''.join(lst)
    return prompt

