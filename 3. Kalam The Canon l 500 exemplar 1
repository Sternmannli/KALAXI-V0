def pick_fill_by_tags(category: str, required_tags: List[str]) -> Optional[Dict]:
    """Pick a random item from category that has at least one of the required tags, respecting usage limits."""
    items = FILLINS.get(category, [])
    eligible = []
    for item in items:
        item_id = item.get("id", item.get("text", str(item)))
        if not can_use(category, item_id, item):
            continue
        item_tags = item.get("themes", [])
        if any(tag in required_tags for tag in item_tags):
            eligible.append(item)
    if not eligible:
        return None
    chosen = random.choice(eligible)
    use_item(category, chosen.get("id", chosen.get("text", str(chosen))))
    return chosen

def pick_random(category: str) -> Optional[Dict]:
    """Pick a random item from category, respecting usage limits."""
    items = FILLINS.get(category, [])
