---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KALAM.CH — The Word',
  description = 'A living canon for human dignity. Patterns, not people.',
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <!-- No tracking. No analytics scripts. No third-party requests. -->
    <!-- Dignity starts before the first pixel renders. -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect for fonts (when deployed with Google Fonts) -->
    <!-- <link rel="preconnect" href="https://fonts.googleapis.com" /> -->
    <!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /> -->

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
