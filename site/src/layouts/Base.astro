---
interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}

const {
  title = 'kalam.ch — The Word',
  description = 'A living canon for human dignity. Patterns, not people.',
  hideFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d12" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en" />
    <meta property="og:site_name" content="kalam.ch" />
    <meta property="og:image" content="https://kalam.ch/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kalam.ch/og-image.png" />

    <!-- Structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Kalam",
      "url": "https://kalam.ch",
      "description": "A constitutional framework where human dignity is the first technical requirement. D = A × L × M.",
      "founder": {
        "@type": "Person",
        "name": "Mohamed Farag"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@kalam.ch",
        "contactType": "general"
      }
    }
    </script>

    <!-- No tracking. No analytics. No third-party requests. -->
    <!-- Dignity starts before the first pixel renders. -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- PWA — app on every phone -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="kalam" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=IBM+Plex+Sans:wght@300;400;500&family=Amiri:ital@0;1&display=swap" rel="stylesheet" />

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <!-- Skip to content — accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Top Navigation — hamburger on mobile, compact on desktop -->
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class="nav-home">kalam</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <div class="nav-links" id="nav-links">
        <a href="/about">about</a>
        <a href="/canon">canon</a>
        <a href="/hakaka">hakaka</a>
        <a href="/ashwater">ashwater</a>
        <a href="/kinderbuch">kinderbuch</a>
        <a href="/kalaxi1">the same river</a>
        <a href="/r7m">r7m</a>
        <a href="/science">science</a>
        <a href="/compass">compass</a>
        <a href="/workings">workings</a>
        <a href="/museum">museum</a>
        <a href="/invitation">invitation</a>
        <a href="/silence">silence</a>
        <a href="/sustain" class="nav-sustain">sustain</a>
        <!-- Language picker -->
        <div class="lang-picker" id="lang-picker">
          <button class="lang-toggle" id="lang-toggle" aria-label="Language" aria-expanded="false">
            <span id="lang-current">EN</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="lang-menu" id="lang-menu" hidden></div>
        </div>
      </div>
    </nav>
    <script is:inline>
      document.getElementById('nav-toggle')?.addEventListener('click', function() {
        const links = document.getElementById('nav-links');
        const open = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', String(!open));
        links?.classList.toggle('nav-open');
      });

      // ── Language Picker ──
      (function() {
        var LANGS = [
          ['en','English'],['de','Deutsch'],['ar','العربية'],['fr','Français'],
          ['es','Español'],['pt','Português'],['it','Italiano'],['tr','Türkçe'],
          ['ru','Русский'],['zh','中文'],['ja','日本語'],['ko','한국어'],
          ['hi','हिन्दी'],['bn','বাংলা'],['sw','Kiswahili'],['fa','فارسی'],
          ['ur','اردو'],['nl','Nederlands'],['pl','Polski'],['uk','Українська']
        ];
        var RTL = ['ar','fa','ur'];
        var toggle = document.getElementById('lang-toggle');
        var menu = document.getElementById('lang-menu');
        var current = document.getElementById('lang-current');
        if (!toggle || !menu || !current) return;

        var saved = localStorage.getItem('kalam-lang') || 'en';
        current.textContent = saved.toUpperCase();

        // Build menu
        LANGS.forEach(function(l) {
          var btn = document.createElement('button');
          btn.className = 'lang-option' + (l[0] === saved ? ' active' : '');
          btn.innerHTML = '<span class="lang-code">' + l[0] + '</span> ' + l[1];
          btn.addEventListener('click', function() {
            localStorage.setItem('kalam-lang', l[0]);
            current.textContent = l[0].toUpperCase();
            // Set document direction for RTL languages
            document.documentElement.dir = RTL.indexOf(l[0]) >= 0 ? 'rtl' : 'ltr';
            document.documentElement.lang = l[0];
            menu.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            // Dispatch event for pages to pick up language change
            window.dispatchEvent(new CustomEvent('kalam-lang-change', { detail: { lang: l[0] } }));
            // Refresh page to apply translations
            location.reload();
          });
          menu.appendChild(btn);
        });

        // Set initial direction
        if (RTL.indexOf(saved) >= 0) {
          document.documentElement.dir = 'rtl';
          document.documentElement.lang = saved;
        } else if (saved !== 'en') {
          document.documentElement.lang = saved;
        }

        // Toggle menu
        toggle.addEventListener('click', function() {
          var open = menu.hidden;
          menu.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        });

        // Close on outside click
        document.addEventListener('click', function(e) {
          if (!toggle.contains(e.target) && !menu.contains(e.target)) {
            menu.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      })();
    </script>

    <slot />

    {!hideFooter && (
      <footer class="site-footer" role="contentinfo">
        <nav class="footer-links" aria-label="Site navigation">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/canon">Canon</a>
          <a href="/hakaka">Hakaka</a>
          <a href="/ashwater">Ashwater</a>
          <a href="/kinderbuch">Kinderbuch</a>
          <a href="/kalaxi1">The Same River</a>
          <a href="/r7m">R7M</a>
          <a href="/science">Science</a>
          <a href="/museum">Museum</a>
          <a href="/invitation">Invitation</a>
          <a href="/silence">Silence</a>
          <a href="/sustain" class="footer-sustain">Sustain</a>
        </nav>

        <div class="footer-meta">
          <p>Created by M. Farag</p>
          <p class="footer-origins">
            <span class="swiss-mark">🇪🇬 Cairo, Egypt</span>
            &nbsp;&middot;&nbsp;
            <span class="swiss-mark"><span class="swiss-flag" aria-hidden="true"></span> Zürich, Switzerland</span>
          </p>
        </div>

        <div class="footer-contact">
          <a href="mailto:info@kalam.ch">info@kalam.ch</a>
          <a href="https://kalam.ch">kalam.ch</a>
          <a href="https://github.com/Sternmannli/kalam-framework" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.reddit.com/u/Replikta" target="_blank" rel="noopener">Reddit</a>
        </div>

        <p class="legal-ribbon">
          Built in alignment with the Universal Declaration of Human Rights,
          the Swiss Federal Act on Data Protection (FADP),
          and the EU Artificial Intelligence Act.
        </p>
      </footer>
    )}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
