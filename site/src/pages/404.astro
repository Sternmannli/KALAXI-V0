---
import Base from '../layouts/Base.astro';
---

<Base title="Not Found — kalam.ch" description="This path does not exist yet." hideFooter={true}>

  <section class="lost">
    <h1>The gap.</h1>
    <p class="quiet">This path does not exist yet — but room is always left for the river.</p>
    <nav>
      <a href="/">Return home</a>
    </nav>
  </section>

</Base>

<style>
  .lost {
    min-height: 100vh;
    gap: var(--space-4);
  }

  .lost h1 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 300;
  }

  .quiet {
    color: var(--text-secondary);
    max-width: 45ch;
    margin-top: var(--space-2);
  }

  nav {
    margin-top: var(--space-8);
  }
</style>
