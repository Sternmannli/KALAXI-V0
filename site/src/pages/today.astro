---
import Base from '../layouts/Base.astro';
---

<Base title="Today — kalam.ch" description="One proverb per day. Read it. Sit with it. Carry it.">

  <main class="today-room" id="main-content">

    <!-- The proverb -->
    <div class="today-proverb" id="today-proverb" aria-live="polite"></div>
    <div class="today-id" id="today-id"></div>

    <!-- Witness count -->
    <div class="today-witness" id="today-witness"></div>

    <!-- Response -->
    <div class="today-response-area" id="response-area">
      <div class="today-question">What does this mean to you?</div>
      <textarea id="response-input" class="today-input" rows="3" maxlength="500" placeholder="..."></textarea>
      <button id="response-submit" class="today-submit">Leave your mark</button>
      <div class="today-saved" id="response-saved" hidden>Witnessed. Your words are held.</div>
    </div>

    <!-- Previous responses (from localStorage) -->
    <div class="today-others" id="today-others"></div>

    <!-- Carry (card generator) -->
    <button id="carry-btn" class="today-carry">Carry this proverb</button>

    <!-- Hidden canvas for card generation -->
    <canvas id="card-canvas" width="1080" height="1080" style="display:none;"></canvas>

    <!-- Navigation hint -->
    <div class="today-nav">
      <a href="/" class="today-home">kalam.ch</a>
    </div>

  </main>

</Base>

<style>
  .today-room {
    min-height: 100vh;
    background: #0a0a0f;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 6vw, 4rem);
    gap: 0;
    position: relative;
  }

  /* Override body/nav for dark page */
  :global(body) { background: #0a0a0f !important; }
  :global(.site-nav) { opacity: 0.2; transition: opacity 0.4s; }
  :global(.site-nav:hover), :global(.site-nav:focus-within) { opacity: 0.7; }
  :global(.site-nav a), :global(.nav-toggle-bar) { color: #e6dcc4 !important; background: #e6dcc4 !important; }
  :global(.site-footer) { background: #0a0a0f !important; border-top-color: rgba(230, 220, 196, 0.1) !important; }
  :global(.site-footer a), :global(.site-footer p) { color: rgba(230, 220, 196, 0.3) !important; }

  .today-proverb {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 300;
    color: #e6dcc4;
    text-align: center;
    line-height: 1.5;
    max-width: 28ch;
    opacity: 0;
    animation: proverbFadeIn 3s ease 1s forwards;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-2, 1rem);
  }

  .today-id {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.75rem;
    color: rgba(155, 107, 0, 0.5);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0;
    animation: proverbFadeIn 2s ease 2.5s forwards;
    margin-bottom: var(--space-6, 3rem);
  }

  .today-witness {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.8rem;
    color: rgba(230, 220, 196, 0.25);
    letter-spacing: 0.1em;
    opacity: 0;
    animation: proverbFadeIn 2s ease 3s forwards;
    margin-bottom: var(--space-8, 4rem);
  }

  .today-response-area {
    width: 100%;
    max-width: 36ch;
    opacity: 0;
    animation: proverbFadeIn 2s ease 4s forwards;
    text-align: center;
  }

  .today-question {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1rem;
    color: rgba(230, 220, 196, 0.4);
    font-style: italic;
    margin-bottom: var(--space-3, 1.5rem);
  }

  .today-input {
    width: 100%;
    background: rgba(230, 220, 196, 0.04);
    border: 1px solid rgba(230, 220, 196, 0.1);
    border-radius: 4px;
    color: #e6dcc4;
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.95rem;
    padding: var(--space-2, 1rem);
    resize: none;
    outline: none;
    transition: border-color 0.3s;
    line-height: 1.6;
  }

  .today-input:focus {
    border-color: rgba(155, 107, 0, 0.4);
  }

  .today-input::placeholder {
    color: rgba(230, 220, 196, 0.15);
  }

  .today-submit {
    margin-top: var(--space-2, 1rem);
    background: none;
    border: 1px solid rgba(155, 107, 0, 0.3);
    color: rgba(155, 107, 0, 0.7);
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.85rem;
    padding: 0.5rem 1.5rem;
    cursor: pointer;
    border-radius: 2px;
    letter-spacing: 0.05em;
    transition: all 0.3s;
  }

  .today-submit:hover {
    border-color: rgba(155, 107, 0, 0.6);
    color: rgba(155, 107, 0, 1);
  }

  .today-saved {
    margin-top: var(--space-2, 1rem);
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.8rem;
    color: rgba(155, 107, 0, 0.5);
    font-style: italic;
  }

  .today-others {
    margin-top: var(--space-8, 4rem);
    width: 100%;
    max-width: 36ch;
    opacity: 0;
    animation: proverbFadeIn 2s ease 5s forwards;
  }

  .today-others .other-response {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.85rem;
    color: rgba(230, 220, 196, 0.2);
    padding: var(--space-2, 1rem) 0;
    border-bottom: 1px solid rgba(230, 220, 196, 0.04);
    line-height: 1.6;
  }

  .today-carry {
    margin-top: var(--space-6, 3rem);
    background: none;
    border: none;
    color: rgba(155, 107, 0, 0.35);
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    text-transform: uppercase;
    transition: color 0.3s;
    opacity: 0;
    animation: proverbFadeIn 2s ease 5.5s forwards;
  }

  .today-carry:hover {
    color: rgba(155, 107, 0, 0.8);
  }

  .today-nav {
    position: fixed;
    bottom: var(--space-4, 2rem);
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: proverbFadeIn 2s ease 6s forwards;
  }

  .today-home {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 0.85rem;
    color: rgba(230, 220, 196, 0.15);
    text-decoration: none;
    letter-spacing: 0.1em;
    transition: color 0.3s;
  }

  .today-home:hover {
    color: rgba(230, 220, 196, 0.4);
  }

  @keyframes proverbFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive */
  @media (max-width: 480px) {
    .today-room { padding: 2rem 1.5rem; }
    .today-proverb { font-size: clamp(1.3rem, 5vw, 1.8rem); }
  }
</style>

<script is:inline>
(function() {
  // Load proverbs
  fetch('/data/proverbs.json')
    .then(r => r.json())
    .then(proverbs => {
      // Pick today's proverb — same for everyone worldwide
      const today = new Date().toISOString().slice(0, 10);
      const seed = Array.from(today).reduce((a, c) => a + c.charCodeAt(0), 0);
      const index = seed % proverbs.length;
      const proverb = proverbs[index];

      // Display
      document.getElementById('today-proverb').textContent = proverb.text;
      document.getElementById('today-id').textContent = proverb.id;

      // Witness counter
      const witnessKey = 'kalam-witness-' + proverb.id;
      const todayWitnessKey = 'kalam-witnessed-today-' + today;
      let count = parseInt(localStorage.getItem(witnessKey) || '0');

      // Count this visit (once per day per proverb)
      if (!localStorage.getItem(todayWitnessKey)) {
        count++;
        localStorage.setItem(witnessKey, count);
        localStorage.setItem(todayWitnessKey, '1');
      }

      document.getElementById('today-witness').textContent =
        count === 1 ? 'Witnessed once' : 'Witnessed ' + count + ' times';

      // Check if already responded today
      const responseKey = 'kalam-response-' + today;
      const existingResponse = localStorage.getItem(responseKey);
      if (existingResponse) {
        document.getElementById('response-input').value = existingResponse;
        document.getElementById('response-input').disabled = true;
        document.getElementById('response-submit').hidden = true;
        document.getElementById('response-saved').hidden = false;
      }

      // Submit response
      document.getElementById('response-submit').addEventListener('click', function() {
        const input = document.getElementById('response-input');
        const text = input.value.trim();
        if (!text) return;

        // Store response
        localStorage.setItem(responseKey, text);

        // Store in response history
        const historyKey = 'kalam-responses';
        const history = JSON.parse(localStorage.getItem(historyKey) || '[]');
        history.push({
          date: today,
          proverb: proverb.text,
          proverbId: proverb.id,
          response: text,
          timestamp: new Date().toISOString()
        });
        localStorage.setItem(historyKey, JSON.stringify(history));

        // UI update
        input.disabled = true;
        this.hidden = true;
        document.getElementById('response-saved').hidden = false;

        // Show in others
        showResponses(proverb.id);
      });

      // Show previous responses for this proverb
      showResponses(proverb.id);

      // Card generator
      document.getElementById('carry-btn').addEventListener('click', function() {
        generateCard(proverb.text, proverb.id);
      });
    });

  function showResponses(proverbId) {
    const container = document.getElementById('today-others');
    const history = JSON.parse(localStorage.getItem('kalam-responses') || '[]');
    const relevant = history.filter(r => r.proverbId === proverbId);

    if (relevant.length === 0) {
      container.innerHTML = '';
      return;
    }

    container.innerHTML = '<div style="font-size:0.7rem;color:rgba(230,220,196,0.15);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:1rem;">Your marks</div>';
    relevant.forEach(r => {
      const div = document.createElement('div');
      div.className = 'other-response';
      div.textContent = r.response;
      container.appendChild(div);
    });
  }

  function generateCard(text, id) {
    const canvas = document.getElementById('card-canvas');
    const ctx = canvas.getContext('2d');
    const w = 1080, h = 1080;

    // Background
    ctx.fillStyle = '#0a0a0f';
    ctx.fillRect(0, 0, w, h);

    // Subtle grain texture (noise)
    for (let i = 0; i < 8000; i++) {
      const x = Math.random() * w;
      const y = Math.random() * h;
      const a = Math.random() * 0.03;
      ctx.fillStyle = 'rgba(230, 220, 196, ' + a + ')';
      ctx.fillRect(x, y, 1, 1);
    }

    // Gold line — top
    ctx.strokeStyle = 'rgba(155, 107, 0, 0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(w * 0.3, h * 0.25);
    ctx.lineTo(w * 0.7, h * 0.25);
    ctx.stroke();

    // Proverb text
    ctx.fillStyle = '#c9a96e';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    // Word wrap
    const maxWidth = w * 0.65;
    const lineHeight = 72;
    const fontSize = text.length > 60 ? 42 : text.length > 40 ? 48 : 56;
    ctx.font = '300 ' + fontSize + 'px "Cormorant Garamond", Georgia, serif';

    const words = text.split(' ');
    const lines = [];
    let currentLine = '';

    words.forEach(word => {
      const testLine = currentLine ? currentLine + ' ' + word : word;
      if (ctx.measureText(testLine).width > maxWidth && currentLine) {
        lines.push(currentLine);
        currentLine = word;
      } else {
        currentLine = testLine;
      }
    });
    if (currentLine) lines.push(currentLine);

    const totalHeight = lines.length * lineHeight;
    const startY = (h / 2) - (totalHeight / 2) + (lineHeight / 2);

    lines.forEach((line, i) => {
      ctx.fillText(line, w / 2, startY + (i * lineHeight));
    });

    // Gold line — bottom
    ctx.strokeStyle = 'rgba(155, 107, 0, 0.2)';
    ctx.beginPath();
    ctx.moveTo(w * 0.3, h * 0.75);
    ctx.lineTo(w * 0.7, h * 0.75);
    ctx.stroke();

    // ID
    ctx.fillStyle = 'rgba(155, 107, 0, 0.3)';
    ctx.font = '300 18px "IBM Plex Sans", sans-serif';
    ctx.fillText(id, w / 2, h * 0.82);

    // kalam.ch
    ctx.fillStyle = 'rgba(230, 220, 196, 0.12)';
    ctx.font = '300 20px "Cormorant Garamond", Georgia, serif';
    ctx.fillText('kalam.ch', w / 2, h * 0.92);

    // Download
    canvas.toBlob(function(blob) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'kalam-' + id.replace('#', '') + '.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 'image/png');
  }
})();
</script>
