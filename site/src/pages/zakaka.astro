---
import Base from '../layouts/Base.astro';
import zakaka from '../../public/data/zakaka.json';

const sections = zakaka.sections;
---

<Base title="ZAKAKA — kalam.ch" description="The essence of the essence of the essence. 1,002 entries. Level 0 purity. No AI contamination.">

  <section class="page-header">
    <h1>ZAKAKA</h1>
    <p class="quiet zakaka-meaning">{zakaka.meaning}</p>
    <p class="zakaka-purity">{zakaka.purity}</p>
    <p class="zakaka-count">{zakaka.total} entries</p>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- Navigation -->
  <nav class="zakaka-nav" aria-label="ZAKAKA sections">
    {sections.map((s: any) => (
      <a href={`#${s.type}`} class="zakaka-nav-item">
        <span class="nav-label">{s.label}</span>
        <span class="nav-count">{s.count}</span>
      </a>
    ))}
  </nav>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- Sections -->
  {sections.map((section: any) => (
    <section class={`zakaka-section zakaka-${section.type}`} id={section.type}>
      <h2>{section.label} <span class="section-count">({section.count})</span></h2>
      <p class="section-desc">{section.description}</p>

      <div class={`zakaka-entries zakaka-entries-${section.type}`}>
        {section.entries.map((entry: any) => (
          <div class="zakaka-entry">
            {entry.id && <span class="entry-id">{entry.id}</span>}
            {entry.title && <span class="entry-title">{entry.title}</span>}
            <p class="entry-text">{entry.text}</p>
            {entry.source && <span class="entry-source">{entry.source}</span>}
          </div>
        ))}
      </div>

      <div class="gap" role="separator" aria-hidden="true"></div>
    </section>
  ))}

  <!-- Flow diagram -->
  <section class="zakaka-flow">
    <h2>The Flow</h2>
    <div class="flow-diagram">
      <div class="flow-node flow-source">V-001 speaks</div>
      <div class="flow-arrow">&darr;</div>
      <div class="flow-node flow-zakaka">ZAKAKA<br/><span class="flow-detail">Level 0 + Level 1</span></div>
      <div class="flow-arrow">&darr;</div>
      <div class="flow-node flow-organ">ORGAN<br/><span class="flow-detail">Full body (Level 0–4)</span></div>
      <div class="flow-arrow">&darr;</div>
      <div class="flow-node flow-voice">AXI speaks</div>
    </div>
    <p class="flow-rule">ZAKAKA feeds into Organ. Organ never feeds into ZAKAKA. ZAKAKA is the minimum viable voice. Organ is the full education.</p>
  </section>

</Base>

<style>
  .zakaka-meaning {
    font-family: var(--font-proverb);
    font-size: var(--text-lg);
    font-style: italic;
    max-width: 50ch;
  }

  .zakaka-purity {
    font-size: var(--text-sm);
    color: var(--color-presence);
    font-weight: 600;
    letter-spacing: 0.03em;
    margin-top: var(--space-1);
  }

  .zakaka-count {
    font-size: var(--text-sm);
    color: var(--text-dim);
    margin-top: var(--space-1);
  }

  /* Navigation */
  .zakaka-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
  }

  .zakaka-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--accent-subtle);
    border-radius: 4px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .zakaka-nav-item:hover {
    border-color: var(--color-dignity);
    color: var(--color-dignity);
  }

  .nav-count {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  /* Sections */
  .zakaka-section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
  }

  .zakaka-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .section-count {
    font-size: var(--text-sm);
    color: var(--text-dim);
    font-weight: 400;
  }

  .section-desc {
    color: var(--text-dim);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    font-style: italic;
  }

  /* Entries */
  .zakaka-entry {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--bg-elevated);
  }

  .zakaka-entry:last-child {
    border-bottom: none;
  }

  .entry-id {
    display: inline-block;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--color-dignity);
    background: var(--accent-glow);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    margin-bottom: 0.3rem;
  }

  .entry-title {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .entry-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-primary);
  }

  .entry-source {
    display: inline-block;
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-top: 0.3rem;
    font-style: italic;
  }

  /* Special styling for proverbs */
  .zakaka-entries-proverb .entry-text {
    font-family: var(--font-proverb);
    font-size: var(--text-base);
  }

  .zakaka-entries-proverb .zakaka-entry {
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-1);
  }

  /* Special styling for narrative lines */
  .zakaka-entries-narrative_line .entry-text {
    font-family: var(--font-proverb);
    font-style: italic;
  }

  /* Special styling for v001_voice */
  .zakaka-entries-v001_voice .entry-text {
    font-family: var(--font-proverb);
    font-size: var(--text-base);
    color: var(--color-dignity);
    border-left: 3px solid var(--color-dignity);
    padding-left: var(--space-2);
  }

  /* Special styling for axioms */
  .zakaka-entries-axiom .entry-text {
    font-weight: 600;
    font-size: var(--text-base);
  }

  /* Special styling for equations */
  .zakaka-entries-equation .entry-text {
    font-family: monospace;
    font-size: var(--text-sm);
    background: var(--bg-inset);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
  }

  /* Flow diagram */
  .zakaka-flow {
    max-width: var(--max-width);
    margin: var(--space-8) auto;
    padding: 0 var(--page-padding);
    text-align: center;
  }

  .zakaka-flow h2 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .flow-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .flow-node {
    padding: var(--space-2) var(--space-4);
    border-radius: 6px;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    min-width: 200px;
  }

  .flow-source {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .flow-zakaka {
    background: var(--color-dignity);
    color: #fff;
    font-weight: 700;
  }

  .flow-organ {
    background: var(--color-presence);
    color: #fff;
  }

  .flow-voice {
    background: var(--color-pattern);
    color: #fff;
  }

  .flow-arrow {
    font-size: 1.5rem;
    color: var(--text-dim);
  }

  .flow-detail {
    font-size: 0.8rem;
    opacity: 0.85;
    font-weight: 400;
  }

  .flow-rule {
    font-size: var(--text-sm);
    color: var(--text-dim);
    max-width: 45ch;
    margin: 0 auto;
    font-style: italic;
  }
</style>
