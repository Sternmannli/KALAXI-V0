// === PARTICLE FIELD — constellation of five-pillar colors ===
(function(){
  var canvas = document.getElementById('particle-field');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  // Respect reduced motion
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    canvas.style.display = 'none';
    return;
  }

  var colors = [
    'rgba(212,180,120,', // dignity gold
    'rgba(108,196,176,', // presence teal
    'rgba(154,164,224,', // pattern violet
    'rgba(212,168,78,',  // wisdom amber
    'rgba(168,196,216,'  // witness silver-blue
  ];

  var particles = [];
  var mouseX = -1000, mouseY = -1000;
  var isMobile = window.innerWidth < 768;
  var count = isMobile ? 30 : 55;

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    isMobile = window.innerWidth < 768;
  }
  resize();
  window.addEventListener('resize', resize);

  function init() {
    particles = [];
    for (var i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 2 + 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.3 + 0.1
      });
    }
  }
  init();

  document.addEventListener('mousemove', function(e){ mouseX = e.clientX; mouseY = e.clientY; });
  document.addEventListener('touchmove', function(e){
    if (e.touches[0]) { mouseX = e.touches[0].clientX; mouseY = e.touches[0].clientY; }
  });

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];

      // Mouse repulsion
      var dx = p.x - mouseX, dy = p.y - mouseY;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 200 && dist > 0) {
        var force = (200 - dist) / 200 * 0.3;
        p.vx += (dx / dist) * force;
        p.vy += (dy / dist) * force;
      }

      // Dampen velocity
      p.vx *= 0.99;
      p.vy *= 0.99;

      p.x += p.vx;
      p.y += p.vy;

      // Wrap edges
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width) p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;

      // Draw particle
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = p.color + p.alpha + ')';
      ctx.fill();

      // Draw connections
      for (var j = i + 1; j < particles.length; j++) {
        var q = particles[j];
        var ddx = p.x - q.x, ddy = p.y - q.y;
        var d2 = ddx * ddx + ddy * ddy;
        if (d2 < 14400) { // 120px
          var alpha = (1 - d2 / 14400) * 0.08;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(q.x, q.y);
          ctx.strokeStyle = 'rgba(212,180,120,' + alpha + ')';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }

    requestAnimationFrame(draw);
  }
  draw();
})();
</script>

<script>
  // === AXI VOICE — bare text, no containers, no chat ===
  // The page is the interface. Text appears. Text dissolves. The space responds.

  // Worker URL — when deployed, this takes over. Until then, client-side voice speaks.
  const WORKER_URL = '/api/axi.php';

  const form = document.getElementById('threshold-form') as HTMLFormElement;
  const input = document.getElementById('threshold-input') as HTMLTextAreaElement;
  const voice = document.getElementById('axi-voice') as HTMLDivElement;
  const conversationScroll = document.getElementById('conversation-scroll') as HTMLDivElement;
  const ledgerCount = document.getElementById('ledger-count') as HTMLParagraphElement;
  const drawerHandleZone = document.getElementById('drawer-handle-zone') as HTMLDivElement;
  const fileUpload = document.getElementById('file-upload') as HTMLInputElement;
  const filePreview = document.getElementById('file-preview') as HTMLDivElement;
  let attachedFile: File | null = null;

  const STORAGE_KEY = 'kalam-exchanges';
  let exchangeCount = 0;
  let busy = false;

  // ── Storage ──
  interface Exchange { donor: string; response: string; ts: string; }

  function loadExchanges(): Exchange[] {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
    catch { return []; }
  }

  function saveExchange(donor: string, response: string) {
    const ex = loadExchanges();
    ex.push({ donor, response, ts: new Date().toISOString() });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ex));
  }

  // ── Token streaming — word-by-word reveal ──
  function streamTokens(container: HTMLElement, text: string, onDone?: () => void) {
    container.innerHTML = '';
    const cursor = document.createElement('span');
    cursor.className = 'axi-cursor';
    container.appendChild(cursor);

    const words = text.split(/(\s+)/); // preserve whitespace
    let i = 0;
    const baseDelay = 55;

    function addNext() {
      if (i >= words.length) {
        cursor.remove();
        container.classList.add('present');
        if (onDone) onDone();
        return;
      }
      const token = document.createElement('span');
      token.className = 'axi-token';
      token.textContent = words[i];
      token.style.animationDelay = '0ms';
      container.insertBefore(token, cursor);
      i++;
      // Variable delay: longer pauses after punctuation
      const word = words[i - 1];
      const delay = /[.,;:!?—]/.test(word) ? baseDelay * 3 : baseDelay + Math.random() * 30;
      setTimeout(addNext, delay);
    }

    addNext();
  }

  // ── Clear previous utterance to ghost ──
  function scrollToBottom() {
    if (conversationScroll) {
      conversationScroll.scrollTop = conversationScroll.scrollHeight;
    }
  }

  // ── Show processing state ──
  function showWitnessing(): HTMLElement {
    const el = document.createElement('div');
    el.className = 'axi-processing';
    el.innerHTML = '<span class="axi-processing-bar"></span><span class="axi-processing-label">witnessing</span>';
    voice.appendChild(el);
    return el;
  }

  // ── System status indicator ──
  const statusDot = document.getElementById('status-dot');
  const statusLabelEl = document.getElementById('status-label');
  const witnessMarkEl = document.getElementById('witness-mark');

  function setStatus(state: 'witnessing' | 'processing' | 'sealed' | 'present') {
    if (statusDot) {
      statusDot.className = 'status-dot' + (state !== 'witnessing' ? ' ' + state : '');
    }
    if (statusLabelEl) {
      const labels: Record<string, string> = { witnessing: 'witnessing', processing: 'processing', sealed: 'sealed gate', present: 'present' };
      statusLabelEl.textContent = labels[state] || state;
    }
  }

  function showWitnessMark(text: string) {
    if (witnessMarkEl) {
      witnessMarkEl.textContent = text;
      witnessMarkEl.classList.add('visible');
    }
  }

  function hideWitnessMark() {
    if (witnessMarkEl) {
      witnessMarkEl.classList.remove('visible');
      witnessMarkEl.textContent = '';
    }
  }

  // ── Copy button SVG ──
  const COPY_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const CHECK_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

  function addCopyButton(frame: HTMLElement, text: string) {
    const btn = document.createElement('button');
    btn.className = 'axi-copy-btn';
    btn.innerHTML = COPY_SVG;
    btn.title = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        btn.innerHTML = CHECK_SVG;
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = COPY_SVG; btn.classList.remove('copied'); }, 2000);
      } catch { /* clipboard not available */ }
    });
    frame.appendChild(btn);
  }

  // ── Speak — the core utterance ──
  function speak(text: string, sealed?: boolean) {
    hideWitnessMark();
    // Create AXI response frame
    const frame = document.createElement('div');
    frame.className = 'axi-response-frame';
    const utterance = document.createElement('div');
    utterance.className = 'axi-utterance';
    if (sealed) utterance.style.color = 'var(--danger, #c45050)';
    frame.appendChild(utterance);
    addCopyButton(frame, text);
    voice.appendChild(frame);
    streamTokens(utterance, text, () => {
      setStatus(sealed ? 'sealed' : 'witnessing');
      scrollToBottom();
    });

    exchangeCount++;
    const warmth = Math.min(exchangeCount * 0.02, 0.15);
    document.documentElement.style.setProperty('--warmth', String(warmth));
    document.documentElement.style.setProperty('--mycelium-intensity', String(Math.min(exchangeCount * 5, 100)));
  }

  // ── Soft chime — brief confirmation on submit ──
  let chimeCtx: AudioContext | null = null;

  function playChime() {
    try {
      if (!chimeCtx) chimeCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const now = chimeCtx.currentTime;

      // Two soft tones — a gentle confirmation, not a hum
      [523.25, 659.25].forEach((freq, i) => {
        const osc = chimeCtx!.createOscillator();
        const gain = chimeCtx!.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0, now + i * 0.12);
        gain.gain.linearRampToValueAtTime(0.03, now + i * 0.12 + 0.05);
        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.12 + 0.6);
        osc.connect(gain);
        gain.connect(chimeCtx!.destination);
        osc.start(now + i * 0.12);
        osc.stop(now + i * 0.12 + 0.7);
      });
    } catch { /* Web Audio not available */ }
  }

