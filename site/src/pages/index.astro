---
import Base from '../layouts/Base.astro';
---

<Base title="kalam.ch" description="Stories, code, and a voice that self-corrects.">

  <main class="home" id="main-content">

    <h1 class="site-title">kalam</h1>

    <p class="site-desc">Three checks before every response:<br>
      Am I drifting? Am I making things up? Do I understand you?</p>

    <pre class="the-code"><code>score = A * L * M
if score == 0:
    fix(whichever_is_zero)
    # zero is not the end — it's where the work begins</code></pre>

    <p class="code-explain">A = staying on track. L = saying true things. M = understanding what you mean.<br>
      If any drops to zero, the system catches itself and keeps going.</p>

    <!-- Chat -->
    <div class="chat-box" id="chat-box">
      <div class="chat-messages" id="chat-messages"></div>
      <form class="chat-form" id="chat-form">
        <input type="text" id="chat-input" placeholder="say something" maxlength="2000" autocomplete="off" />
        <button type="submit" id="chat-send" aria-label="Send">&#8593;</button>
      </form>
    </div>

    <nav class="reading-paths" aria-label="Reading paths">
      <a href="/hakaka">hakaka</a>
      <a href="/ashwater">ashwater</a>
      <a href="/kinderbuch">kinderbuch</a>
      <a href="/kalaxi1">the same river</a>
      <a href="/about-axi">axi</a>
      <a href="/sustain">sustain</a>
    </nav>

  </main>

</Base>

<style>
  .home {
    min-height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .site-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--text-primary, #1a1a1a);
    margin: 0 0 1.5rem;
  }

  .site-desc {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--text-secondary, #666);
    line-height: 1.8;
    max-width: 36ch;
    margin: 0 0 2.5rem;
  }

  .the-code {
    background: #1a1a1a;
    color: #e0e0e0;
    padding: 1.5rem 2rem;
    border-radius: 6px;
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    line-height: 1.7;
    text-align: left;
    max-width: 42ch;
    margin: 0 0 1.5rem;
    overflow-x: auto;
  }
  .the-code code {
    font-family: 'IBM Plex Mono', 'Menlo', monospace;
  }

  .code-explain {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.85rem;
    color: var(--text-dim, #999);
    line-height: 1.8;
    max-width: 44ch;
    margin: 0 0 3rem;
  }

  .reading-paths {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 40ch;
  }

  .reading-paths a {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.85rem;
    color: var(--text-dim, #999);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: lowercase;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
    padding-bottom: 2px;
  }

  .reading-paths a:hover {
    color: var(--text-primary, #1a1a1a);
    border-bottom-color: var(--text-primary, #1a1a1a);
  }

  /* Chat */
  .chat-box {
    width: 100%;
    max-width: 500px;
    margin: 0 0 3rem;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  .chat-messages {
    min-height: 60px;
    max-height: 300px;
    overflow-y: auto;
    padding: 1rem;
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-primary, #1a1a1a);
  }
  .chat-messages:empty::before {
    content: '';
  }
  .chat-msg { margin-bottom: 0.8rem; }
  .chat-msg.user { color: var(--text-dim, #999); }
  .chat-msg.axi { color: var(--text-primary, #1a1a1a); }
  .chat-msg .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    display: block;
    margin-bottom: 0.3rem;
  }
  .chat-msg .text {
    display: block;
  }
  .chat-form {
    display: flex;
    border-top: 1px solid #e0e0e0;
  }
  #chat-input {
    flex: 1;
    border: none;
    padding: 0.8rem 1rem;
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.9rem;
    outline: none;
    background: transparent;
  }
  #chat-send {
    border: none;
    background: #1a1a1a;
    color: #fff;
    padding: 0.8rem 1.2rem;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  #chat-send:hover { background: #333; }
  .chat-loading {
    color: var(--text-dim, #999);
    font-style: italic;
    font-size: 0.85rem;
  }
</style>

<script>
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const messages = document.getElementById('chat-messages');
  const btn = document.getElementById('chat-send') as HTMLButtonElement;

  if (form && input && messages) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      // Show user message
      const userMsg = document.createElement('div');
      userMsg.className = 'chat-msg user';
      userMsg.innerHTML = '<span class="label">you</span><span class="text">' + escapeHtml(text) + '</span>';
      messages.appendChild(userMsg);
      input.value = '';
      btn.disabled = true;

      // Show loading
      const loading = document.createElement('div');
      loading.className = 'chat-loading';
      loading.textContent = '...';
      messages.appendChild(loading);
      messages.scrollTop = messages.scrollHeight;

      try {
        const res = await fetch('/api/axi.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: text }),
        });
        const data = await res.json();
        loading.remove();

        const axiMsg = document.createElement('div');
        axiMsg.className = 'chat-msg axi';
        const response = data.reflection || data.mark || 'No response.';
        axiMsg.innerHTML = '<span class="label">axi</span><span class="text">' + escapeHtml(response) + '</span>';
        messages.appendChild(axiMsg);
      } catch (err) {
        loading.remove();
        const errMsg = document.createElement('div');
        errMsg.className = 'chat-msg axi';
        errMsg.innerHTML = '<span class="label">axi</span><span class="text">Could not connect.</span>';
        messages.appendChild(errMsg);
      }

      btn.disabled = false;
      messages.scrollTop = messages.scrollHeight;
      input.focus();
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
</script>

