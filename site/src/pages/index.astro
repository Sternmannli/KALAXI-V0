  // ── Ledger init ──
  async function initLedger() {
    try {
      const res = await fetch(WORKER_URL, { method: 'GET' });
      if (!res.ok) throw new Error('not ok');
      const data = await res.json();
      if (data.count > 0) {
        ledgerCount.textContent = data.count + '';
        ledgerCount.classList.add('visible');
      }
    } catch {
      const ex = loadExchanges();
      if (ex.length > 0) {
        exchangeCount = ex.length;
        ledgerCount.textContent = ex.length + '';
        ledgerCount.classList.add('visible');
      }
    }
  }

  // ── Restore last utterance on page load ──
  function restoreLast() {
    const ex = loadExchanges();
    if (ex.length === 0) return;
    exchangeCount = ex.length;
    // Show last few exchanges
    const recent = ex.slice(-3);
    recent.forEach(item => {
      const donorBubble = document.createElement('div');
      donorBubble.className = 'donor-echo';
      donorBubble.style.opacity = '0.5';
      donorBubble.textContent = item.donor;
      voice.appendChild(donorBubble);

      const frame = document.createElement('div');
      frame.className = 'axi-response-frame';
      frame.style.opacity = '0.5';
      const utt = document.createElement('div');
      utt.className = 'axi-utterance ghost';
      utt.textContent = item.response;
      frame.appendChild(utt);
      addCopyButton(frame, item.response);
      voice.appendChild(frame);
    });
    scrollToBottom();
  }

  // ── Textarea auto-resize + submit button + char count + clear ──
  const charCountEl = document.getElementById('char-count');
  const clearBtn = document.getElementById('clear-btn');

  function updateInputUI() {
    const len = input.value.length;
    const hasContent = input.value.trim().length > 0;
    const btn = document.getElementById('submit-btn');
    if (btn) btn.classList.toggle('visible', hasContent);
    if (clearBtn) clearBtn.classList.toggle('visible', hasContent);

    // Char count
    if (charCountEl) {
      charCountEl.textContent = len + ' / 2000';
      charCountEl.classList.toggle('active', len > 0);
      charCountEl.classList.toggle('warning', len > 1600);
      charCountEl.classList.toggle('danger', len > 1900);
    }

    // Auto-resize: grow to fit content, max 60vh
    input.style.height = 'auto';
    const maxH = window.innerHeight * 0.6;
    input.style.height = Math.min(input.scrollHeight, maxH) + 'px';
  }

  input.addEventListener('input', updateInputUI);

  // ── Breath dot — tracks typing rhythm ──
  const breathDot = document.getElementById('breath-dot');
  let typingTimeout: ReturnType<typeof setTimeout> | null = null;

  input.addEventListener('input', () => {
    if (breathDot) {
      breathDot.classList.add('typing');
      breathDot.classList.remove('paused');
    }
    if (typingTimeout) clearTimeout(typingTimeout);
    typingTimeout = setTimeout(() => {
      if (breathDot) {
        breathDot.classList.remove('typing');
        if (input.value.trim()) breathDot.classList.add('paused');
        else breathDot.classList.remove('paused');
      }
    }, 800);
  });

  input.addEventListener('focus', () => {
    if (breathDot && input.value.trim()) breathDot.classList.add('paused');
  });
  input.addEventListener('blur', () => {
    if (breathDot) { breathDot.classList.remove('typing', 'paused'); }
  });

  // Clear button
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      input.value = '';
      updateInputUI();
      input.focus();
    });
  }

  // Enter to submit (Shift+Enter for new line), Ctrl+Enter also submits
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey || !e.shiftKey)) {
      e.preventDefault();
      form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });

  // ── File attachment ──
  const attachBtn = document.querySelector('.input-attach') as HTMLElement;

  fileUpload.addEventListener('change', () => {
    const file = fileUpload.files?.[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) {
      alert('File too large. Maximum 10 MB.');
      fileUpload.value = '';
      return;
    }
    attachedFile = file;
    filePreview.hidden = false;
    if (attachBtn) attachBtn.classList.add('has-file');

    const wrap = document.createElement('div');
    wrap.style.display = 'inline-flex';
    wrap.style.alignItems = 'center';
    wrap.style.gap = '0.5rem';

    const isImage = file.type.startsWith('image/');
    if (isImage) {
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = file.name;
      wrap.appendChild(img);
    } else {
      const label = document.createElement('span');
      label.className = 'file-label';
      label.textContent = file.name;
      wrap.appendChild(label);
    }

    const rm = document.createElement('button');
    rm.className = 'remove-file';
    rm.textContent = '×';
    rm.setAttribute('aria-label', 'Remove file');
    rm.addEventListener('click', () => {
      attachedFile = null;
      filePreview.innerHTML = '';
      filePreview.hidden = true;
      fileUpload.value = '';
      if (attachBtn) attachBtn.classList.remove('has-file');
    });
    wrap.appendChild(rm);
    filePreview.innerHTML = '';
    filePreview.appendChild(wrap);

    // Haptic + brief highlight to confirm selection
    if (isMobile && navigator.vibrate) navigator.vibrate(5);
  });

  // ── Form submission — the threshold ──
  const inputZone = document.getElementById('input-zone');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = input.value.trim();
    if (!content || busy) return;
    busy = true;
    setStatus('processing');
    setSubmitState('sending');

    // Haptic feedback on mobile
    if (isMobile && navigator.vibrate) navigator.vibrate(10);

    // Submit ripple + soft chime
    if (inputZone) {
      inputZone.classList.add('submitted');
      setTimeout(() => inputZone.classList.remove('submitted'), 1000);
    }
    playChime();

    const donorText = content;

    // Prepare file data before clearing (so we can still reference attachedFile)
    const hadFile = !!attachedFile;
    let filePayload: { name: string; type: string; data: string } | null = null;
    if (attachedFile) {
      const fileData = await new Promise<string>((resolve) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result as string);
        reader.readAsDataURL(attachedFile!);
      });
      filePayload = { name: attachedFile.name, type: attachedFile.type, data: fileData };
      attachedFile = null;
      filePreview.innerHTML = '';
      filePreview.hidden = true;
      fileUpload.value = '';
    }

    // Dissolve text visually — wait for the fade, THEN clear
    input.classList.add('dissolving');
    await new Promise(r => setTimeout(r, 400));
    input.value = '';
    input.style.height = 'auto';
    input.classList.remove('dissolving');

    // Show what the donor typed as a message bubble (soft entrance via CSS animation)
    const echo = document.createElement('div');
    echo.className = 'donor-echo';
    // No emoji decoration — the donor's words stand alone
    const echoText = document.createTextNode(donorText);
    echo.appendChild(echoText);
    if (hadFile && filePayload) {
      const attachLabel = document.createElement('span');
      attachLabel.className = 'donor-file-label';
      attachLabel.textContent = filePayload.name;
      echo.appendChild(attachLabel);
    }
    voice.appendChild(echo);
    scrollToBottom();

    // ── Ninth Operator Ceremony — founding wound pause ──
    // 800ms dignity latency, then the river remembers
    await new Promise(r => setTimeout(r, 800));
    const ceremonyResult = await showCeremony(donorText);
    if (ceremonyResult === 'hold') {
      // Donor chose to rewrite — restore text, remove echo
      input.value = donorText;
      updateInputUI();
      echo.remove();
      busy = false;
      setStatus('idle');
      setSubmitState('idle');
      return;
    }

    // Enter contemplation — the gap
    enterContemplation();
    setSubmitState('witnessing');
    axiStartProcessing();
    const waiting = showWitnessing();
    const donorWordCount = donorText.trim().split(/\s+/).length;

    let responseText = '';
    let sealed = false;

    const payload: any = { content: donorText, mood: selectedMood };
    if (filePayload) payload.file = filePayload;

    // Try SSE streaming first, fall back to JSON, then local voice
    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream, application/json',
        },
        body: JSON.stringify(payload),
      });

      waiting.remove();
      exitContemplation();

      if (res.ok && res.headers.get('content-type')?.includes('text/event-stream')) {
        // ── SSE STREAMING — real token-by-token from server ──
        setSubmitState('receiving');
        setStatus('witnessing');
        axiStopProcessing();
        const sseRegister = detectRegister(donorText);
        currentRegister = sseRegister;
        showAxiReaction(sseRegister);
        showAxiWhisper(sseRegister);
        if (sseRegister !== 'general') playModeSound(sseRegister);

        const frame = document.createElement('div');
        frame.className = 'axi-response-frame';
        if (sseRegister !== 'general') frame.setAttribute('data-register', sseRegister);
        frame.appendChild(createMiniAvatar());
        const utterance = document.createElement('div');
        utterance.className = 'axi-utterance';
        frame.appendChild(utterance);
        voice.appendChild(frame);

        const cursor = document.createElement('span');
        cursor.className = 'axi-cursor';
        utterance.appendChild(cursor);

        const reader = res.body?.getReader();
        const decoder = new TextDecoder();
        let fullText = '';
        let witnessMark = '';

        if (reader) {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            const chunk = decoder.decode(value, { stream: true });
            const lines = chunk.split('\n');
            for (const line of lines) {
              if (!line.startsWith('data: ')) continue;
              try {
                const event = JSON.parse(line.slice(6));
                if (event.token) {
                  const token = document.createElement('span');
                  token.className = 'axi-token';
                  token.textContent = event.token;
                  utterance.insertBefore(token, cursor);
                  fullText += event.token;
                  scrollToBottom();
                }
                if (event.done) {
                  witnessMark = event.witness || '';
                  if (event.count) {
                    ledgerCount.textContent = event.count + '';
                    ledgerCount.classList.add('visible', 'incrementing');
                    setTimeout(() => ledgerCount.classList.remove('incrementing'), 600);
                  }
                  // Kintsugi Thread — A/L/M river lines
                  if (event.A !== undefined) {
                    addKintsugiThread(frame, event.A, event.L, event.M);
                  }
                }
                if (event.sealed) { sealed = true; utterance.style.color = 'var(--danger, #c45050)'; }
              } catch { /* skip malformed events */ }
            }
          }
        }

        cursor.remove();
        utterance.classList.add('present');
        responseText = fullText || 'Witnessed.';
        addMetaLine(frame, sseRegister, donorWordCount);
        if (!sealed) addSuggestion(frame, sseRegister);
        addResponseActions(frame, responseText);
        addGapButton(frame, exchangeCount);
        if (witnessMark) showWitnessMark(witnessMark);
        haptic80Hz(); // Children's frequency on witness completion

      } else if (res.ok) {
        // ── JSON response — animate locally ──
        setSubmitState('receiving');
        axiStopProcessing();
        const data = await res.json();
        responseText = data.reflection || data.mark || 'Witnessed.';
        sealed = false;
        const jsonRegister = detectRegister(donorText);
        currentRegister = jsonRegister;
        speak(responseText, sealed, jsonRegister, donorWordCount);
        if (data.mark) showWitnessMark(data.mark);
        // Kintsugi Thread from server A/L/M (override the default 1.0s from speak())
        if (data.A !== undefined) {
          const lastFrame = voice.querySelector('.axi-response-frame:last-child');
          const existingThread = lastFrame?.querySelector('.kintsugi-thread');
          if (existingThread) existingThread.remove();
          if (lastFrame) addKintsugiThread(lastFrame as HTMLElement, data.A, data.L, data.M);
        }
        if (data.count) {
          ledgerCount.textContent = data.count + '';
          ledgerCount.classList.add('visible', 'incrementing');
          setTimeout(() => ledgerCount.classList.remove('incrementing'), 600);
        }
      } else {
        // Server responded but not OK — use local voice
        setSubmitState('receiving');
        const local = axiVoiceLocal(donorText, hadFile);
        responseText = local.response;
        sealed = local.sealed;
        speak(responseText, sealed, local.register, donorWordCount);
        if (local.mark) showWitnessMark(local.mark);
      }
    } catch {
      // Server unreachable — AXI speaks from the client
      waiting.remove();
      exitContemplation();
      setSubmitState('receiving');

      // Dignity pause — variable based on input length
      const wordCount = donorText.split(/\s+/).length;
      const baseDelay = 800;
      const wordDelay = Math.min(wordCount * 100, 1500);
      const jitter = Math.random() * 600;
      await new Promise(r => setTimeout(r, baseDelay + wordDelay + jitter));

      const local = axiVoiceLocal(donorText, hadFile);
      responseText = local.response;
      sealed = local.sealed;
      speak(responseText, sealed, local.register, donorWordCount);
      if (local.mark) showWitnessMark(local.mark);

      // Update local ledger count
      exchangeCount++;
      ledgerCount.textContent = exchangeCount + '';
      ledgerCount.classList.add('visible', 'incrementing');
      setTimeout(() => ledgerCount.classList.remove('incrementing'), 600);
    }

    // Increment exchange count (SSE path doesn't go through speak())
    exchangeCount++;
    const warmth = Math.min(exchangeCount * 0.02, 0.15);
    document.documentElement.style.setProperty('--warmth', String(warmth));
    document.documentElement.style.setProperty('--mycelium-intensity', String(Math.min(exchangeCount * 5, 100)));

    saveExchange(donorText, responseText);
    setSubmitState('done');

    // Reveal donor signup ONCE after first exchange only
    if (exchangeCount === 1 && !donorSignupShown) {
      donorSignupShown = true;
      setTimeout(revealDonorSignup, 2000);
    }

    busy = false;
    input.focus();
  });

  restoreLast();
  initLedger();


  // ── PWA install ──
  const pwaHint = document.getElementById('pwa-hint');
  let deferredPrompt: any = null;

  // Capture the beforeinstallprompt event (Android Chrome)
  window.addEventListener('beforeinstallprompt', (e: Event) => {
    e.preventDefault();
    deferredPrompt = e;
    if (pwaHint) {
      pwaHint.textContent = 'Tap to install kalam.ch as an app';
      pwaHint.classList.remove('hidden');
    }
  });

  if (pwaHint) {
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
    if (isStandalone || localStorage.getItem('pwa-hint-dismissed')) {
      pwaHint.classList.add('hidden');
    }

    pwaHint.addEventListener('click', async () => {
      if (deferredPrompt) {
        // Android: trigger native install prompt immediately
        deferredPrompt.prompt();
        const result = await deferredPrompt.userChoice;
        deferredPrompt = null;
        if (result.outcome === 'accepted') {
          localStorage.setItem('pwa-hint-dismissed', '1');
        }
      } else {
        // iOS: can't auto-install, dismiss the hint
        localStorage.setItem('pwa-hint-dismissed', '1');
      }
      pwaHint.classList.add('hidden');
    });

    // Auto-hide after 10 seconds
    setTimeout(() => {
      if (!pwaHint.classList.contains('hidden')) {
        pwaHint.style.opacity = '0';
        setTimeout(() => pwaHint.classList.add('hidden'), 500);
      }
    }, 10000);
  }

  // ══════════════════════════════════════════════════════════════
  // ── DONOR ACCOUNTS (MOVE-003) ──
  // ══════════════════════════════════════════════════════════════

  const DONOR_API = '/api/donor.php';
  const donorCta = document.getElementById('donor-cta') as HTMLDivElement;
  const donorAuth = document.getElementById('donor-auth') as HTMLDivElement;
  const donorProfile = document.getElementById('donor-profile') as HTMLDivElement;
  const donorAuthForm = document.getElementById('donor-auth-form') as HTMLFormElement;
  const donorAuthStatus = document.getElementById('donor-auth-status') as HTMLParagraphElement;
  const donorGreeting = document.getElementById('donor-greeting') as HTMLParagraphElement;
  const donorStats = document.getElementById('donor-stats') as HTMLParagraphElement;

  let donorAuthenticated = false;

  // Check auth state on load
  async function checkDonorAuth() {
    try {
      const res = await fetch(DONOR_API + '?action=profile', { credentials: 'include' });
      if (!res.ok) return;
      const data = await res.json();
      if (data.authenticated && data.donor) {
        showDonorProfile(data.donor);
      }
    } catch { /* not authenticated or server unavailable */ }
  }

  function showDonorProfile(donor: any) {
    donorAuthenticated = true;
    // Reveal the CTA container and show profile
    const donorCtaEl = document.getElementById('donor-cta');
    if (donorCtaEl) { donorCtaEl.hidden = false; donorCtaEl.classList.add('revealed'); }
    if (donorAuth) donorAuth.hidden = true;
    if (donorProfile) donorProfile.hidden = false;
    if (donorGreeting) {
      const name = donor.display_name || 'Donor';
      const count = donor.interaction_count || 0;
      donorGreeting.textContent = count === 0
        ? `${name}, welcome.`
        : `${name}, you have returned.`;
    }
    if (donorStats) {
      donorStats.textContent = `${donor.interaction_count || 0} exchanges since ${new Date(donor.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`;
    }
  }

  // Register / send magic link
  if (donorAuthForm) {
    donorAuthForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('donor-email') as HTMLInputElement;
      const nameInput = document.getElementById('donor-name') as HTMLInputElement;
      const submitBtn = donorAuthForm.querySelector('button') as HTMLButtonElement;

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '...'; }
      if (donorAuthStatus) { donorAuthStatus.textContent = ''; donorAuthStatus.className = 'donor-status'; }

      try {
        const res = await fetch(DONOR_API + '?action=register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            email: emailInput.value,
            display_name: nameInput.value || undefined,
          }),
        });
        const data = await res.json();
        if (res.ok) {
          if (donorAuthStatus) {
            donorAuthStatus.textContent = data.message || 'Link sent. Check your email.';
            donorAuthStatus.style.color = 'var(--color-presence)';
          }
          donorAuthForm.reset();
        } else {
          if (donorAuthStatus) {
            donorAuthStatus.textContent = data.error || 'Something went wrong.';
            donorAuthStatus.style.color = 'var(--danger, #c45050)';
          }
        }
      } catch {
        if (donorAuthStatus) {
          donorAuthStatus.textContent = 'Could not connect. Try again.';
          donorAuthStatus.style.color = 'var(--danger, #c45050)';
        }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Join'; }
      }
    });
  }

  // Export data (COV#015)
  const exportBtn = document.getElementById('donor-export-btn');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      window.location.href = DONOR_API + '?action=export';
    });
  }

  // History
  const historyBtn = document.getElementById('donor-history-btn');
  if (historyBtn) {
    historyBtn.addEventListener('click', async () => {
      try {
        const res = await fetch(DONOR_API + '?action=history&limit=20', { credentials: 'include' });
        const data = await res.json();
        if (data.interactions && data.interactions.length > 0) {
          // Show history in conversation zone
          voice.innerHTML = '';
          data.interactions.reverse().forEach((item: any) => {
            const echo = document.createElement('div');
            echo.className = 'donor-echo';
            echo.style.opacity = '0.6';
            echo.textContent = item.input_text;
            voice.appendChild(echo);

            const frame = document.createElement('div');
            frame.className = 'axi-response-frame';
            frame.style.opacity = '0.6';
            const utt = document.createElement('div');
            utt.className = 'axi-utterance ghost';
            utt.textContent = item.axi_response;
            frame.appendChild(utt);
            addCopyButton(frame, item.axi_response);
            voice.appendChild(frame);
          });
          scrollToBottom();
        }
      } catch { /* silent */ }
    });
  }

  // Logout
  const logoutBtn = document.getElementById('donor-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      await fetch(DONOR_API + '?action=logout', { method: 'POST', credentials: 'include' });
      donorAuthenticated = false;
      if (donorAuth) donorAuth.hidden = false;
      if (donorProfile) donorProfile.hidden = true;
    });
  }

  // Check if just authenticated or auth error via magic link redirect
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('authenticated') === '1') {
    history.replaceState({}, '', '/');
    checkDonorAuth();
  } else if (urlParams.get('auth_error')) {
    const err = urlParams.get('auth_error');
    history.replaceState({}, '', '/');
    if (donorAuthStatus) {
      donorAuthStatus.style.color = 'var(--danger, #c45050)';
      donorAuthStatus.textContent = err === 'expired'
        ? 'Link expired. Request a new one.'
        : 'Link already used. Request a new one.';
    }
  } else {
    checkDonorAuth();
  }

  // ── Connect forms (newsletter, feedback, collaboration) ──
  function submitConnectForm(formId: string, type: string, statusId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const status = document.getElementById(statusId) as HTMLParagraphElement | null;
    if (!form || !status) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data: Record<string, string> = { type };
      formData.forEach((value, key) => { data[key] = value as string; });

      const btn = form.querySelector('button') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = '...'; }
      status.textContent = '';
      status.className = 'form-status';

      try {
        const res = await fetch('/api/connect.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (res.ok) {
          status.textContent = result.message || 'Received.';
          status.className = 'form-status success';
          form.reset();
        } else {
          status.textContent = result.error || 'Something went wrong.';
          status.className = 'form-status error';
        }
      } catch {
        status.textContent = 'Could not connect. Please try again.';
        status.className = 'form-status error';
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = type === 'newsletter' ? 'Subscribe' : type === 'feedback' ? 'Send' : 'Propose';
        }
      }
    });
  }

  submitConnectForm('home-newsletter-form', 'newsletter', 'home-newsletter-status');
  submitConnectForm('home-feedback-form', 'feedback', 'home-feedback-status');
  submitConnectForm('home-collab-form', 'collaboration', 'home-collab-status');

