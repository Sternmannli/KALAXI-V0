<script>
  // === AXI LIVING VOICE — Worker connection + Thermal Delay + Mycelium + 80 Hz ===

  // ── Configuration ──
  const WORKER_URL = 'https://axi-voice.REPLACE_WITH_YOUR_SUBDOMAIN.workers.dev';

  const form = document.getElementById('threshold-form') as HTMLFormElement;
  const input = document.getElementById('threshold-input') as HTMLInputElement;
  const submit = document.getElementById('threshold-submit') as HTMLButtonElement;
  const responses = document.getElementById('threshold-responses') as HTMLDivElement;
  const ledgerCount = document.getElementById('ledger-count') as HTMLParagraphElement;
  const historyContainer = document.getElementById('conversation-history') as HTMLDivElement;
  const conversationArea = document.getElementById('conversation-area') as HTMLDivElement;
  const drawerHandleZone = document.getElementById('drawer-handle-zone') as HTMLDivElement;

  const STORAGE_KEY = 'kalam-conversation';
  let hasExchanged = false;

  interface ConversationEntry {
    donor: string;
    response: string;
    timestamp: string;
  }

  function loadHistory(): ConversationEntry[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch { return []; }
  }

  function saveHistory(entries: ConversationEntry[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function revealAfterExchange() {
    if (hasExchanged) return;
    hasExchanged = true;
    // Reveal conversation area
    conversationArea.classList.add('revealed');
    // Reveal drawer handle
    drawerHandleZone.hidden = false;
  }

  function renderHistoryEntry(entry: ConversationEntry): HTMLDivElement {
    const el = document.createElement('div');
    el.className = 'history-entry';
    const date = new Date(entry.timestamp);
    const timeStr = date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' \u00b7 ' + date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });

    let html = '<p class="history-donor-label">you</p>';
    html += '<p class="history-donor-text">' + escapeHtml(entry.donor) + '</p>';
    if (entry.response) {
      html += '<p class="history-response-label">axi</p>';
      html += '<div class="history-response">' + entry.response + '</div>';
    }
    html += '<p class="history-meta">' + timeStr + '</p>';
    el.innerHTML = html;
    return el;
  }

  function restoreHistory() {
    const entries = loadHistory();
    if (entries.length === 0) return;
    // If there's history, reveal immediately
    revealAfterExchange();
    entries.forEach(entry => {
      historyContainer.appendChild(renderHistoryEntry(entry));
    });
  }

  // ── Mycelium Visual Shift ──
  function updateMycelium(count: number) {
    const intensity = Math.min(count, 100);
    document.documentElement.style.setProperty('--mycelium-intensity', String(intensity));
  }

  // ── 80 Hz Sonar — the children's frequency ──
  let sonarCtx: AudioContext | null = null;
  let sonarOsc: OscillatorNode | null = null;
  let sonarGain: GainNode | null = null;

  function startSonar() {
    if (sonarOsc) return;
    try {
      if (!sonarCtx) sonarCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      sonarOsc = sonarCtx.createOscillator();
      sonarGain = sonarCtx.createGain();
      sonarOsc.type = 'sine';
      sonarOsc.frequency.value = 80;
      sonarGain.gain.setValueAtTime(0, sonarCtx.currentTime);
      sonarGain.gain.linearRampToValueAtTime(0.015, sonarCtx.currentTime + 1.0);
      sonarOsc.connect(sonarGain);
      sonarGain.connect(sonarCtx.destination);
      sonarOsc.start();
    } catch { /* Web Audio not available */ }
  }

  function stopSonar() {
    if (sonarGain && sonarCtx) {
      sonarGain.gain.linearRampToValueAtTime(0, sonarCtx.currentTime + 0.5);
      setTimeout(() => {
        if (sonarOsc) { try { sonarOsc.stop(); } catch {} sonarOsc = null; }
        sonarGain = null;
      }, 600);
    }
  }

  input.addEventListener('focus', startSonar);
  input.addEventListener('blur', stopSonar);

  // ── Ledger init from Worker ──
  async function initLedger() {
    try {
      const res = await fetch(WORKER_URL, { method: 'GET' });
      if (!res.ok) return;
      const data = await res.json();
      if (data.count > 0) {
        ledgerCount.textContent = data.count === 1
          ? '1 has crossed this threshold.'
          : data.count + ' have crossed this threshold.';
        ledgerCount.classList.add('visible');
        updateMycelium(data.count);
      }
    } catch {
      const history = loadHistory();
      if (history.length > 0) {
        ledgerCount.textContent = history.length + ' have crossed this threshold.';
        ledgerCount.classList.add('visible');
        updateMycelium(history.length);
      }
    }
  }

  // ── Form submission — speak to AXI ──
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = input.value.trim();
    if (!content) return;

    // Reveal after first exchange
    revealAfterExchange();

    submit.disabled = true;
    submit.textContent = '\u00b7\u00b7\u00b7';

    const witnessing = document.createElement('div');
    witnessing.className = 'witnessing-indicator';
    witnessing.innerHTML = '<p class="witnessing-text breathing">AXI is witnessing...</p>';
    responses.appendChild(witnessing);

    let responseText = '';

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ input: content }),
      });

      witnessing.remove();

      if (res.ok) {
        const data = await res.json();
        const entry = document.createElement('div');
        entry.className = 'witness-entry';

        let html = '<p class="history-donor-label">you</p>';
        html += '<p class="history-donor-text">' + escapeHtml(content) + '</p>';

        const axiText = data.response || data.witness_mark || 'Witnessed.';
        responseText = axiText;

        html += '<p class="history-response-label">axi</p>';
        html += '<div class="axi-reflection thermal-blur" id="thermal-response">' + escapeHtml(axiText) + '</div>';

        if (data.witness_mark && data.witness_mark !== axiText) {
          html += '<p class="witness-mark">' + escapeHtml(data.witness_mark) + '</p>';
        }

        if (data.total) {
          html += '<p class="witness-receipt">' + data.total + ' have crossed this threshold.</p>';
        }

        entry.innerHTML = html;
        responses.appendChild(entry);

        const thermalEl = entry.querySelector('.thermal-blur');
        if (thermalEl) {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              thermalEl.classList.add('cooled');
            });
          });
        }

        if (data.total) {
          ledgerCount.textContent = data.total + ' have crossed this threshold.';
          ledgerCount.classList.add('visible');
          updateMycelium(data.total);
        }

        if (data.sealed) {
          entry.style.borderColor = 'var(--color-danger, #8b3a3a)';
        }
      } else {
        responseText = 'Witnessed.';
        const entry = document.createElement('div');
        entry.className = 'witness-entry';
        entry.innerHTML = '<p class="history-donor-label">you</p><p class="history-donor-text">' + escapeHtml(content) + '</p><p class="history-response-label">axi</p><p class="witness-mark"><em>Witnessed.</em></p>';
        responses.appendChild(entry);
      }
    } catch {
      witnessing.remove();
      responseText = 'The river is silent. Try again.';
      const entry = document.createElement('div');
      entry.className = 'witness-entry';
      entry.innerHTML = '<p class="history-donor-label">you</p><p class="history-donor-text">' + escapeHtml(content) + '</p><p class="history-response-label">axi</p><p class="witness-mark"><em>The river is silent. Try again.</em></p>';
      responses.appendChild(entry);
    }

    const history = loadHistory();
    history.push({ donor: content, response: responseText.trim(), timestamp: new Date().toISOString() });
    saveHistory(history);

    input.value = '';
    input.classList.add('witnessed');
    setTimeout(() => input.classList.remove('witnessed'), 1200);

    submit.disabled = false;
    submit.textContent = '\u2192';
    input.focus();
  });

  restoreHistory();
  initLedger();
</script>
