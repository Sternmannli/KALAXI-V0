  .equation-btn:hover { background: var(--accent-glow); }

  .equation-text {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .equation-hint {
    font-size: 0.75rem;
