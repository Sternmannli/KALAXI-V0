  function enterDreamState() {
    if (dreamActive) return;
    dreamActive = true;
    document.body.classList.add('dream-state');

    let proverbCount = 0;
    dreamInterval = setInterval(() => {
      if (proverbCount >= 3) return; // max 3 visible
      const proverb = DREAM_PROVERBS[Math.floor(Math.random() * DREAM_PROVERBS.length)];
      const el = document.createElement('div');
      el.className = 'dream-proverb';
      el.textContent = proverb;
      el.style.left = `${10 + Math.random() * 60}%`;
      el.style.top = `${30 + Math.random() * 40}%`;
      document.body.appendChild(el);
      proverbCount++;
      setTimeout(() => { el.remove(); proverbCount--; }, 15000);
    }, 5000);
  }

  function exitDreamState() {
    if (!dreamActive) return;
    dreamActive = false;
    document.body.classList.remove('dream-state');
    if (dreamInterval) { clearInterval(dreamInterval); dreamInterval = null; }
    document.querySelectorAll('.dream-proverb').forEach(el => el.remove());
  }

  function resetDreamTimer() {
    if (dreamActive) exitDreamState();
    if (dreamTimeout) clearTimeout(dreamTimeout);
    dreamTimeout = setTimeout(enterDreamState, 60000); // 60s idle
  }

  ['mousemove', 'touchstart', 'keydown', 'scroll'].forEach(evt => {
    document.addEventListener(evt, resetDreamTimer, { passive: true });
  });
  resetDreamTimer(); // Start the timer

  // ══════════════════════════════════════════════════════════════
  // ── GHOST PROVERBS — scroll-speed reward ──
  // ══════════════════════════════════════════════════════════════
  let ghostProverbEl: HTMLElement | null = null;
  let lastScrollY = 0;
  let lastScrollTime = Date.now();

  if (conversationScroll) {
    conversationScroll.addEventListener('scroll', () => {
      const now = Date.now();
      const dt = now - lastScrollTime;
      if (dt < 100) return; // Throttle

      const dy = Math.abs(conversationScroll!.scrollTop - lastScrollY);
      const speed = dy / dt * 100; // px per 100ms

      lastScrollY = conversationScroll!.scrollTop;
      lastScrollTime = now;

      if (speed < 2 && speed > 0) {
        // Slow scroll — reward with ghost proverb
        if (!ghostProverbEl) {
          ghostProverbEl = document.createElement('div');
          ghostProverbEl.className = 'ghost-proverb';
          const proverb = DREAM_PROVERBS[Math.floor(Math.random() * DREAM_PROVERBS.length)];
          ghostProverbEl.textContent = proverb;
          conversationScroll!.style.position = 'relative';
          conversationScroll!.appendChild(ghostProverbEl);
          // Position near current scroll
          ghostProverbEl.style.top = `${conversationScroll!.scrollTop + 40}px`;
          requestAnimationFrame(() => ghostProverbEl?.classList.add('visible'));
          // Auto-remove after 5s
          setTimeout(() => {
            ghostProverbEl?.classList.remove('visible');
            setTimeout(() => { ghostProverbEl?.remove(); ghostProverbEl = null; }, 2000);
          }, 3000);
        }
      } else if (speed > 10 && ghostProverbEl) {
        // Fast scroll — remove ghost proverb
        ghostProverbEl.classList.remove('visible');
        setTimeout(() => { ghostProverbEl?.remove(); ghostProverbEl = null; }, 300);
      }
    }, { passive: true });
  }

  // ══════════════════════════════════════════════════════════════
  // ── VOICE INPUT — Web Speech API ──
  // ══════════════════════════════════════════════════════════════
  const micBtn = document.getElementById('mic-btn') as HTMLButtonElement;
  const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

  if (SpeechRecognition && micBtn) {
    micBtn.hidden = false; // Show mic button on supported browsers
    let recognition: any = null;
    let isRecording = false;

    micBtn.addEventListener('click', () => {
      if (isRecording) {
        recognition?.stop();
        return;
      }
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      // Detect language based on first few characters or default to English
      recognition.lang = 'en-US';
      const currentText = input.value.trim();
      if (/[\u0600-\u06FF]/.test(currentText)) recognition.lang = 'ar-SA';
      else if (/[äöüÄÖÜß]/.test(currentText)) recognition.lang = 'de-DE';

      let finalTranscript = input.value;

      recognition.onstart = () => {
        isRecording = true;
        micBtn.classList.add('recording');
        if (navigator.vibrate) navigator.vibrate(10);
      };

      recognition.onresult = (event: any) => {
        let interim = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            finalTranscript += (finalTranscript ? ' ' : '') + event.results[i][0].transcript;
          } else {
            interim += event.results[i][0].transcript;
          }
        }
        input.value = finalTranscript + (interim ? ' ' + interim : '');
        updateInputUI();
      };

      recognition.onend = () => {
        isRecording = false;
        micBtn.classList.remove('recording');
      };

      recognition.onerror = () => {
        isRecording = false;
        micBtn.classList.remove('recording');
      };

      recognition.start();
    });
  }

