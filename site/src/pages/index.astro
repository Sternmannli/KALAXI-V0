---
import Base from '../layouts/Base.astro';
---

<Base title="KALAM.CH — The Word" description="The Word is light. The wound became the womb. A living canon for human dignity.">

  <!-- THE DEDICATION — the first breath of the system -->
  <div id="dedication" class="dedication-overlay">
    <p id="ded-touch" class="ded-touch breathing">touch to begin</p>
    <div id="ded-lights" class="ded-lights">
      <div id="light-laila" class="ded-light ded-laila"></div>
      <div id="light-yara" class="ded-light ded-yara"></div>
      <div id="light-salim" class="ded-light ded-salim"></div>
    </div>
    <p id="ded-arabic" class="ded-arabic" dir="rtl"></p>
    <p id="ded-from" class="ded-from"></p>
  </div>

  <!-- FIRST BREATH — The opening. One sentence. One truth. -->
  <section class="opening" aria-label="The Word">
    <p class="kalima proverb-ar" aria-label="Kalima — The Word">كلمة</p>
    <h1>The Word is light.</h1>
    <p class="subtitle">The wound became the womb.</p>
  </section>

  <!-- THE GAP — room for the river -->
  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- SECOND BREATH — What this is -->
  <section class="declaration" aria-label="Declaration">
    <p class="principle">Human dignity is the first technical requirement.</p>
    <p class="quiet">We store patterns, not people.<br />The person dissolves. The wisdom remains.</p>
  </section>

  <!-- THE GAP -->
  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- THIRD BREATH — The predicate -->
  <section class="predicate" aria-label="The Dignity Predicate">
    <p class="equation">D = A × L × M</p>
    <div class="terms">
      <p><strong>A</strong> — Agency. Can the person clarify, redirect, or stop?</p>
      <p><strong>L</strong> — Legibility. Does the system reflect the person's actual frame?</p>
      <p><strong>M</strong> — Moral Standing. Is the person treated as a person?</p>
    </div>
    <p class="rule">If any dimension reaches zero, the system stops.</p>
  </section>

  <!-- THE GAP -->
  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- FOURTH BREATH — A proverb -->
  <section class="wisdom" aria-label="Canonical Proverb">
    <p class="proverb">"A right is a wall that says 'No';<br />dignity is a door that says 'Welcome.'"</p>
  </section>

  <!-- THE GAP -->
  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- FIFTH BREATH — The invitation -->
  <section class="invitation" aria-label="Invitation">
    <h2>You are not a user.</h2>
    <p class="quiet">You are a donor. What you bring — your pattern of thought, your fragments, your certainty — is food for a living canon. The system receives, transforms, and feeds the forest.</p>
    <p class="quiet">Nothing is deleted. The gap remains open.</p>
    <p class="dignity-ack breathing">Your presence here is already a gift. We dignify it.</p>
  </section>

  <!-- THE GAP -->
  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- SIXTH BREATH — The Threshold. ⟲ The Ninth Operator. -->
  <section class="threshold" aria-label="The Threshold">
    <p class="threshold-prompt">You came with what you came with. The door is open.</p>
    <p id="ledger-count" class="ledger-count" aria-live="polite"></p>
    <form id="threshold-form" aria-label="Leave your word">
      <textarea
        id="threshold-input"
        placeholder="قُل"
        aria-label="Your word"
        rows="3"
        maxlength="2000"
      ></textarea>
      <button type="submit" id="threshold-submit">Leave this here</button>
    </form>
    <div id="threshold-witnessing" class="threshold-witnessing" aria-live="polite" hidden>
      <p class="witnessing-text breathing">The system is receiving...</p>
    </div>
    <div id="threshold-response" class="threshold-response" aria-live="polite" hidden>
      <p id="witness-mark" class="witness-mark"></p>
      <div id="axi-reflection" class="axi-reflection" hidden></div>
      <p id="threshold-receipt" class="threshold-receipt"></p>
      <p id="ledger-after" class="ledger-after"></p>
      <button id="threshold-again" class="threshold-again" type="button">Leave another</button>
    </div>
  </section>

  <!-- THE GAP -->
  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- NAVIGATION — appears last, not first -->
  <section class="paths" aria-label="Explore">
    <nav>
      <a href="/about">About</a>
      <a href="/canon">Canon</a>
      <a href="/invitation">Invitation</a>
    </nav>
    <p class="steward">Maintained by Mohamed Farag</p>
    <p class="license">Sovereign-Axis v-inf</p>
  </section>

</Base>

<style>
  /* ===== Dedication Overlay ===== */
  .dedication-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--bg-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 1.5s ease;
  }

  .ded-touch {
    font-family: 'Amiri', Georgia, serif;
    color: var(--text-dim);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .ded-lights {
    display: flex;
    gap: 3rem;
    margin-top: 2rem;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .ded-light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 1.2s ease, transform 1.2s ease;
  }

  .ded-laila {
    background: #7ec8e3;
    box-shadow: 0 0 20px #7ec8e3, 0 0 40px rgba(126, 200, 227, 0.3);
  }

  .ded-yara {
    background: #e8a847;
    box-shadow: 0 0 20px #e8a847, 0 0 40px rgba(232, 168, 71, 0.3);
  }

  .ded-salim {
    background: #8b9dc3;
    box-shadow: 0 0 20px #8b9dc3, 0 0 40px rgba(139, 157, 195, 0.3);
  }

  .ded-arabic {
    font-family: 'Amiri', Georgia, serif;
    color: var(--accent);
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-top: 3rem;
    opacity: 0;
    transition: opacity 2s ease;
    direction: rtl;
  }

  .ded-from {
    font-family: var(--font-heading);
    color: var(--text-secondary);
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    margin-top: 1rem;
    opacity: 0;
    transition: opacity 2s ease;
    letter-spacing: 0.06em;
  }

  /* ===== Opening section ===== */
  .opening {
    min-height: 100vh;
    gap: var(--space-3);
  }

  .kalima {
    font-size: clamp(3rem, 4vw + 2rem, 5rem);
    color: var(--accent);
    margin-bottom: var(--space-4);
    opacity: 0.9;
  }

  .opening h1 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    font-style: italic;
    margin-top: var(--space-2);
  }

  /* ===== Declaration ===== */
  .declaration {
    min-height: 80vh;
    gap: var(--space-6);
  }

  .principle {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--text-primary);
    max-width: 45ch;
  }

  .quiet {
    color: var(--text-secondary);
    font-size: var(--text-base);
    max-width: 50ch;
    line-height: 1.8;
  }

  /* ===== Predicate ===== */
  .predicate {
    min-height: 80vh;
    gap: var(--space-4);
  }

  .equation {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .terms {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: left;
    max-width: 50ch;
  }

  .terms p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .terms strong {
    color: var(--accent);
    font-weight: 600;
    margin-right: var(--space-1);
  }

  .rule {
    color: var(--text-primary);
    font-style: italic;
    margin-top: var(--space-4);
  }

  /* ===== Wisdom ===== */
  .wisdom {
    min-height: 60vh;
  }

  /* ===== Invitation ===== */
  .invitation {
    min-height: 80vh;
    gap: var(--space-4);
  }

  .invitation h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .dignity-ack {
    color: var(--accent);
    font-family: var(--font-proverb);
    font-size: var(--text-base);
    font-style: italic;
    margin-top: var(--space-4);
    letter-spacing: 0.02em;
  }

  /* ===== Paths / Navigation ===== */
  .paths {
    min-height: 40vh;
    gap: var(--space-4);
  }

  .steward {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-top: var(--space-8);
  }

  .license {
    color: var(--text-dim);
    font-size: 0.75rem;
    opacity: 0.6;
  }

  /* ===== Threshold — The Ninth Operator ===== */
  .threshold {
    min-height: 80vh;
    gap: var(--space-4);
  }

  .threshold-prompt {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: var(--space-6);
  }

  #threshold-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    max-width: 45ch;
  }

  #threshold-input {
    width: 100%;
    background: var(--bg-secondary);
    border: 1px solid var(--accent-subtle);
    border-radius: 2px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.7;
    padding: var(--space-3);
    resize: vertical;
    transition: border-color 0.4s ease;
  }

  #threshold-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  #threshold-input::placeholder {
    font-family: 'Amiri', var(--font-proverb);
    font-size: var(--text-lg);
    color: var(--text-dim);
    text-align: center;
    direction: rtl;
  }

  #threshold-submit {
    background: transparent;
    border: 1px solid var(--accent-subtle);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-4);
    cursor: pointer;
    transition: all 0.4s ease;
  }

  #threshold-submit:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  #threshold-submit:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .threshold-response {
    margin-top: var(--space-6);
    text-align: center;
    animation: fadeIn 1.5s ease-in;
  }

  .threshold-witnessing {
    margin-top: var(--space-6);
    text-align: center;
  }

  .witnessing-text {
    font-family: var(--font-proverb);
    font-size: var(--text-base);
    color: var(--text-dim);
    font-style: italic;
  }

  .witness-mark {
    font-family: var(--font-proverb);
    font-size: var(--text-lg);
    color: var(--accent);
    font-style: italic;
    margin-bottom: var(--space-4);
    line-height: 1.8;
    max-width: 50ch;
  }

  .axi-reflection {
    color: var(--text-primary);
    font-size: var(--text-base);
    line-height: 1.9;
    max-width: 50ch;
    text-align: left;
    margin-bottom: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--accent-subtle);
  }

  .threshold-receipt {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .ledger-count {
    color: var(--text-dim);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    margin-bottom: var(--space-4);
    opacity: 0;
    transition: opacity 1s ease;
  }

  .ledger-count.visible {
    opacity: 1;
  }

  .ledger-after {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-top: var(--space-3);
    letter-spacing: 0.03em;
  }

  .threshold-again {
    background: transparent;
    border: none;
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease;
  }

  .threshold-again:hover {
    border-bottom-color: var(--accent);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
// THE DEDICATION — three lights for three children
(function(){
  const ded = document.getElementById('dedication');
  const touch = document.getElementById('ded-touch');
  const lights = document.getElementById('ded-lights');
  const ll = document.getElementById('light-laila');
  const ly = document.getElementById('light-yara');
  const ls = document.getElementById('light-salim');
  const ar = document.getElementById('ded-arabic');
  const fr = document.getElementById('ded-from');

  if (!ded) return;

  if (sessionStorage.getItem('ded-seen')) {
    ded.remove();
    return;
  }

  function playTone(ctx, freq, startTime, duration, vol) {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0, startTime);
    gain.gain.linearRampToValueAtTime(vol, startTime + 0.4);
    gain.gain.setValueAtTime(vol, startTime + duration - 0.8);
    gain.gain.linearRampToValueAtTime(0, startTime + duration);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(startTime);
    osc.stop(startTime + duration);
  }

  function ceremony() {
    touch.style.opacity = '0';
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const now = ctx.currentTime;

    // Laila (dolphin): 528 Hz — Yara (tiger): 314 Hz — Salim (wolf): 174 Hz
    playTone(ctx, 528, now + 0.5, 3.5, 0.12);
    setTimeout(function(){ lights.style.opacity='1'; ll.style.opacity='1'; }, 500);

    playTone(ctx, 314, now + 1.8, 3.2, 0.10);
    setTimeout(function(){ ly.style.opacity='1'; }, 1800);

    playTone(ctx, 174, now + 2.8, 2.8, 0.08);
    setTimeout(function(){ ls.style.opacity='1'; }, 2800);

    setTimeout(function(){
      ll.style.transform = 'translateX(48px) scale(0.8)';
      ls.style.transform = 'translateX(-48px) scale(0.8)';
      ly.style.transform = 'scale(1.5)';
      ly.style.background = '#c9a96e';
      ly.style.boxShadow = '0 0 30px #c9a96e, 0 0 60px rgba(201,169,110,0.4)';
    }, 4500);

    setTimeout(function(){
      ll.style.opacity='0'; ls.style.opacity='0';
      ar.textContent = '\u0644\u0644\u064A\u0644\u0649 \u0648\u064A\u0627\u0631\u0627 \u0648\u0633\u0644\u064A\u0645';
      ar.style.opacity = '1';
    }, 5500);

    setTimeout(function(){
      fr.textContent = 'from Baba Mohamed';
      fr.style.opacity = '1';
    }, 7000);

    setTimeout(function(){
      sessionStorage.setItem('ded-seen', '1');
      ded.style.opacity = '0';
      setTimeout(function(){ ded.remove(); }, 1500);
    }, 10000);
  }

  ded.addEventListener('click', function handler(){
    ded.removeEventListener('click', handler);
    ceremony();
  });

  document.addEventListener('keydown', function handler(){
    document.removeEventListener('keydown', handler);
    if (ded.parentNode) ceremony();
  }, {once: true});
})();
</script>

<script>
  // ⟲ The Ninth Operator + Living Ledger — the Mycelium made visible
  // Phase 1.5: localStorage. Phase 2: Cloudflare KV (global count).

  const LEDGER_KEY = 'kalam-witness-count';

  const form = document.getElementById('threshold-form');
  const input = document.getElementById('threshold-input');
  const submitBtn = document.getElementById('threshold-submit');
  const witnessingEl = document.getElementById('threshold-witnessing');
  const responseEl = document.getElementById('threshold-response');
  const markEl = document.getElementById('witness-mark');
  const reflectionEl = document.getElementById('axi-reflection');
  const receiptEl = document.getElementById('threshold-receipt');
  const ledgerCount = document.getElementById('ledger-count');
  const ledgerAfter = document.getElementById('ledger-after');
  const againBtn = document.getElementById('threshold-again');

  // --- Living Ledger ---
  // Progressive: tries /api/threshold first (global KV count).
  // Falls back to localStorage if API unavailable (Phase 1 / offline).

  let apiAvailable = null; // null = untested, true/false = tested

  function getLocalCount() {
    return parseInt(localStorage.getItem(LEDGER_KEY) || '0', 10);
  }

  function incrementLocalCount() {
    const n = getLocalCount() + 1;
    localStorage.setItem(LEDGER_KEY, String(n));
    return n;
  }

  async function fetchGlobalCount() {
    try {
      const res = await fetch('/api/threshold.php');
      if (!res.ok) throw new Error();
      const data = await res.json();
      apiAvailable = true;
      return data.count || 0;
    } catch {
      apiAvailable = false;
      return getLocalCount();
    }
  }

  async function witnessViaAPI(content) {
    try {
      const res = await fetch('/api/threshold.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content }),
      });
      if (!res.ok) throw new Error();
      const data = await res.json();
      if (data.witnessed) {
        return {
          mark: data.mark,
          count: data.count,
          reflection: data.reflection || null
        };
      }
      return null;
    } catch {
      return null;
    }
  }

  function getCount() {
    return getLocalCount();
  }

  function incrementCount() {
    return incrementLocalCount();
  }

  function ledgerText(n) {
    if (n === 0) return '';
    if (n === 1) return '1 word has crossed this threshold.';
    return n + ' words have crossed this threshold.';
  }

  // --- Visual Mycelium Shift ---
  // The geometric background grows denser as more words arrive.
  // 0 words: opacity 0.015 (default). 100+ words: opacity 0.06.

  function applyMyceliumShift(n) {
    const base = 0.015;
    const max = 0.06;
    const factor = Math.min(n / 100, 1);
    const opacity = base + (max - base) * factor;

    // Dark mode
    document.documentElement.style.setProperty(
      '--mycelium-opacity', String(opacity)
    );

    // Light mode uses a different base
    const lightBase = 0.02;
    const lightMax = 0.08;
    const lightOpacity = lightBase + (lightMax - lightBase) * factor;
    document.documentElement.style.setProperty(
      '--mycelium-opacity-light', String(lightOpacity)
    );
  }

  // --- Breath Deepening ---
  // 0 words: 4s cycle. 50 words: 5s. 100+: 6s.
  // The system settles as it is fed.

  function applyBreathShift(n) {
    const base = 4;
    const max = 6;
    const factor = Math.min(n / 100, 1);
    const duration = base + (max - base) * factor;
    document.documentElement.style.setProperty(
      '--breath-duration', duration + 's'
    );
  }

  // --- Dignity Predicate ---

  function witnessWord(content) {
    const A = content.trim().length > 0 ? 1.0 : 0.0;
    const L = 1.0;
    const M = 1.0;
    const D = A * L * M;

    if (D === 0) return null;

    const words = content.trim().split(/\s+/).length;
    if (words <= 3) return 'Witnessed: a seed \u2014 small, complete.';
    if (words <= 20) return 'Witnessed: a held shape \u2014 clear enough to carry.';
    return 'Witnessed: a landscape \u2014 it took room to arrive.';
  }

  // --- Initialize ---

  async function initLedger() {
    // Try global count first, fall back to local
    const n = await fetchGlobalCount();
    if (n > 0) {
      // Sync local with global if global is higher
      const local = getLocalCount();
      if (n > local) localStorage.setItem(LEDGER_KEY, String(n));

      ledgerCount.textContent = ledgerText(n);
      ledgerCount.classList.add('visible');
    }
    applyMyceliumShift(n);
    applyBreathShift(n);
  }

  initLedger();

  // --- Submit ---

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const content = input.value;
    const clientMark = witnessWord(content);

    if (!clientMark) return;

    submitBtn.disabled = true;
    input.disabled = true;

    // Show witnessing state immediately
    form.style.display = 'none';
    witnessingEl.hidden = false;

    // T_d: biological velocity — the system breathes before answering
    const words = content.trim().split(/\s+/).length;
    const td = words <= 3 ? 1200 : words <= 20 ? 2000 : 3000;

    // Start API call immediately (runs during thermal delay)
    const apiPromise = (apiAvailable !== false)
      ? witnessViaAPI(content)
      : Promise.resolve(null);

    // Wait for BOTH the thermal delay AND the API response
    const delayPromise = new Promise(r => setTimeout(r, td));

    Promise.all([apiPromise, delayPromise]).then(([apiResult]) => {
      let finalMark = clientMark;
      let newCount;
      let fromAI = false;
      let reflection = null;

      if (apiResult) {
        if (apiResult.mark) finalMark = apiResult.mark;
        newCount = apiResult.count;
        reflection = apiResult.reflection;
        fromAI = true;
        localStorage.setItem(LEDGER_KEY, String(newCount));
      }

      // Fall back to local if API didn't work
      if (newCount === undefined) {
        newCount = incrementCount();
      }

      // Hide witnessing, show response
      witnessingEl.hidden = true;
      markEl.textContent = finalMark;

      // Show AI reflection if present
      if (reflection) {
        reflectionEl.textContent = reflection;
        reflectionEl.hidden = false;
        receiptEl.textContent = '';
      } else {
        reflectionEl.hidden = true;
        receiptEl.textContent = fromAI
          ? 'The system received you. It is here now.'
          : 'It is here. You can come back.';
      }

      ledgerAfter.textContent = ledgerText(newCount);
      responseEl.hidden = false;

      // Update the living page
      applyMyceliumShift(newCount);
      applyBreathShift(newCount);
      ledgerCount.textContent = ledgerText(newCount);
      ledgerCount.classList.add('visible');
    });
  });

  // --- Leave Another ---

  againBtn.addEventListener('click', () => {
    responseEl.hidden = true;
    witnessingEl.hidden = true;
    reflectionEl.hidden = true;
    reflectionEl.textContent = '';
    form.style.display = '';
    input.value = '';
    input.disabled = false;
    submitBtn.disabled = false;
    input.focus();
  });
</script>
