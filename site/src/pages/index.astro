  function updateDignityMeter(state: 'active' | 'halted', failedAxis?: string) {
    if (!meterFillA || !meterFillL || !meterFillM || !meterStatusEl) return;
    if (state === 'active') {
      meterFillA.style.height = '100%';
      meterFillL.style.height = '100%';
