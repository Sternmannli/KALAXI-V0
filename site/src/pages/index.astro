  // Play a mode-specific sound (ENKi resonance)
  function playModeSound(register: string) {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const now = ctx.currentTime;
      // Base frequency shifts by register — warm for greeting, lower for grief, sharp for anger
      const freqMap: Record<string, number[]> = {
        greeting:  [440, 523],
        grief:     [220, 262],
        anger:     [330, 392],
        fear:      [294, 350],
        seeking:   [392, 494],
        trust:     [349, 440],
        dignity:   [262, 330],
        work:      [330, 415],
        general:   [440, 523],
      };
      const freqs = freqMap[register] || freqMap.general;
      freqs.forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0, now + i * 0.15);
        gain.gain.linearRampToValueAtTime(0.02, now + i * 0.15 + 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.15 + 0.8);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now + i * 0.15);
        osc.stop(now + i * 0.15 + 0.9);
      });
    } catch { /* Web Audio not available */ }
  }

  // Mood selector removed — register detected automatically from donor's words
  // selectedMood stays 'witness' (default) for API payload compatibility

  // ── Device detection ──
  const isMobile = /Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  const inputHint = document.getElementById('input-hint');
  if (inputHint) inputHint.textContent = isMobile ? 'Tap \u2191 to send' : 'Ctrl+Enter to send';

  // ── iOS keyboard fix — keep input above keyboard ──
