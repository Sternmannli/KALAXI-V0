  // ══════════════════════════════════════════════════════════════
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  function setSubmitState(state: 'idle' | 'sending' | 'witnessing' | 'receiving' | 'done') {
    if (!submitBtn) return;
    const sendIcon = submitBtn.querySelector('.send-icon') as HTMLElement;
    const sendingIcon = submitBtn.querySelector('.sending-icon') as HTMLElement;
    const doneIcon = submitBtn.querySelector('.done-icon') as HTMLElement;

    submitBtn.className = 'input-submit';
    if (sendIcon) sendIcon.style.display = 'none';
    if (sendingIcon) sendingIcon.style.display = 'none';
    if (doneIcon) doneIcon.style.display = 'none';

    switch (state) {
      case 'idle':
        if (sendIcon) sendIcon.style.display = '';
        break;
      case 'sending':
        submitBtn.classList.add('visible', 'state-sending');
        if (sendingIcon) sendingIcon.style.display = '';
        break;
      case 'witnessing':
        submitBtn.classList.add('visible', 'state-witnessing');
        if (sendingIcon) sendingIcon.style.display = '';
        break;
      case 'receiving':
        submitBtn.classList.add('visible');
        if (sendIcon) sendIcon.style.display = '';
        break;
      case 'done':
        submitBtn.classList.add('visible', 'state-done');
        if (doneIcon) doneIcon.style.display = '';
        setTimeout(() => setSubmitState('idle'), 1500);
        break;
    }
  }

