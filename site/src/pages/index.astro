// === DRAWER TOGGLE ===
(function(){
  var toggle = document.getElementById('drawer-toggle');
  var drawer = document.getElementById('content-drawer');
  var close = document.getElementById('drawer-close');
  if (!toggle || !drawer || !close) return;

  function openDrawer() {
    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', function(){
    if (drawer.classList.contains('open')) { closeDrawer(); } else { openDrawer(); }
  });

  close.addEventListener('click', closeDrawer);

  // Close on Escape
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
  });
})();

// === BACKGROUND PROVERB ROTATION ===
(function(){
  var proverbs = [
    "Begin small. Begin now.",
    "A right is a wall that says \u2018No\u2019; dignity is a door that says \u2018Welcome.\u2019",
    "Do not shout at metal. Hear its problem first.",
    "She clawed at the air. Fists closed on nothing. Then the nothing opened.",
    "Start where your hands already touch the world.",
    "Care is the knot that doesn\u2019t slip.",
    "The door appears after you try the wall.",
    "Structure survives by yielding to forces, not opposing them.",
    "A first step teaches more than a hundred plans.",
    "What you carry forward changes what forward means."
  ];

  var el = document.getElementById('bg-proverb');
  if (!el) return;

  var idx = Math.floor(Math.random() * proverbs.length);

  function showProverb() {
    el.classList.remove('visible');
    setTimeout(function(){
      el.textContent = proverbs[idx];
      idx = (idx + 1) % proverbs.length;
      el.classList.add('visible');
    }, 3000); // 3s fade out, then new text fades in
  }

  // Start after 2 seconds
  setTimeout(function(){
    el.textContent = proverbs[idx];
    el.classList.add('visible');
    idx = (idx + 1) % proverbs.length;

    // Rotate every 30 seconds
    setInterval(showProverb, 30000);
  }, 2000);
})();
</script>

<script>
  // === AXI VOICE — bare text, no containers, no chat ===
  // The page is the interface. Text appears. Text dissolves. The space responds.

  const WORKER_URL = 'https://axi-voice.REPLACE_WITH_YOUR_SUBDOMAIN.workers.dev';

  const form = document.getElementById('threshold-form') as HTMLFormElement;
  const input = document.getElementById('threshold-input') as HTMLInputElement;
  const voice = document.getElementById('axi-voice') as HTMLDivElement;
  const ledgerCount = document.getElementById('ledger-count') as HTMLParagraphElement;
  const drawerHandleZone = document.getElementById('drawer-handle-zone') as HTMLDivElement;

  const STORAGE_KEY = 'kalam-exchanges';
  let exchangeCount = 0;
  let busy = false;

  // ── Storage ──
  interface Exchange { donor: string; response: string; ts: string; }

  function loadExchanges(): Exchange[] {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
    catch { return []; }
  }

  function saveExchange(donor: string, response: string) {
    const ex = loadExchanges();
    ex.push({ donor, response, ts: new Date().toISOString() });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ex));
  }

  function escapeHtml(str: string): string {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  // ── Letter-by-letter materialization ──
  function materializeText(container: HTMLElement, text: string, onDone?: () => void) {
    container.innerHTML = '';
    const chars = text.split('');
    const baseDelay = 35; // ms per character
    const maxDelay = chars.length * baseDelay;
    // Cap total animation time at 4 seconds
    const adjustedDelay = maxDelay > 4000 ? 4000 / chars.length : baseDelay;

    chars.forEach((char, i) => {
      const span = document.createElement('span');
      span.className = 'axi-letter';
      span.textContent = char === ' ' ? '\u00a0' : char;
      span.style.animationDelay = (i * adjustedDelay) + 'ms';
      container.appendChild(span);
    });

    // Mark as present after all letters have arrived
    const totalTime = chars.length * adjustedDelay + 400;
    setTimeout(() => {
      container.classList.add('present');
      if (onDone) onDone();
    }, totalTime);
  }

  // ── Clear previous utterance to ghost ──
  function ghostPrevious() {
    const existing = voice.querySelectorAll('.axi-utterance:not(.ghost)');
    existing.forEach(el => {
      el.classList.add('ghost');
    });
    // Remove old ghosts (keep max 1)
    const ghosts = voice.querySelectorAll('.axi-utterance.ghost');
    if (ghosts.length > 1) {
      for (let i = 0; i < ghosts.length - 1; i++) {
        ghosts[i].remove();
      }
    }
  }

  // ── Show witnessing state ──
  function showWitnessing(): HTMLElement {
    const el = document.createElement('div');
    el.className = 'axi-witnessing';
    el.innerHTML = '<span class="dot">\u00b7</span><span class="dot">\u00b7</span><span class="dot">\u00b7</span>';
    voice.appendChild(el);
    return el;
  }

  // ── Speak — the core utterance ──
  function speak(text: string, sealed?: boolean) {
    ghostPrevious();

    const utterance = document.createElement('div');
    utterance.className = 'axi-utterance';
    if (sealed) utterance.style.color = 'var(--color-danger, #8b3a3a)';
    voice.appendChild(utterance);

    materializeText(utterance, text, () => {
      // Reveal drawer handle after first exchange
      drawerHandleZone.hidden = false;
    });

    // Warm the page
    exchangeCount++;
    const warmth = Math.min(exchangeCount * 0.02, 0.15);
    document.documentElement.style.setProperty('--warmth', String(warmth));
    document.documentElement.style.setProperty('--mycelium-intensity', String(Math.min(exchangeCount * 5, 100)));
  }

  // ── 80 Hz Sonar — the children's frequency ──
  let sonarCtx: AudioContext | null = null;
  let sonarOsc: OscillatorNode | null = null;
  let sonarGain: GainNode | null = null;

  function startSonar() {
    if (sonarOsc) return;
    try {
      if (!sonarCtx) sonarCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      sonarOsc = sonarCtx.createOscillator();
      sonarGain = sonarCtx.createGain();
      sonarOsc.type = 'sine';
      sonarOsc.frequency.value = 80;
      sonarGain.gain.setValueAtTime(0, sonarCtx.currentTime);
      sonarGain.gain.linearRampToValueAtTime(0.015, sonarCtx.currentTime + 1.0);
      sonarOsc.connect(sonarGain);
      sonarGain.connect(sonarCtx.destination);
      sonarOsc.start();
    } catch { /* Web Audio not available */ }
  }

  function stopSonar() {
    if (sonarGain && sonarCtx) {
      sonarGain.gain.linearRampToValueAtTime(0, sonarCtx.currentTime + 0.5);
      setTimeout(() => {
        if (sonarOsc) { try { sonarOsc.stop(); } catch {} sonarOsc = null; }
        sonarGain = null;
      }, 600);
    }
  }

  input.addEventListener('focus', startSonar);
  input.addEventListener('blur', stopSonar);

  // ── Ledger init ──
  async function initLedger() {
    try {
      const res = await fetch(WORKER_URL, { method: 'GET' });
      if (!res.ok) return;
      const data = await res.json();
      if (data.count > 0) {
        ledgerCount.textContent = data.count + '';
        ledgerCount.classList.add('visible');
      }
    } catch {
      const ex = loadExchanges();
      if (ex.length > 0) {
        exchangeCount = ex.length;
        ledgerCount.textContent = ex.length + '';
        ledgerCount.classList.add('visible');
      }
    }
  }

  // ── Restore last utterance on page load ──
  function restoreLast() {
    const ex = loadExchanges();
    if (ex.length === 0) return;
    exchangeCount = ex.length;
    const last = ex[ex.length - 1];
    // Show last response as a ghost — the memory of the previous visit
    const ghost = document.createElement('div');
    ghost.className = 'axi-utterance ghost';
    ghost.textContent = last.response;
    voice.appendChild(ghost);
    drawerHandleZone.hidden = false;
  }

  // ── Form submission — the threshold ──
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = input.value.trim();
    if (!content || busy) return;
    busy = true;

    // Dissolve the input
    input.classList.add('dissolving');
    const donorText = content;
    input.value = '';

    // Brief pause — the gap
    await new Promise(r => setTimeout(r, 600));

    // Remove dissolve, show witnessing
    input.classList.remove('dissolving');
    const waiting = showWitnessing();

    let responseText = '';

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ input: donorText }),
      });

      waiting.remove();

      if (res.ok) {
        const data = await res.json();
        responseText = data.response || data.witness_mark || 'Witnessed.';
        speak(responseText, data.sealed);

        if (data.total) {
          ledgerCount.textContent = data.total + '';
          ledgerCount.classList.add('visible');
        }
      } else {
        responseText = 'Witnessed.';
        speak(responseText);
      }
    } catch {
      waiting.remove();
      responseText = 'The river is silent. Try again.';
      speak(responseText);
    }

    saveExchange(donorText, responseText);
    busy = false;
    input.focus();
  });

  restoreLast();
  initLedger();
</script>
