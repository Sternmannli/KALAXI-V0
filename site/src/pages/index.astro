      const proceedBtn = document.createElement('button');
      proceedBtn.className = 'ceremony-btn proceed';
      proceedBtn.textContent = 'proceed';
      proceedBtn.addEventListener('click', () => { pause.remove(); resolve('proceed'); });

      const holdBtn = document.createElement('button');
      holdBtn.className = 'ceremony-btn';
      holdBtn.textContent = 'hold — let me rewrite';
      holdBtn.addEventListener('click', () => { pause.remove(); resolve('hold'); });

      actions.appendChild(proceedBtn);
      actions.appendChild(holdBtn);
      pause.appendChild(actions);

      voice.appendChild(pause);
      scrollToBottom();

      // Auto-proceed after 10 seconds — AXI does not block the river
      setTimeout(() => {
        if (pause.parentNode) {
          pause.remove();
          resolve('proceed');
        }
      }, 10000);
    });
