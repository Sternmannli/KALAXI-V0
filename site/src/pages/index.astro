---
import Base from '../layouts/Base.astro';
---

<Base title="KALAM.CH — The Word" description="The Word is light. The wound became the womb. A living canon for human dignity.">

  <!-- THE DEDICATION — three lights for three children -->
  <div id="dedication" class="dedication-overlay">
    <p id="ded-touch" class="ded-touch breathing">touch to begin</p>
    <div id="ded-lights" class="ded-lights">
      <div class="ded-child" id="child-laila">
        <div class="ded-light ded-laila"></div>
        <span class="ded-name" dir="rtl">ليلى</span>
        <span class="ded-name-en">Laila</span>
        <span class="ded-animal">🐬</span>
      </div>
      <div class="ded-child" id="child-yara">
        <div class="ded-light ded-yara"></div>
        <span class="ded-name" dir="rtl">يارا</span>
        <span class="ded-name-en">Yara</span>
        <span class="ded-animal">🐯</span>
      </div>
      <div class="ded-child" id="child-salim">
        <div class="ded-light ded-salim"></div>
        <span class="ded-name" dir="rtl">سليم</span>
        <span class="ded-name-en">Salim</span>
        <span class="ded-animal">🐺</span>
      </div>
    </div>
    <p id="ded-from" class="ded-from"></p>
  </div>

  <!-- FIRST BREATH — The opening -->
  <section class="opening" aria-label="The Word">
    <p class="kalima proverb-ar" aria-label="Kalima — The Word">كلمة</p>
    <h1>The Word is light.</h1>
    <p class="subtitle">The wound became the womb.</p>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- SECOND BREATH — What this is -->
  <section class="declaration" aria-label="Declaration">
    <p class="principle">Human dignity is the first technical requirement.</p>
    <p class="quiet">We store patterns, not people.<br />The person dissolves. The wisdom remains.</p>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- THIRD BREATH — The predicate -->
  <section class="predicate" aria-label="The Dignity Predicate">
    <p class="equation">D = A × L × M</p>
    <div class="terms">
      <p><strong>A</strong> — Agency. Can the person clarify, redirect, or stop?</p>
      <p><strong>L</strong> — Legibility. Does the system reflect the person's actual frame?</p>
      <p><strong>M</strong> — Moral Standing. Is the person treated as a person?</p>
    </div>
    <p class="rule">If any dimension reaches zero, the system stops.</p>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- FOURTH BREATH — A proverb -->
  <section class="wisdom" aria-label="Canonical Proverb">
    <p class="proverb">"A right is a wall that says 'No';<br />dignity is a door that says 'Welcome.'"</p>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- FIFTH BREATH — The invitation -->
  <section class="invitation" aria-label="Invitation">
    <h2>You are not a user.</h2>
    <p class="quiet">You are a donor. What you bring — your pattern of thought, your fragments, your certainty — is food for a living canon. The system receives, transforms, and feeds the forest.</p>
    <p class="quiet">Nothing is deleted. The gap remains open.</p>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- SIXTH BREATH — The Threshold. Always present. Never hides. -->
  <section class="threshold" aria-label="The Threshold">
    <p class="threshold-prompt">You came with what you came with. The door is open.</p>
    <p id="ledger-count" class="ledger-count" aria-live="polite"></p>

    <div class="threshold-container">
      <div id="threshold-responses" class="threshold-responses" aria-live="polite"></div>

      <form id="threshold-form" method="POST" action="/api/threshold.php" aria-label="Leave your word">
        <textarea
          id="threshold-input"
          name="content"
          placeholder="قُل"
          aria-label="Your word"
          rows="3"
          maxlength="2000"
        ></textarea>
        <button type="submit" id="threshold-submit">Leave this here</button>
      </form>
    </div>
  </section>

  <div class="gap" role="separator" aria-hidden="true"></div>

  <!-- NAVIGATION — appears last -->
  <section class="paths" aria-label="Explore">
    <nav>
      <a href="/about">About</a>
      <a href="/canon">Canon</a>
      <a href="/invitation">Invitation</a>
    </nav>
    <p class="steward">Maintained by Mohamed Farag</p>
    <p class="license">Sovereign-Axis v-inf</p>
  </section>

</Base>

<style>
  /* ===== Dedication Overlay ===== */
  .dedication-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--bg-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 1.5s ease;
  }

  .ded-touch {
    font-family: var(--font-heading);
    color: var(--text-dim);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    opacity: 0.5;
  }

  .ded-lights {
    display: flex;
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: 3rem;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .ded-child {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transition: opacity 1.5s ease, transform 1s ease;
  }

  .ded-light {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transition: all 1.2s ease;
  }

  .ded-laila .ded-light {
    background: #7ec8e3;
    box-shadow: 0 0 16px #7ec8e3, 0 0 32px rgba(126, 200, 227, 0.2);
  }

  .ded-yara .ded-light {
    background: #e8a847;
    box-shadow: 0 0 16px #e8a847, 0 0 32px rgba(232, 168, 71, 0.2);
  }

  .ded-salim .ded-light {
    background: #c0c8d8;
    box-shadow: 0 0 16px #c0c8d8, 0 0 32px rgba(192, 200, 216, 0.2);
  }

  .ded-name {
    font-family: 'Amiri', Georgia, serif;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1;
  }

  .ded-name-en {
    font-family: var(--font-heading);
    color: var(--text-dim);
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .ded-animal {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1;
    opacity: 0.8;
  }

  .ded-from {
    font-family: var(--font-heading);
    color: var(--text-dim);
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    margin-top: 2.5rem;
    opacity: 0;
    transition: opacity 2s ease;
    letter-spacing: 0.06em;
  }

  /* ===== Opening section ===== */
  .opening {
    min-height: 100vh;
    gap: var(--space-3);
  }

  .kalima {
    font-size: clamp(3rem, 4vw + 2rem, 5rem);
    color: var(--accent);
    margin-bottom: var(--space-4);
    opacity: 0.9;
  }

  .opening h1 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    font-style: italic;
    margin-top: var(--space-2);
  }

  /* ===== Declaration ===== */
  .declaration {
    min-height: 80vh;
    gap: var(--space-6);
  }

  .principle {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--text-primary);
    max-width: 45ch;
  }

  .quiet {
    color: var(--text-secondary);
    font-size: var(--text-base);
    max-width: 50ch;
    line-height: 1.8;
  }

  /* ===== Predicate ===== */
  .predicate {
    min-height: 80vh;
    gap: var(--space-4);
  }

  .equation {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .terms {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: left;
    max-width: 50ch;
  }

  .terms p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .terms strong {
    color: var(--accent);
    font-weight: 600;
    margin-right: var(--space-1);
  }

  .rule {
    color: var(--text-primary);
    font-style: italic;
    margin-top: var(--space-4);
  }

  /* ===== Wisdom ===== */
  .wisdom {
    min-height: 60vh;
  }

  /* ===== Invitation ===== */
  .invitation {
    min-height: 80vh;
    gap: var(--space-4);
  }

  .invitation h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  /* ===== Paths / Navigation ===== */
  .paths {
    min-height: 40vh;
    gap: var(--space-4);
  }

  .steward {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-top: var(--space-8);
  }

  .license {
    color: var(--text-dim);
    font-size: 0.75rem;
    opacity: 0.6;
  }

  /* ===== Threshold — Always visible, never hides ===== */
  .threshold {
    min-height: 80vh;
    gap: var(--space-4);
  }

  .threshold-prompt {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: var(--space-4);
  }

  .threshold-container {
    width: 100%;
    max-width: 50ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .threshold-responses {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .witness-entry {
    text-align: center;
    animation: fadeIn 1.5s ease-in;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--accent-subtle);
  }

  .witness-mark {
    font-family: var(--font-proverb);
    font-size: var(--text-lg);
    color: var(--accent);
    font-style: italic;
    margin-bottom: var(--space-2);
    line-height: 1.8;
  }

  .axi-reflection {
    color: var(--text-primary);
    font-size: var(--text-base);
    line-height: 1.9;
    text-align: left;
    margin-bottom: var(--space-2);
  }

  .witness-receipt {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-top: var(--space-2);
  }

  #threshold-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
  }

  #threshold-input {
    width: 100%;
    min-height: 5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--accent-subtle);
    border-radius: 2px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.7;
    padding: var(--space-3);
    resize: vertical;
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  #threshold-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-subtle);
  }

  #threshold-input::placeholder {
    font-family: 'Amiri', var(--font-proverb);
    font-size: var(--text-lg);
    color: var(--text-dim);
    text-align: center;
    direction: rtl;
  }

  #threshold-submit {
    background: transparent;
    border: 1px solid var(--accent-subtle);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-4);
    cursor: pointer;
    transition: all 0.4s ease;
  }

  #threshold-submit:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  #threshold-submit:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .ledger-count {
    color: var(--text-dim);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    margin-bottom: var(--space-2);
    opacity: 0;
    transition: opacity 1s ease;
  }

  .ledger-count.visible {
    opacity: 1;
  }

  .witnessing-indicator {
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .witnessing-text {
    font-family: var(--font-proverb);
    font-size: var(--text-base);
    color: var(--text-dim);
    font-style: italic;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
// THE DEDICATION — three lights for three children
(function(){
  var ded = document.getElementById('dedication');
  var touch = document.getElementById('ded-touch');
  var lights = document.querySelector('.ded-lights');
  var childLaila = document.getElementById('child-laila');
  var childYara = document.getElementById('child-yara');
  var childSalim = document.getElementById('child-salim');
  var from = document.getElementById('ded-from');

  if (!ded) return;

  if (sessionStorage.getItem('ded-seen')) {
    ded.remove();
    return;
  }

  function playTone(ctx, freq, startTime, duration, vol) {
    var osc = ctx.createOscillator();
    var gain = ctx.createGain();
    // Triangle wave — softer, warmer than sine
    osc.type = 'triangle';
    osc.frequency.value = freq;
    // Very gentle envelope — 1.5s fade in, long sustain, 1.5s fade out
    gain.gain.setValueAtTime(0, startTime);
    gain.gain.linearRampToValueAtTime(vol, startTime + 1.5);
    gain.gain.setValueAtTime(vol, startTime + duration - 1.5);
    gain.gain.linearRampToValueAtTime(0, startTime + duration);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(startTime);
    osc.stop(startTime + duration);
  }

  function ceremony() {
    touch.style.opacity = '0';
    var ctx = new (window.AudioContext || window.webkitAudioContext)();
    var now = ctx.currentTime;

    // Laila (dolphin): 396 Hz — Yara (tiger): 528 Hz — Salim (wolf): 174 Hz
    // Volume: 0.03 — a whisper, not a shout
    lights.style.opacity = '1';

    // Laila appears
    playTone(ctx, 396, now + 0.8, 4.5, 0.03);
    setTimeout(function(){ childLaila.style.opacity = '1'; }, 800);

    // Yara appears
    playTone(ctx, 528, now + 2.2, 4.0, 0.025);
    setTimeout(function(){ childYara.style.opacity = '1'; }, 2200);

    // Salim appears
    playTone(ctx, 174, now + 3.5, 3.5, 0.02);
    setTimeout(function(){ childSalim.style.opacity = '1'; }, 3500);

    // "from Baba Mohamed"
    setTimeout(function(){
      from.textContent = 'from Baba Mohamed';
      from.style.opacity = '1';
    }, 6000);

    // Fade out and continue
    setTimeout(function(){
      sessionStorage.setItem('ded-seen', '1');
      ded.style.opacity = '0';
      setTimeout(function(){ ded.remove(); }, 1500);
    }, 9500);
  }

  ded.addEventListener('click', function handler(){
    ded.removeEventListener('click', handler);
    ceremony();
  });

  document.addEventListener('keydown', function handler(){
    document.removeEventListener('keydown', handler);
    if (ded.parentNode) ceremony();
  }, {once: true});
})();
</script>

<script>
  // The Threshold — form always stays visible.
  // After submission, response appears above the form. Form clears and remains.

  const form = document.getElementById('threshold-form') as HTMLFormElement;
  const input = document.getElementById('threshold-input') as HTMLTextAreaElement;
  const submit = document.getElementById('threshold-submit') as HTMLButtonElement;
  const responses = document.getElementById('threshold-responses') as HTMLDivElement;
  const ledgerCount = document.getElementById('ledger-count') as HTMLParagraphElement;

  // Fetch and display ledger count
  async function initLedger() {
    try {
      const res = await fetch('/api/threshold.php');
      if (!res.ok) return;
      const data = await res.json();
      if (data.count > 0) {
        ledgerCount.textContent = data.count === 1
          ? '1 has crossed this threshold.'
          : data.count + ' have crossed this threshold.';
        ledgerCount.classList.add('visible');
      }
    } catch {}
  }

  // Handle form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = input.value.trim();
    if (!content) return;

    submit.disabled = true;
    submit.textContent = 'receiving...';

    // Show witnessing indicator
    const witnessing = document.createElement('div');
    witnessing.className = 'witnessing-indicator';
    witnessing.innerHTML = '<p class="witnessing-text breathing">The system is receiving...</p>';
    responses.appendChild(witnessing);

    try {
      const res = await fetch('/api/threshold.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content }),
      });

      // Remove witnessing indicator
      witnessing.remove();

      if (res.ok) {
        const data = await res.json();

        // Build witness entry
        const entry = document.createElement('div');
        entry.className = 'witness-entry';

        let html = '';
        if (data.witness_mark) {
          html += '<p class="witness-mark">' + data.witness_mark + '</p>';
        }
        if (data.reflection) {
          html += '<div class="axi-reflection">' + data.reflection + '</div>';
        }
        if (data.receipt) {
          html += '<p class="witness-receipt">' + data.receipt + '</p>';
        }
        if (data.count) {
          html += '<p class="witness-receipt">' + data.count + ' have crossed this threshold.</p>';
        }

        entry.innerHTML = html;
        responses.appendChild(entry);

        // Update ledger count
        if (data.count) {
          ledgerCount.textContent = data.count + ' have crossed this threshold.';
          ledgerCount.classList.add('visible');
        }
      } else {
        // Fallback: client-side witness
        const entry = document.createElement('div');
        entry.className = 'witness-entry';
        entry.innerHTML = '<p class="witness-mark"><em>Witnessed.</em></p><p class="witness-receipt">The system received you. It is here now.</p>';
        responses.appendChild(entry);
      }
    } catch {
      witnessing.remove();
      const entry = document.createElement('div');
      entry.className = 'witness-entry';
      entry.innerHTML = '<p class="witness-mark"><em>Witnessed.</em></p><p class="witness-receipt">The system received you. It is here now.</p>';
      responses.appendChild(entry);
    }

    // Clear input but keep form visible — always ready
    input.value = '';
    submit.disabled = false;
    submit.textContent = 'Leave this here';
    input.focus();
  });

  initLedger();
</script>
