  .source-detail { max-width: 45ch; text-align: center; animation: panelIn 0.4s ease; margin-top: var(--space-2); }
  .source-detail[hidden] { display: none; }
  .source-detail p { color: var(--text-primary); font-size: var(--text-base); line-height: 1.8; }

  .more-link { display: inline-block; color: var(--color-dignity); font-size: var(--text-sm); letter-spacing: 0.03em; margin-top: var(--space-2); border-bottom: 1px solid var(--color-dignity); transition: all 0.3s ease; }
  .more-link:hover { opacity: 0.7; }

  /* ===== Light Mode ===== */
  @media (prefers-color-scheme: light) {
    .equation-text { color: var(--color-dignity); font-weight: 500; }
