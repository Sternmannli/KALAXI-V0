  // ── GAP BUTTON — local-only silence ──
  // ══════════════════════════════════════════════════════════════
  function addGapButton(frame: HTMLElement, exchangeIdx: number) {
    const gapBtn = document.createElement('button');
    gapBtn.className = 'gap-btn';
    gapBtn.title = 'Leave a gap';
    gapBtn.textContent = '◯';
    gapBtn.setAttribute('aria-label', 'Leave a gap — a private reflection');

    const gapArea = document.createElement('div');
    gapArea.className = 'gap-area';
    const gapText = document.createElement('textarea');
    gapText.className = 'gap-textarea';
    gapText.placeholder = 'a silence, a reflection, a question not yet ready';

    // Load from localStorage
    const storageKey = `kalam-gap-${exchangeIdx}`;
    const saved = localStorage.getItem(storageKey);
    if (saved) gapText.value = saved;

    gapText.addEventListener('input', () => {
      localStorage.setItem(storageKey, gapText.value);
    });

    gapArea.appendChild(gapText);

    gapBtn.addEventListener('click', () => {
      gapArea.classList.toggle('open');
      if (gapArea.classList.contains('open')) gapText.focus();
    });

    // Add gap button to the actions row if it exists
    const actionsRow = frame.querySelector('.axi-response-actions');
    if (actionsRow) {
      actionsRow.appendChild(gapBtn);
    }
    frame.appendChild(gapArea);
