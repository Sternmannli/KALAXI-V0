  // ── Copy button SVG ──
  const COPY_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const CHECK_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

  // ── Speaker SVG ──
  const SPEAKER_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>';
  const STOP_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"></rect></svg>';

  function addResponseActions(frame: HTMLElement, text: string) {
    const actions = document.createElement('div');
    actions.className = 'axi-response-actions';

    // Copy button
    const copyBtn = document.createElement('button');
    copyBtn.className = 'axi-copy-btn';
    copyBtn.innerHTML = COPY_SVG;
    copyBtn.title = 'Copy';
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.innerHTML = CHECK_SVG;
        copyBtn.classList.add('copied');
        setTimeout(() => { copyBtn.innerHTML = COPY_SVG; copyBtn.classList.remove('copied'); }, 2000);
      } catch { /* clipboard not available */ }
    });
    actions.appendChild(copyBtn);

    // Speaker button (Text-to-Speech)
    if ('speechSynthesis' in window) {
      const speakBtn = document.createElement('button');
      speakBtn.className = 'axi-speak-btn';
      speakBtn.innerHTML = SPEAKER_SVG;
      speakBtn.title = 'Listen';
      let speaking = false;
      speakBtn.addEventListener('click', () => {
        if (speaking) {
          speechSynthesis.cancel();
          speakBtn.innerHTML = SPEAKER_SVG;
          speakBtn.classList.remove('speaking');
          speaking = false;
          return;
        }
        const utter = new SpeechSynthesisUtterance(text);
        utter.rate = 0.85; // AXI does not rush
        utter.pitch = 0.95;
        // Prefer measured English voice
        const voices = speechSynthesis.getVoices();
        const preferred = voices.find(v => /UK|British|Daniel/i.test(v.name) && v.lang.startsWith('en'));
        if (preferred) utter.voice = preferred;
        utter.onstart = () => { speakBtn.innerHTML = STOP_SVG; speakBtn.classList.add('speaking'); speaking = true; };
        utter.onend = () => { speakBtn.innerHTML = SPEAKER_SVG; speakBtn.classList.remove('speaking'); speaking = false; };
        utter.onerror = () => { speakBtn.innerHTML = SPEAKER_SVG; speakBtn.classList.remove('speaking'); speaking = false; };
        speechSynthesis.speak(utter);
      });
      actions.appendChild(speakBtn);
    }

    frame.appendChild(actions);
  }

  // Legacy compatibility wrapper
  function addCopyButton(frame: HTMLElement, text: string) {
    addResponseActions(frame, text);
  }

  // ══════════════════════════════════════════════════════════════
  // ── KINTSUGI THREAD — A/L/M river lines beneath response ──
  // ══════════════════════════════════════════════════════════════
  function addKintsugiThread(frame: HTMLElement, A: number, L: number, M: number) {
    const thread = document.createElement('div');
    thread.className = 'kintsugi-thread';

    const dims = [
      { label: 'agency', value: A, cls: 'kintsugi-bar-a' },
      { label: 'legibility', value: L, cls: 'kintsugi-bar-l' },
      { label: 'standing', value: M, cls: 'kintsugi-bar-m' },
    ];

    // Find the dimension with lowest value — that's where the crack is, where gold goes
    const minVal = Math.min(A, L, M);

    dims.forEach(dim => {
      const line = document.createElement('div');
      line.className = 'kintsugi-line';

      const label = document.createElement('span');
      label.className = 'kintsugi-label';
      label.textContent = dim.label;
      line.appendChild(label);

      const bar = document.createElement('div');
      bar.className = `kintsugi-bar ${dim.cls}`;
      // Gold glow on the dimension closest to the edge (lowest value = most stress = most gold)
      if (dim.value === minVal && dim.value < 1.0) bar.classList.add('glow');
      line.appendChild(bar);

      thread.appendChild(line);

      // Animate width after insertion
      requestAnimationFrame(() => {
        bar.style.width = `${Math.round(dim.value * 100)}%`;
      });
    });

    frame.appendChild(thread);
  }

  // ══════════════════════════════════════════════════════════════
