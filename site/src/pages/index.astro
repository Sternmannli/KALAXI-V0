<script is:inline>
// === DEDICATION — proverb ===
(function(){
  var ded = document.getElementById('dedication');
  if (!ded) return;

  if (sessionStorage.getItem('ded-seen')) {
    ded.remove();
    return;
  }

  function dismiss() {
    sessionStorage.setItem('ded-seen', '1');
    ded.style.opacity = '0';
    setTimeout(function(){ ded.remove(); }, 2000);
  }

  // Auto-dismiss after the proverb has been read
  setTimeout(dismiss, 5000);

  // Or dismiss on click/key
  ded.addEventListener('click', dismiss);
  document.addEventListener('keydown', function handler(){
    document.removeEventListener('keydown', handler);
    if (ded.parentNode) dismiss();
  }, {once: true});
})();

// === FIVE PILLARS ===
(function(){
  var pillars = {
    dignity: {
      title: 'Dignity', emoji: '\u2764\uFE0F', color: 'var(--color-dignity)',
