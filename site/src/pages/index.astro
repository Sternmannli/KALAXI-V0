    },
    pattern: {
      title: 'Pattern', emoji: '\uD83D\uDD37', color: 'var(--color-pattern)',
      definition: 'The system stores and processes patterns \u2014 structural shapes of thought, recurring themes, cross-cultural convergences \u2014 never personal information. Identity dissolves on entry. The pattern remains and feeds collective understanding.',
      equation: 'input \u2192 anonymize() \u2192 extract_pattern() \u2192 canon',
      reason: 'Why not data: Data implies ownership and surveillance. Patterns imply shared structure. The distinction is architectural, not rhetorical.'
    },
    wisdom: {
      title: 'Wisdom', emoji: '\uD83C\uDF3F', color: 'var(--color-wisdom)',
      definition: 'What emerges when patterns are processed over time. The system accumulates 3,333+ proverbs, 1,100 anomalies, 87 wisdom nodes, and 59 treasures \u2014 all cross-referenced, all traceable. Wisdom is the output of patient processing, not instant analysis.',
      equation: 'W = T \u00D7 S \u00D7 C (Time \u00D7 Saturation \u00D7 Coherence)',
      reason: 'Why time matters: Instant answers optimise for speed. Wisdom requires accumulation. The system is designed for depth, not velocity.'
    },
    witness: {
      title: 'Witness', emoji: '\uD83D\uDC41\uFE0F', color: 'var(--color-witness)',
      definition: 'The system does not judge, score, or rank contributions. It witnesses \u2014 receives input, registers it immutably, and confirms receipt. The witness function is the ethical foundation of all system interaction.',
      equation: 'input \u2192 register(hash, timestamp) \u2192 confirm(receipt)',
      reason: 'Why witness, not evaluate: Evaluation implies hierarchy. Witnessing implies presence. The system serves the person, not the other way around.'
    }
  };

  var panel = document.getElementById('pillar-panel');
  var content = document.getElementById('pillar-content');
  var closeBtn = panel ? panel.querySelector('.pillar-close') : null;
  var buttons = document.querySelectorAll('.pillar');
  var currentPillar = null;

  function openPillar(name) {
    var p = pillars[name];
    if (!p || !panel || !content) return;
    buttons.forEach(function(b){ b.setAttribute('aria-expanded', 'false'); });
    var btn = document.querySelector('[data-pillar="' + name + '"]');
    if (btn) btn.setAttribute('aria-expanded', 'true');
    panel.style.borderLeftColor = p.color;
    content.innerHTML =
      '<h3 style="color:' + p.color + '"><span class="pillar-emoji">' + p.emoji + '</span> ' + p.title + '</h3>' +
      '<p class="pillar-def">' + p.definition + '</p>' +
      '<p class="pillar-eq">' + p.equation + '</p>' +
      '<p class="pillar-reason">' + p.reason + '</p>';
    panel.hidden = false;
    currentPillar = name;
  }

  function closePillar() {
    if (panel) panel.hidden = true;
    buttons.forEach(function(b){ b.setAttribute('aria-expanded', 'false'); });
    currentPillar = null;
  }

  buttons.forEach(function(btn){
    btn.addEventListener('click', function(){
      var name = btn.getAttribute('data-pillar');
      if (currentPillar === name) { closePillar(); } else { openPillar(name); }
    });
  });
  if (closeBtn) closeBtn.addEventListener('click', closePillar);
})();

