---
import Base from '../layouts/Base.astro';
---

<Base title="kalam.ch" description="Stories, code, and a voice that self-corrects.">

  <main class="app" id="main-content">

    <!-- Messages area -->
    <div class="messages" id="messages">
      <div class="bubble axi">Hi. Say what's on your mind.</div>
    </div>

    <!-- Input bar — fixed at bottom like a real app -->
    <form class="input-bar" id="chat-form">
      <input type="text" id="chat-input" placeholder="say something..." maxlength="2000" autocomplete="off" enterkeyhint="send" />
      <button type="submit" id="chat-send" aria-label="Send">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
    </form>

    <!-- Reading paths — above input bar -->
    <nav class="paths" aria-label="Reading paths">
      <a href="/hakaka">hakaka</a>
      <a href="/ashwater">ashwater</a>
      <a href="/kinderbuch">kinderbuch</a>
      <a href="/kalaxi1">the same river</a>
      <a href="/about-axi">axi</a>
      <a href="/sustain">sustain</a>
    </nav>

  </main>

</Base>

<style>
  .app {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 50px);
    height: calc(100dvh - 50px);
    max-width: 600px;
    margin: 0 auto;
    padding: 0;
    overflow: hidden;
  }

  /* Messages area — scrollable, takes remaining space */
  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    -webkit-overflow-scrolling: touch;
  }

  /* Chat bubbles */
  .bubble {
    max-width: 80%;
    padding: 0.6rem 1rem;
    border-radius: 18px;
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.95rem;
    line-height: 1.5;
    word-wrap: break-word;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .bubble.user {
    align-self: flex-end;
    background: #1a1a1a;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .bubble.axi {
    align-self: flex-start;
    background: #f0f0f0;
    color: #1a1a1a;
    border-bottom-left-radius: 4px;
  }

  .bubble.loading {
    align-self: flex-start;
    background: #f0f0f0;
    color: #999;
    font-style: italic;
  }

  /* Reading paths */
  .paths {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0.6rem 1rem;
    border-top: 1px solid #eee;
    background: #fff;
  }

  .paths a {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.75rem;
    color: #999;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: lowercase;
  }
  .paths a:hover { color: #1a1a1a; }

  /* Input bar — fixed at bottom */
  .input-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    border-top: 1px solid #eee;
    background: #fff;
    flex-shrink: 0;
  }

  #chat-input {
    flex: 1;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    padding: 0.6rem 1rem;
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 1rem;
    outline: none;
    background: #fafafa;
    -webkit-appearance: none;
  }
  #chat-input:focus {
    border-color: #999;
    background: #fff;
  }

  #chat-send {
    width: 40px;
    height: 40px;
    border: none;
    background: #1a1a1a;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  #chat-send:hover { background: #333; }
  #chat-send:disabled { background: #ccc; cursor: default; }

  /* Mobile: make it truly full-screen app-like */
  @media (max-width: 600px) {
    .app {
      height: calc(100vh - 44px);
      height: calc(100dvh - 44px);
    }
    .bubble { font-size: 0.9rem; }
    #chat-input { font-size: 16px; /* prevents iOS zoom */ }
  }
</style>

<script>
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const messages = document.getElementById('messages');
  const btn = document.getElementById('chat-send') as HTMLButtonElement;

  function addBubble(text: string, who: 'user' | 'axi' | 'loading'): HTMLElement {
    const el = document.createElement('div');
    el.className = 'bubble ' + who;
    el.textContent = text;
    messages?.appendChild(el);
    messages!.scrollTop = messages!.scrollHeight;
    return el;
  }

  function escapeAndSet(el: HTMLElement, text: string) {
    el.textContent = text;
  }

  if (form && input && messages) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      addBubble(text, 'user');
      input.value = '';
      btn.disabled = true;

      const loading = addBubble('...', 'loading');

      try {
        const res = await fetch('/api/axi.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: text }),
        });
        const data = await res.json();
        loading.remove();
        addBubble(data.reflection || data.mark || 'No response.', 'axi');
      } catch (err) {
        loading.remove();
        addBubble('Could not connect.', 'axi');
      }

      btn.disabled = false;
      input.focus();
    });
  }
</script>
