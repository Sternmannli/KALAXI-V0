<script is:inline>
// === DEDICATION — proverb with hold-to-enter ===
(function(){
  var ded = document.getElementById('dedication');
  if (!ded) return;

  var isReturn = localStorage.getItem('kalam-visited');
  if (sessionStorage.getItem('ded-seen')) {
    ded.remove();
    return;
  }

  function dismiss() {
    sessionStorage.setItem('ded-seen', '1');
    localStorage.setItem('kalam-visited', '1');
    ded.classList.add('dismissed');
    ded.style.opacity = '0';
    document.removeEventListener('keydown', dedKeyDown);
    document.removeEventListener('keyup', dedKeyUp);
    setTimeout(function(){ ded.remove(); }, 2000);
  }

  // Return visitors: fast auto-dismiss (1.5s)
  if (isReturn) {
    setTimeout(dismiss, 1500);
    ded.addEventListener('click', dismiss);
    return;
  }

  // First visit: hold-to-enter (2 seconds) with progress ring
  var ringFill = ded.querySelector('.ded-ring-fill');
  var holdZone = document.getElementById('ded-hold');
  var HOLD_MS = 2000;
  var CIRCUMFERENCE = 100.53; // 2 * PI * 16
  var holdStart = 0;
  var holdTimer = null;
  var autoTimer = null;

  function startHold() {
    holdStart = Date.now();
    holdTimer = setInterval(function() {
      var elapsed = Date.now() - holdStart;
      var progress = Math.min(elapsed / HOLD_MS, 1);
      if (ringFill) ringFill.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - progress));
      if (progress >= 1) {
        clearInterval(holdTimer);
        if (navigator.vibrate) navigator.vibrate(10);
        dismiss();
      }
    }, 16);
  }

  function stopHold() {
    if (holdTimer) clearInterval(holdTimer);
    holdStart = 0;
    if (ringFill) ringFill.style.strokeDashoffset = String(CIRCUMFERENCE);
  }

  // Mouse/touch events on the whole overlay
  ded.addEventListener('mousedown', startHold);
  ded.addEventListener('mouseup', stopHold);
  ded.addEventListener('mouseleave', stopHold);
  ded.addEventListener('touchstart', function(e) { e.preventDefault(); startHold(); }, {passive: false});
  ded.addEventListener('touchend', stopHold);
  ded.addEventListener('touchcancel', stopHold);

  // Keyboard: hold Enter or Space (removed after dismiss so textarea works)
  function dedKeyDown(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (!holdStart) startHold();
    }
  }
  function dedKeyUp(e) {
    if (e.key === 'Enter' || e.key === ' ') stopHold();
  }
  document.addEventListener('keydown', dedKeyDown);
  document.addEventListener('keyup', dedKeyUp);

  // Accessibility fallback: auto-dismiss after 8 seconds if no interaction
  autoTimer = setTimeout(dismiss, 8000);
})();

// === FIVE PILLARS ===
(function(){
  var pillars = {
    dignity: {
      title: 'Dignity', emoji: '\u2764\uFE0F', color: 'var(--color-dignity)',
      definition: 'The non-negotiable first requirement of the system. Every computation, every output, every state transition is evaluated against the Dignity Predicate before execution. If dignity is violated, the system stops.',
      equation: 'D = A \u00D7 L \u00D7 M',
      reason: 'Why first: A system that processes human input without evaluating dignity is a system that can cause harm at scale. Dignity is not a feature \u2014 it is a constraint.'
    },
    presence: {
      title: 'Presence', emoji: '\uD83D\uDCA0', color: 'var(--color-presence)',
      definition: 'The system is either fully present to the interaction or it discloses its absence. No simulated attention. No faked engagement. The Presence Axiom requires the system to be transparent about its state at all times.',
      equation: 'P \u2265 threshold \u2228 disclose(absence)',
      reason: 'Why it matters: People detect false presence. A system that pretends to listen when it cannot erodes trust faster than one that says nothing.'
    },
    pattern: {
      title: 'Pattern', emoji: '\uD83D\uDD37', color: 'var(--color-pattern)',
      definition: 'The system stores and processes patterns \u2014 structural shapes of thought, recurring themes, cross-cultural convergences \u2014 never personal information. Identity dissolves on entry. The pattern remains and feeds collective understanding.',
      equation: 'input \u2192 anonymize() \u2192 extract_pattern() \u2192 canon',
      reason: 'Why not data: Data implies ownership and surveillance. Patterns imply shared structure. The distinction is architectural, not rhetorical.'
    },
    wisdom: {
      title: 'Wisdom', emoji: '\uD83C\uDF3F', color: 'var(--color-wisdom)',
      definition: 'What emerges when patterns are processed over time. The system accumulates 3,333+ proverbs, 1,100 anomalies, 87 wisdom nodes, and 59 treasures \u2014 all cross-referenced, all traceable. Wisdom is the output of patient processing, not instant analysis.',
      equation: 'W = T \u00D7 S \u00D7 C (Time \u00D7 Saturation \u00D7 Coherence)',
      reason: 'Why time matters: Instant answers optimise for speed. Wisdom requires accumulation. The system is designed for depth, not velocity.'
    },
    witness: {
      title: 'Witness', emoji: '\uD83D\uDC41\uFE0F', color: 'var(--color-witness)',
      definition: 'The system does not judge, score, or rank contributions. It witnesses \u2014 receives input, registers it immutably, and confirms receipt. The witness function is the ethical foundation of all system interaction.',
      equation: 'input \u2192 register(hash, timestamp) \u2192 confirm(receipt)',
      reason: 'Why witness, not evaluate: Evaluation implies hierarchy. Witnessing implies presence. The system serves the person, not the other way around.'
    }
  };

  var panel = document.getElementById('pillar-panel');
  var content = document.getElementById('pillar-content');
  var closeBtn = panel ? panel.querySelector('.pillar-close') : null;
  var buttons = document.querySelectorAll('.pillar');
  var currentPillar = null;

  function openPillar(name) {
    var p = pillars[name];
    if (!p || !panel || !content) return;
    buttons.forEach(function(b){ b.setAttribute('aria-expanded', 'false'); });
    var btn = document.querySelector('[data-pillar="' + name + '"]');
    if (btn) btn.setAttribute('aria-expanded', 'true');
    panel.style.borderLeftColor = p.color;
    content.innerHTML =
      '<h3 style="color:' + p.color + '"><span class="pillar-emoji">' + p.emoji + '</span> ' + p.title + '</h3>' +
      '<p class="pillar-def">' + p.definition + '</p>' +
      '<p class="pillar-eq">' + p.equation + '</p>' +
      '<p class="pillar-reason">' + p.reason + '</p>';
    panel.hidden = false;
    currentPillar = name;
  }

  function closePillar() {
    if (panel) panel.hidden = true;
    buttons.forEach(function(b){ b.setAttribute('aria-expanded', 'false'); });
    currentPillar = null;
  }

  buttons.forEach(function(btn){
    btn.addEventListener('click', function(){
      var name = btn.getAttribute('data-pillar');
      if (currentPillar === name) { closePillar(); } else { openPillar(name); }
    });
  });
  if (closeBtn) closeBtn.addEventListener('click', closePillar);
})();

// === EQUATION TOGGLE ===
(function(){
  var btn = document.getElementById('equation-toggle');
  var detail = document.getElementById('equation-detail');
  if (!btn || !detail) return;
  btn.addEventListener('click', function(){
