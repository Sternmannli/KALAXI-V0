Chronological builder (drop-in script)

If you want automation locally, save as book199_build.py and run with Python 3.
It scans /mnt/data, guesses doc_date, builds Book-199.md + a JSON index, sorted by date.

# book199_build.py -- build Book-199 from folder contents (Europe/Zurich)
from pathlib import Path
from datetime import datetime, timezone
import re, json, os

ROOT = Path("/mnt/data")            # adjust if needed
OUT  = ROOT / "BOOK199_OUTPUT"
OUT.mkdir(exist_ok=True)

def guess_doc_date(name: str):
    # YYYY-MM-DD or YYYYMMDD or v_2025-08-17 in filenames
    m = re.search(r'(20\d{2})[-_]?(\d{2})[-_]?(\d{2})', name)
    if m:
        y,mn,d = m.groups()
        return f"{y}-{mn}-{d}"
    return None

def meta_for(p: Path):
    stat = p.stat()
    mtime = datetime.fromtimestamp(stat.st_mtime).astimezone()
    doc_date = guess_doc_date(p.name)
    if not doc_date:
        doc_date = mtime.date().isoformat()
    entry = {
        "id": f"B199-{abs(hash(p.name))%10**9:09d}",
        "title": p.stem.replace("_"," ").replace("-"," ").strip(),
        "doc_date": doc_date,
        "ingest_ts": datetime.now().astimezone().isoformat(),
        "path": str(p),
        "type": infer_type(p.suffix.lower()),
        "red_threads": [],
        "links": [],
        "proverb_refs": [],
        "notes": ""
    }
    return entry

def infer_type(ext):
    if ext in [".png",".jpg",".jpeg",".gif",".svg"]: return ["image","diagram"]
    if ext in [".pdf"]: return ["pdf","diagram"]
    if ext in [".doc",".docx"]: return ["doc","canon"]     # refine later
    if ext in [".json",".yaml",".yml",".csv",".xlsx"]: return ["data","engine"]
    if ext in [".txt",".md"]: return ["text","notes"]
    return ["blob"]

def gather():
    files = []
    for p in ROOT.iterdir():
        if p.is_file() and not p.name.startswith("."):
            files.append(meta_for(p))
    files.sort(key=lambda x: (x["doc_date"], x["title"]))
    return files

def render_md(items):
    lines = ["# Book-199 -- Chronology\n"]
    for it in items:
        lines.append(f"## {it['doc_date']} -- {it['title']}")
        lines.append(f"- id: {it['id']}")
        lines.append(f"- path: `{it['path']}`")
        lines.append(f"- type: {', '.join(it['type'])}")
        if it["links"]: lines.append(f"- links: {', '.join(it['links'])}")
        if it["proverb_refs"]: lines.append(f"- proverbs: {', '.join(it['proverb_refs'])}")
        if it["notes"]: lines.append(f"- notes: {it['notes']}")
        lines.append("")
    return "\n".join(lines)

if __name__ == "__main__":
    items = gather()
    (OUT/"Book-199.index.json").write_text(json.dumps(items, indent=2), encoding="utf-8")
    (OUT/"Book-199.md").write_text(render_md(items), encoding="utf-8")
    print(f"Wrote {len(items)} items to {OUT}/Book-199.*")

What it does now (deterministic):
	•	pulls every file we’ve seen you drop into /mnt/data/…
	•	derives a doc_date (filename first, else file mtime)
	•	builds BOOK199_OUTPUT/Book-199.index.json + Book-199.md sorted by date
	•	leaves space to enrich red_threads, links, proverb_refs later (we can batch-fill from your Canon keywords)

