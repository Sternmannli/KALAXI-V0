    "rcf_v1_bundle": {
      "explain": "Resonant Consensus Framework -- treat anomalies as generative thresholds; avoid runaway via saturation; test in baseline/adversarial/red-zone sims.",
      "core_code_python": {
        "RCFParams.py": "from dataclasses import dataclass\n@dataclass\nclass RCFParams:\n    w1: float = 0.5\n    w2: float = 0.5\n    eps: float = 1e-6\n    theta: float = 0.8\n    A_threshold: float = 0.75\n    k1: float = 1.0\n    k2: float = 0.2\n    dt: float = 1.0\n    noise_std: float = 0.02\n    alpha: float = 1.0\n",
        "model.py": "import numpy as np\nfrom .RCFParams import RCFParams\n\ndef compute_A_raw(E,D,mu,tau,psi=0.0,p:RCFParams=RCFParams()):\n    clamp=lambda x:max(0.0,min(1.0,float(x)))\n    E,D,mu,tau,psi=map(clamp,(E,D,mu,tau,psi))\n    base=((p.w1*E+p.w2*D)/(p.eps+mu))*tau\n    if psi>0.0: base*= (1.0+psi)**p.alpha\n    return base\n\ndef saturate(A_raw,p:RCFParams=RCFParams()):\n    return np.tanh(float(A_raw)/max(p.eps,p.theta))\n\ndef step_dynamic(A_prev,E,D,mu,tau,psi=0.0,p:RCFParams=RCFParams(),rng=None):\n    import numpy as np\n    rng = rng or np.random.default_rng()\n    A_raw = compute_A_raw(E,D,mu,tau,psi,p)\n    A_sat = saturate(A_raw,p)\n    noise = rng.normal(0.0,p.noise_std)\n    A = A_prev + p.dt*(p.k1*A_sat - p.k2*A_prev) + noise\n    A = float(np.clip(A,-1.0,1.0))\n    bridged = (A >= p.A_threshold)\n    return A, A_raw, bridged\n",
        "sim.py": "import numpy as np, pandas as pd\nfrom .model import step_dynamic\nfrom .RCFParams import RCFParams\n\ndef simulate_series(T=300,seed=42,regime='baseline',p:RCFParams=RCFParams()):\n    rng=np.random.default_rng(seed)\n    E=np.clip(rng.normal(0.6,0.15,T),0,1); D=np.clip(rng.normal(0.5,0.2,T),0,1)\n    mu=np.clip(rng.normal(0.3,0.15,T),0,1); tau=np.clip(rng.normal(0.6,0.1,T),0,1)\n    psi=np.clip(rng.normal(0.2,0.15,T),0,1)\n    if regime=='stress': mu=np.clip(mu+0.3,0,1); tau=np.clip(tau-0.2,0,1)\n    elif regime=='drive': psi=np.clip(psi+0.4,0,1)\n    A_hist=[]; Araw_hist=[]; bridge=[]; A=0.0\n    for t in range(T):\n        A,A_raw,b=step_dynamic(A,E[t],D[t],mu[t],tau[t],psi[t],p,rng)\n        A_hist.append(A); Araw_hist.append(A_raw); bridge.append(1 if b else 0)\n    return pd.DataFrame({'t':range(T),'E':E,'D':D,'mu':mu,'tau':tau,'psi':psi,'A_raw':Araw_hist,'A':A_hist,'bridge':bridge})\n"
      },
