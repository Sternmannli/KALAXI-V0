// weakest_voice.js
export class WeakestVoice {
  score(participant, context) {
    const v = {
      historyGap: this.participationGap(participant),         // less voice before → higher gap
      resourceGap: this.resourceDisparity(participant),        // fewer means → higher gap
      networkIsolation: this.isolation(participant),           // fewer edges → higher gap
      topicStake: this.stake(participant, context)             // high stake in THIS topic
    };
    // weights sum to 1; no single vector > 0.4 to prevent gaming
    const w = {historyGap:0.3, resourceGap:0.3, networkIsolation:0.2, topicStake:0.2};
    return Object.entries(v).reduce((s,[k,val])=>s + w[k]*this.norm(val), 0);
  }
  detectManipulation(claims){
    // flag sudden waves of "weakness" clustered in time or graph
    return this.clustered(claims) || this.benefitSkew(claims);
  }
}
