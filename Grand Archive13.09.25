python axi_ledger_governor.py

#!/usr/bin/env python3
# AXI•LEDGER -- MASTER GOVERNOR (v1.0)
# Parses DNA, validates covenants, binds orphans, builds books, emits manifest + digest + open tasks.

from __future__ import annotations
import re, json, hashlib, os
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Tuple, Any

ROOT = Path(__file__).parent
OUT = ROOT / "LEDGER_OUTPUTS"
OUT.mkdir(exist_ok=True)

# ---------- utils ----------
def iso_now() -> str:
    return datetime.utcnow().isoformat(timespec="seconds") + "Z"

def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1<<16), b""):
            h.update(chunk)
    return h.hexdigest()

def wtxt(p: Path, s: str) -> None:
    p.write_text(s.replace("\r\n","\n"), encoding="utf-8")

def nint(s: str) -> int:
    return int(s.lstrip("0") or "0")

# ---------- patterns (tolerant) ----------
SECTION_RE = re.compile(
    r"^SEC(\d{3,5})\s*:\s*MATH=E(\d+);\s*WORD=W(\d+);\s*PROVERB=P#0*(\d+);\s*ANOM=ANOM#0*(\d+)\s*$",
    re.IGNORECASE,
)
PROV_ARROW = re.compile(r"^P#0*(\d+)\s*→\s*(.+)$")
PROV_COLON = re.compile(r"^P#0*(\d+)\s*:\s*(.+)$")
ANOM_ARROW = re.compile(r"^ANOM#0*(\d+)\s*→\s*(.+)$")
ANOM_COLON = re.compile(r"^ANOM#0*(\d+)\s*:\s*(.+)$")
COV_ANY    = re.compile(r"^COV#0*(\d+)\s*[:→]\s*(.+)$")

HEADERS = {
    "SECTIONS": re.compile(r"^\s*(?:\[SECTIONS\]|SECTIONS:?)\s*$", re.I),
    "PROVERBS": re.compile(r"^\s*(?:\[PROVERBS\]|PROVERBS:?)\s*$", re.I),
    "ANOMALIES": re.compile(r"^\s*(?:\[ANOMALIES\]|ANOMALIES:?|ANOMALIES LOG)\s*$", re.I),
    "COVENANTS": re.compile(r"^\s*(?:\[COVENANTS\]|COVENANTS(?:\s*&\s*OATH)?\:?)\s*$", re.I),
    "OATH": re.compile(r"^\s*OATH\s*:?\s*$", re.I),
}

def split_blocks(text: str) -> Dict[str, List[str]]:
    blocks = {k: [] for k in HEADERS.keys()}
    current = None
    for raw in text.splitlines():
        line = raw.rstrip()
        if any(pat.match(line.strip()) for pat in HEADERS.values()):
            for key, pat in HEADERS.items():
                if pat.match(line.strip()):
                    current = key
                    break
            continue
        if not current:
            # heuristic routing without explicit headers
            s = line.strip()
            if SECTION_RE.match(s): blocks["SECTIONS"].append(s)
            elif s.upper().startswith("BOOK OF PROVERBS") or PROV_ARROW.match(s) or PROV_COLON.match(s):
                blocks["PROVERBS"].append(s)
            elif s.upper().startswith("ANOMALIES LOG") or ANOM_ARROW.match(s) or ANOM_COLON.match(s):
                blocks["ANOMALIES"].append(s)
            elif s.upper().startswith("COVENANTS"):
                blocks["COVENANTS"].append(s)
            elif s.upper().startswith("OATH"):
                current = "OATH"
            continue
        blocks[current].append(line.strip("\n"))
    return blocks

def parse_sections(lines: List[str]) -> List[Dict[str,Any]]:
    out = []
    for ln in lines:
        m = SECTION_RE.match(ln.strip())
        if m:
            sec,e,w,p,a = m.groups()
            out.append({
                "sec": nint(sec),
                "math": f"E{int(e)}",
                "word": f"W{int(w)}",
                "proverb": f"P#{int(p):03d}",
                "anomaly": f"ANOM#{int(a):03d}",
            })
    return out

def parse_proverbs(lines: List[str]) -> Dict[str,str]:
    out = {}
    for ln in lines:
        if not ln or ln.upper().startswith("BOOK OF PROVERBS"): continue
        m = PROV_ARROW.match(ln) or PROV_COLON.match(ln)
        if m:
            idx, txt = m.groups()
            out[f"P#{nint(idx):03d}"] = txt.strip()
    return out

def parse_anomalies(lines: List[str]) -> Dict[str,str]:
    out = {}
    for ln in lines:
        if not ln or ln.upper().startswith("ANOMALIES LOG"): continue
        m = ANOM_ARROW.match(ln) or ANOM_COLON.match(ln)
        if m:
            idx, txt = m.groups()
            out[f"ANOM#{nint(idx):03d}"] = txt.strip()
    return out

def parse_covenants(lines: List[str]) -> Dict[str,str]:
    out = {}
    for ln in lines:
        m = COV_ANY.match(ln)
        if m:
            idx, txt = m.groups()
            out[f"COV#{nint(idx):03d}"] = txt.strip()
    return out

def parse_oath(lines: List[str]) -> str:
    if not lines: return ""
    body = []
    for ln in lines:
        if ln.upper().startswith("OATH"):
            ln = ln.split(":",1)[1].strip() if ":" in ln else ""
        body.append(ln)
    return "\n".join(body).strip()

def parse_text(text: str) -> Dict[str,Any]:
    b = split_blocks(text)
    return {
        "sections":  parse_sections(b["SECTIONS"]),
        "proverbs":  parse_proverbs(b["PROVERBS"]),
        "anomalies": parse_anomalies(b["ANOMALIES"]),
        "covenants": parse_covenants(b["COVENANTS"]),
        "oath":      parse_oath(b["OATH"]),
    }

def load_all() -> Dict[str,Any]:
    agg = {"sections": [], "proverbs": {}, "anomalies": {}, "covenants": {}, "oath": ""}
    seen = set()
    # Prefer DNA_*.led but accept *.led/*.txt/*.md containing our markers
    candidates = list(ROOT.glob("DNA_*.led")) + list(ROOT.glob("*.led")) + list(ROOT.glob("*.txt")) + list(ROOT.glob("*.md"))
    for p in sorted(set(candidates)):
        try:
            txt = p.read_text(encoding="utf-8")
        except Exception:
            continue
        if not any(k in txt.upper() for k in ("SEC", "PROVERB", "ANOM", "COV", "OATH")):
            continue
        d = parse_text(txt)
        for s in d["sections"]:
            key = (s["sec"], s["math"], s["word"], s["proverb"], s["anomaly"])
            if key in seen: continue
            seen.add(key)
            agg["sections"].append(s)
        agg["proverbs"].update(d["proverbs"])
        agg["anomalies"].update(d["anomalies"])
        agg["covenants"].update(d["covenants"])
        if d["oath"]: agg["oath"] = d["oath"]
    agg["sections"].sort(key=lambda x: x["sec"])
    return agg

# ---------- covenant helpers ----------
def bind_anoms_to_provs(anoms: Dict[str,str], provs: Dict[str,str]) -> Dict[str, List[str]]:
    """COV#006 default: ANOM#k → P#k if available; else nearest lower P#."""
    bindings: Dict[str,List[str]] = {}
    prov_ids = sorted(int(k.split("#")[1]) for k in provs)
    for ak in sorted(anoms, key=lambda s:int(s.split("#")[1])):
        aid = int(ak.split("#")[1])
        target = aid if f"P#{aid:03d}" in provs else max([p for p in prov_ids if p <= aid] or [prov_ids[0]])
        bindings[ak] = [f"P#{target:03d}"]
    return bindings

def orphans(sections, anoms, provs) -> Tuple[List[str], List[str]]:
    used_a = {s["anomaly"] for s in sections}
    used_p = {s["proverb"] for s in sections}
    a_orph = [k for k in sorted(anoms) if k not in used_a]
    p_orph = [k for k in sorted(provs) if k not in used_p]
    return a_orph, p_orph

def gaps(nums: List[int]) -> List[Tuple[int,int]]:
    out = []
    if not nums: return out
    nums = sorted(set(nums))
    for a,b in zip(nums, nums[1:]):
        if b - a > 1: out.append((a+1, b-1))
    return out

# ---------- builders ----------
def build_master(agg) -> Path:
    lines = ["LEDGER MASTER -- Hydrated from DNA",""]
    for s in agg["sections"]:
        lines += [
            f"Section {s['sec']}",
            f"Math: {s['math']} -- ψ/σ or Ω example",
            f"Word: {s['word']} -- Narrative wisdom placeholder",
            f"Proverb: {s['proverb']} -- {agg['proverbs'].get(s['proverb'],'')}",
            f"Anomaly: {s['anomaly']} -- {agg['anomalies'].get(s['anomaly'],'')}",
            "----",
        ]
    p = OUT / "Master.txt"; wtxt(p, "\n".join(lines)); return p

def build_listing(title: str, tag: str, items: Dict[str,str]) -> Path:
    lines = [title,""]
    for k in sorted(items, key=lambda x:int(x.split('#')[1])):
        lines.append(f"{k}: {items[k]}")
    name = {"BOOK OF PROVERBS":"Proverbs.txt","ANOMALIES LOG":"Anomalies.txt","COVENANTS & OATH":"Covenants.txt"}[title]
    p = OUT / name; wtxt(p, "\n".join(lines)); return p

def build_open_tasks(agg, bindings) -> Path:
    a_orph, p_orph = orphans(agg["sections"], agg["anomalies"], agg["proverbs"])
    sec_ids = [s["sec"] for s in agg["sections"]]
    prov_ids = [int(k.split("#")[1]) for k in agg["proverbs"]]
    anom_ids = [int(k.split("#")[1]) for k in agg["anomalies"]]
    lines = [
        "# OPEN_TASKS",
        "",
        "## Orphans",
        f"- Anomalies not used by any Section: {', '.join(a_orph) if a_orph else 'none'}",
        f"- Proverbs not used by any Section: {', '.join(p_orph) if p_orph else 'none'}",
        "",
        "## Numbering gaps",
        f"- Sections gaps: {gaps(sec_ids) or 'none'}",
        f"- Proverbs gaps: {gaps(prov_ids) or 'none'}",
        f"- Anomalies gaps: {gaps(anom_ids) or 'none'}",
        "",
        "## COV#006 bindings (preview)",
    ]
    preview = []
    for ak in sorted(bindings, key=lambda s:int(s.split("#")[1]))[:10]:
        preview.append(f"- {ak} → {', '.join(bindings[ak])}")
    lines += (preview or ["- (none)"])
    p = OUT / "OPEN_TASKS.md"; wtxt(p, "\n".join(lines)); return p

def build_digest(paths: List[Path]) -> Path:
    lines = ["# DIGEST (sha256)",""]
    for p in paths:
        lines.append(f"{sha256(p)}  {p.name}")
    out = OUT / "DIGEST.sha256"; wtxt(out, "\n".join(lines)); return out

# ---------- main ----------
def main():
    agg = load_all()
    bindings = bind_anoms_to_provs(agg["anomalies"], agg["proverbs"])

    master = build_master(agg)
    provs  = build_listing("BOOK OF PROVERBS","P#", agg["proverbs"])
    anoms  = build_listing("ANOMALIES LOG","ANOM#", agg["anomalies"])
    covs   = build_listing("COVENANTS & OATH","COV#", agg["covenants"])
    tasks  = build_open_tasks(agg, bindings)
    digest = build_digest([master, provs, anoms, covs, tasks])

    manifest = {
        "timestamp": iso_now(),
        "dna_files": [p.name for p in ROOT.glob("DNA_*.led")],
        "outputs": {
            "Master": str(master),
            "Proverbs": str(provs),
            "Anomalies": str(anoms),
            "Covenants": str(covs),
            "OpenTasks": str(tasks),
            "Digest": str(digest),
        },
        "counts": {
