// conductor.js
export class Conductor {
  async executeRitual() {
    const cp = await this.checkpoint();
    try {
      const ack = await this.ACK();
      const unified = await this.UNIFY(ack);
      await this.validateState(unified);               // NEW
      const applied = await this.APPLY(unified);
      if (!await this.validateApply(applied)) throw new Error("APPLY validation failed");
      const stamped = await this.STAMP(applied);
      await this.REEMIT(stamped);
      await this.commit(cp);
      return stamped;
    } catch (e) {
      await this.rollback(cp);
      throw e;
    }
  }
}
