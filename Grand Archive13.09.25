// privacy_floor.js
export function adaptivePrivacy({n, kMin=7, epsMax=1.0}) {
  const effectiveK = Math.max(3, Math.floor(n/3));
  const effectiveEps = Math.min(epsMax, 2.0*(n/50));
  const mode = n < 15 ? "group_aggregate" : "noisy_release";
  return {effectiveK, effectiveEps, mode};
}
