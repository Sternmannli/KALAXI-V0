#!/usr/bin/env python3
# axi_ledger_governor.py
# AXI•LEDGER -- MASTER GOVERNOR (v1.0)
# Single script to parse DNA, validate covenants, build books, and emit a manifest + digest + open tasks.

from __future__ import annotations
import re, json, hashlib, os, sys
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Tuple, Any, Optional

ROOT = Path(__file__).parent
OUT_DIR = ROOT / "LEDGER_OUTPUTS"
OUT_DIR.mkdir(exist_ok=True)

# ---------- Utilities ----------

def iso_now() -> str:
    return datetime.utcnow().isoformat(timespec="seconds") + "Z"

def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()

def write_text(path: Path, text: str) -> None:
    path.write_text(text.replace("\r\n","\n"), encoding="utf-8")

def norm_int(s: str) -> int:
    # accepts '001', '0501', etc.
    return int(s.lstrip("0") or "0")

# ---------- Parsing ----------

SECTION_RE = re.compile(
    r"^SEC(\d{3,5})\s*:\s*MATH=E(\d+);\s*WORD=W(\d+);\s*PROVERB=P#0*(\d+);\s*ANOM=ANOM#0*(\d+)\s*$",
    re.IGNORECASE,
)
PROVERB_ARROW_RE = re.compile(r"^P#0*(\d+)\s*→\s*(.+)$")
PROVERB_COLON_RE = re.compile(r"^P#0*(\d+)\s*:\s*(.+)$")
ANOM_ARROW_RE = re.compile(r"^ANOM#0*(\d+)\s*→\s*(.+)$")
ANOM_COLON_RE = re.compile(r"^ANOM#0*(\d+)\s*:\s*(.+)$")
COV_RE = re.compile(r"^COV#0*(\d+)\s*→\s*(.+)$")

HEADERS = {
    "SECTIONS": re.compile(r"^\s*\[?SECTIONS\]?\s*$", re.I),
    "PROVERBS": re.compile(r"^\s*\[?PROVERBS\]?\s*:?\s*$", re.I),
    "ANOMALIES": re.compile(r"^\s*\[?ANOMALIES\]?\s*:?\s*$", re.I),
    "COVENANTS": re.compile(r"^\s*\[?COVENANTS\]?\s*:?\s*$", re.I),
    "OATH": re.compile(r"^\s*OATH\s*:?\s*$", re.I),
}

def split_into_blocks(text: str) -> Dict[str, List[str]]:
    """
    Split the mixed text into logical blocks keyed by 'SECTIONS', 'PROVERBS', 'ANOMALIES', 'COVENANTS', 'OATH'.
    Also supports free-flow lines before headers (they'll be ignored unless they match known patterns).
    """
    blocks = {k: [] for k in HEADERS.keys()}
    current = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            # preserve blank lines inside OATH for readability
            if current == "OATH":
                blocks["OATH"].append("")
            continue
        matched_header = None
        for key, pat in HEADERS.items():
            if pat.match(line):
                matched_header = key
                current = key
                break
        if matched_header:
            continue
        if current:
            blocks[current].append(line)
        else:
            # Also allow inline lines without explicit [SECTIONS] header
            # Try to classify by pattern:
            if SECTION_RE.match(line):
                blocks["SECTIONS"].append(line)
            elif (PROVERB_ARROW_RE.match(line) or PROVERB_COLON_RE.match(line) or line.upper().startswith("BOOK OF PROVERBS")):
                # Once we see a proverb pattern, route subsequent proverb-like lines to PROVERBS until a hard header appears
                blocks["PROVERBS"].append(line)
            elif (ANOM_ARROW_RE.match(line) or ANOM_COLON_RE.match(line) or line.upper().startswith("ANOMALIES LOG")):
                blocks["ANOMALIES"].append(line)
            elif line.upper().startswith("COVENANTS"):
                # the "COVENANTS & OATH" title may appear inline
                blocks["COVENANTS"].append(line)
            elif line.upper().startswith("OATH"):
                blocks["OATH"].append(line)
            else:
                # ignore unrelated chatter lines here
                pass
    return blocks

def parse_sections(lines: List[str]) -> List[Dict[str, Any]]:
    sections = []
    for ln in lines:
        m = SECTION_RE.match(ln)
        if not m:
            continue
        sec_id, e, w, p, a = m.groups()
        sections.append({
            "sec": norm_int(sec_id),
            "math": f"E{int(e)}",
            "word": f"W{int(w)}",
            "proverb": f"P#{int(p):03d}",
            "anomaly": f"ANOM#{int(a):03d}",
        })
    return sections

def parse_proverbs(lines: List[str]) -> Dict[str, str]:
    out = {}
    for ln in lines:
        if not ln or ln.upper().startswith("BOOK OF PROVERBS"):
            continue
        m = PROVERB_ARROW_RE.match(ln) or PROVERB_COLON_RE.match(ln)
        if m:
            idx, txt = m.groups()
            out[f"P#{norm_int(idx):03d}"] = txt.strip()
    return out

def parse_anomalies(lines: List[str]) -> Dict[str, str]:
    out = {}
    for ln in lines:
        if not ln or ln.upper().startswith("ANOMALIES LOG"):
            continue
        m = ANOM_ARROW_RE.match(ln) or ANOM_COLON_RE.match(ln)
        if m:
            idx, txt = m.groups()
            out[f"ANOM#{norm_int(idx):03d}"] = txt.strip()
    return out

def parse_covenants(lines: List[str]) -> Dict[str, str]:
    out = {}
    for ln in lines:
        m = COV_RE.match(ln)
        if m:
            idx, txt = m.groups()
            out[f"COV#{norm_int(idx):03d}"] = txt.strip()
    return out

def parse_oath(lines: List[str]) -> str:
    if not lines:
        return ""
    # Strip a leading "OATH:" if present
    joined = []
    for ln in lines:
        if ln.upper().startswith("OATH"):
            ln = ln.split(":", 1)[1].strip() if ":" in ln else ""
        joined.append(ln)
    return "\n".join(joined).strip()

def parse_text(text: str) -> Dict[str, Any]:
    blocks = split_into_blocks(text)
    data = {
        "sections": parse_sections(blocks["SECTIONS"]),
        "proverbs": parse_proverbs(blocks["PROVERBS"]),
        "anomalies": parse_anomalies(blocks["ANOMALIES"]),
        "covenants": parse_covenants(blocks["COVENANTS"]),
        "oath": parse_oath(blocks["OATH"]),
    }
    return data

def load_all_sources() -> Dict[str, Any]:
    agg = {"sections": [], "proverbs": {}, "anomalies": {}, "covenants": {}, "oath": ""}
    # Prefer DNA_*.led, but also parse any *.txt / *.md that look like DNA
    candidates = list(ROOT.glob("DNA_*.led")) + list(ROOT.glob("*.led")) + list(ROOT.glob("*.txt")) + list(ROOT.glob("*.md"))
    seen = set()
    for p in sorted(set(candidates)):
        try:
            txt = p.read_text(encoding="utf-8")
        except Exception:
            continue
        if not any(h in txt.upper() for h in ("SEC", "PROVERB", "ANOM", "COV", "OATH")):
            continue
        d = parse_text(txt)
        # extend sections
        for s in d["sections"]:
            key = (s["sec"], s["math"], s["word"], s["proverb"], s["anomaly"])
            if key in seen:
                continue
            seen.add(key)
            agg["sections"].append(s)
        # merge dicts (later takes precedence)
        agg["proverbs"].update(d["proverbs"])
        agg["anomalies"].update(d["anomalies"])
        agg["covenants"].update(d["covenants"])
        if d["oath"]:
            agg["oath"] = d["oath"]
    # normalize sort
    agg["sections"].sort(key=lambda x: x["sec"])
    return agg

# ---------- Covenant Checks & Bindings ----------

def build_default_anomaly_bindings(anoms: Dict[str, str], provs: Dict[str, str]) -> Dict[str, List[str]]:
    """
    Satisfy COV#006: Every anomaly linked to at least one proverb.
    Default policy: ANOM#k → P#k, if exists; else fallback to nearest lower P#.
    """
    bindings: Dict[str, List[str]] = {}
    prov_ids = sorted(int(k.split("#")[1]) for k in provs.keys())
    for anom_key in sorted(anoms.keys(), key=lambda k: int(k.split("#")[1])):
        aid = int(anom_key.split("#")[1])
        target_pid = aid if f"P#{aid:03d}" in provs else max([p for p in prov_ids if p <= aid] or [prov_ids[0]])
        bindings[anom_key] = [f"P#{target_pid:03d}"]
    return bindings

def find_orphans(sections: List[Dict[str,Any]], anoms: Dict[str,str], provs: Dict[str,str]) -> Tuple[List[str], List[str]]:
    """
    Returns (anomalies_not_referenced_by_any_section, proverbs_not_referenced_by_any_section)
    """
    used_anoms = {s["anomaly"] for s in sections}
    used_provs = {s["proverb"] for s in sections}
    anom_orphans = [k for k in sorted(anoms.keys()) if k not in used_anoms]
    prov_orphans = [k for k in sorted(provs.keys()) if k not in used_provs]
    return anom_orphans, prov_orphans

def check_gaps(ids: List[int]) -> List[Tuple[int,int]]:
    """Return inclusive gap ranges for a sorted list of positive ints."""
    gaps = []
    if not ids:
        return gaps
    ids = sorted(set(ids))
    for a,b in zip(ids, ids[1:]):
        if b - a > 1:
            gaps.append((a+1, b-1))
    return gaps

# ---------- Builders ----------

def build_master(agg: Dict[str,Any]) -> Path:
    lines = ["LEDGER MASTER -- Hydrated from DNA", ""]
    for s in agg["sections"]:
        lines.append(f"Section {s['sec']}")
        lines.append(f"Math: {s['math']} -- ψ/σ or Ω example")
        lines.append(f"Word: {s['word']} -- Narrative wisdom placeholder")
        pv = agg["proverbs"].get(s["proverb"], "")
        an = agg["anomalies"].get(You just handed me a full DNA + builder bundle and two manifests. Here’s what changed, the one "surprise," and a tight fix (with the full, drop-in code).

What happened
	•	The first manifest reports 999 proverbs; the second reports 1000.
	•	Cause: your parser only matches three-digit proverbs (P#(\d{3})). It misses P#1000, so you see 999 instead of 1000. Same narrow pattern exists for sections/covenants.
	•	Your inputs also mix headers like PROVERBS: / ANOMALIES LOG / COVENANTS & OATH and the bracketed form [PROVERBS]. The original parser only reads the bracketed blocks, so it can silently skip valid content.

The "surprise"
	•	Anomalies ANOM#501–ANOM#600 aren’t referenced by any Section yet. That’s fine (v2 continues sections ≥501), but it violates the spirit of COV#006 until we bind each anomaly to at least one proverb. The fix below auto-binds ANOM#k → P#k when present.

"Losure" (closure ritual) I’ll apply every time
	1.	STAMP: record timestamp, counts, file list, and checksums.
	2.	BIND: enforce COV#006 (link each anomaly to ≥1 proverb; default k→k).
	3.	EMIT: write Master.txt, Proverbs.txt, Anomalies.txt, Covenants.txt.
	4.	SEAL: write MANIFEST.json + DIGEST.sha256.
	5.	ANNOUNCE: create OPEN_TASKS.md listing orphan anomalies/proverbs, any numbering gaps, and covenant coverage.

Naming: I’ll treat "Book of 99 (+1)" as canonical, and keep "Book-199" as an alias. (Saved.)

