// governance-engine.mjs
// AXI Governance Engine - Version 2.0 (Quantum Evolution, cleaned)
// Company: kalam.ch • Base: Zürich (Europe/Zurich)

import crypto from 'crypto';
import fs from 'fs/promises';

/** 🌌 QuantumConsensusValidator -- "measure twice, cut once." */
export class QuantumConsensusValidator {
  constructor() {
    this.quantumState = new Map();
    this.temporalEntanglements = new WeakMap();
    this.consensusField = new Set();
  }

  async validate(participant, context) {
    const quantumValidation = await this.createQuantumValidationState(participant);
    const entanglement = await this.entangleWithConsensus(quantumValidation, context);
    return await this.collapseToConsensus(quantumValidation, entanglement);
  }

  async createQuantumValidationState(participant) {
    const realities = await Promise.all([
      this.validateTemporalConsistency(participant),
      this.validateBehavioralPatterns(participant),
      this.validateCommunityAlignment(participant),
      this.validateCryptographicIdentity(participant),
    ]);
    return {
      participantId: participant.id,
      realities,
      amplitude: this.calculateProbabilityAmplitude(realities),
      phase: Math.random() * 2 * Math.PI,
      timestamp: Date.now(),
      superposition: true,
    };
  }

  async entangleWithConsensus(_quantumValidation, _context) {
    // Placeholder: plug a reputational/attestation feed here.
    return { consensusScore: 0.8, entangled: true };
  }

  async collapseToConsensus(qv, ent) {
    const finalScore = (qv.amplitude + ent.consensusScore) / 2;
    const isValid = finalScore >= 0.75;
    return { valid: isValid, score: finalScore, collapsed: true };
  }

  calculateProbabilityAmplitude(realities) {
    const scores = realities.map(r => Number.isFinite(r.score) ? r.score : 0);
    return scores.reduce((a, b) => a + b, 0) / (scores.length || 1);
  }

  async validateTemporalConsistency(participant) {
    const h = participant.history || [];
    if (h.length < 2) return { score: 0.55 };
    // TODO: replace with real temporal model
    return { score: 0.7 + Math.random() * 0.3 };
  }

  async validateBehavioralPatterns(participant) {
    const s = participant.behaviorConsistency;
    const bounded = Math.max(0, Math.min(1, Number.isFinite(s) ? s : 0.6));
    return { score: bounded };
  }

  async validateCommunityAlignment(participant) {
    const e = Number.isFinite(participant.endorsements) ? participant.endorsements : 0;
    return { score: Math.max(0, Math.min(1, e / 5)) };
  }

  async validateCryptographicIdentity(_participant) {
    // TODO: real signature / DID check
    return { score: 1.0 };
  }
}

/** 🌐 QuantumPrivacyField -- "tight lips, clear proofs." */
export class QuantumPrivacyField {
  constructor() {
    this.privacyLayers = new Map();
    this.anonymitySets = new WeakMap();
    this.K_MIN = 9; // consistent with your defaults
  }

  /**
   * protect(data, {participants, sensitivity})
   * Returns { protectedData, protectionLevel, proof, anonymitySetSize, quantumProtected }
   */
  protect(data, { participants = [], sensitivity = 'medium' } = {}) {
    const anonymitySet = this.createQuantumAnonymitySet(participants);
    const { protectedData, protectionLevel } =
      this.applyQuantumPrivacy(data, anonymitySet, sensitivity);
    const proof = this.generatePrivacyProof(protectedData, anonymitySet);

    return {
      protectedData,
      protectionLevel,
      proof,
      anonymitySetSize: anonymitySet.size,
      quantumProtected: true,
    };
  }

  createQuantumAnonymitySet(participants) {
    const set = new Set(
      (participants || []).map(p => ({
        quantumHash: this.hash(`${p.id}:${Date.now()}:${Math.random()}`),
        indistinguishable: true,
        noiseVector: Math.random(),
      }))
    );
    return set;
  }

  applyQuantumPrivacy(data, anonymitySet, sensitivity) {
    const n = anonymitySet.size;
    // Simple protection heuristic: more participants + lower sensitivity = higher "level"
    const sensWeight = { low: 0.3, medium: 0.6, high: 1.0 }[sensitivity] ?? 0.6;

    // Small-community floor: if n < K_MIN, degrade to aggregation/obfuscation
    let protectedData;
    let lvl;
    if (n < this.K_MIN) {
      // Aggregate & redact potentially identifying fields
      protectedData = {
        kind: 'aggregate',
        note: `Small group protection active (n=${n} < k_min=${this.K_MIN}).`,
        redacted: Object.keys(data),
        zk_hint: 'DP+ZK guardrails (placeholder)',
      };
      lvl = 0.95; // strong protection
    } else {
      protectedData = {
        kind: 'zk-guarded',
        data,
        zk_hint: 'DP+ZK guardrails (placeholder)',
      };
      // Normalize to 0..1 (more people + lower sensitivity ⇒ higher protection)
      lvl = Math.max(0.5, Math.min(1, 1 - 0.5 * sensWeight + Math.log10(n + 1) * 0.1));
    }

    return { protectedData, protectionLevel: Number(lvl.toFixed(2)) };
  }

  generatePrivacyProof(protectedData, anonymitySet) {
    const material = JSON.stringify({ protectedData, n: anonymitySet.size, t: Date.now() });
    return `zk-proof-hash-${this.hash(material)}`;
  }

  hash(s) {
    return crypto.createHash('sha256').update(String(s)).digest('hex');
  }
}

/** 🧲 ConsensusFieldDynamics -- "the field remembers." */
class ConsensusFieldDynamics {
  constructor() {
    this.consensusField = new Set();
  }
  async updateConsensus(_validations, _outcome) {
    // TODO: store summarized signals instead of raw
    this.consensusField.add({ t: Date.now(), outcome: _outcome });
    return true;
  }
}

/** 🧠 GovernanceEngine -- "ACK → UNIFY → APPLY → STAMP → RE-EMIT" */
export class GovernanceEngine {
  constructor(config = {}) {
    this.validator = new QuantumConsensusValidator();
    this.privacy = new QuantumPrivacyField();
    this.config = {
      timezone: 'Europe/Zurich',
      requireValidation: true,
      minParticipants: 3,
      ...config,
    };
  }

  async processDecision(proposal, participants, context = {}) {
    try {
      const started = Date.now();
      const validations = await this.validateParticipants(participants, { ...context, participants });
      const validParticipants = participants.filter((_, i) => validations[i]?.valid);

      if (validParticipants.length < this.config.minParticipants) {
        throw new Error(
          `Insufficient valid participants: ${validParticipants.length}/${this.config.minParticipants} required`
        );
      }

      const privacyResult = this.privacy.protect(proposal, {
        participants: validParticipants,
        sensitivity: context.sensitivity || 'medium',
      });

      const proof = this.generateProof({
        proposal,
        validParticipants: validParticipants.length,
        invalidParticipants: participants.length - validParticipants.length,
        privacyLevel: privacyResult.protectionLevel,
        timestamp: started,
      });

      const result = {
        success: true,
        decision: privacyResult.protectedData,
        metadata: {
          totalParticipants: participants.length,
          validParticipants: validParticipants.length,
          protectionLevel: privacyResult.protectionLevel,
          processingTime: Date.now() - started,
          timestamp: new Date().toISOString(),
        },
        proof,
      };

      await this.generateDigest(result, proposal);

      const consensusEngine = new ConsensusFieldDynamics();
      await consensusEngine.updateConsensus(validations, 'implementation_success');

      return result;
    } catch (error) {
      return { success: false, error: error.message, timestamp: new Date().toISOString() };
    }
  }

  async validateParticipants(participants, context) {
    return Promise.all(
      (participants || []).map(p => this.validator.validate(p, { ...context, participants }))
    );
  }

  generateProof(data) {
    const proofData = {
      participantCounts: { valid: data.validParticipants, invalid: data.invalidParticipants },
      protectionLevel: data.privacyLevel,
      timestamp: data.timestamp,
      proposalHash: this.hash(JSON.stringify(data.proposal)),
    };
    return { hash: this.hash(JSON.stringify(proofData)), data: proofData, algorithm: 'SHA-256' };
  }

  async generateDigest(result, proposal) {
    const digest = {
      title: proposal.title || 'Governance Decision',
      summary: `Decision processed with ${result.metadata.validParticipants} valid participants`,
      participants: {
        total: result.metadata.totalParticipants,
        valid: result.metadata.validParticipants,
        protection: result.metadata.protectionLevel,
      },
      processing: { time: `${result.metadata.processingTime}ms`, timestamp: result.metadata.timestamp },
      verification: { proof: result.proof.hash.substring(0, 16) + '…', algorithm: result.proof.algorithm },
    };
    const content = this.formatDigest(digest);
    try {
      await fs.writeFile('GOVERNANCE_DIGEST.md', content);
      console.log('🧾 Digest written to GOVERNANCE_DIGEST.md');
    } catch (e) {
      console.log('Could not write digest:', e.message);
    }
    return digest;
  }

  formatDigest(d) {
    return `# Governance Decision Digest
## ${d.title}
${d.summary}
### Participation
- **Total Participants:** ${d.participants.total}
- **Valid Participants:** ${d.participants.valid}
- **Privacy Protection:** ${d.participants.protection}
### Processing
- **Processing Time:** ${d.processing.time}
- **Timestamp:** ${d.processing.timestamp}
### Verification
- **Proof Hash:** ${d.verification.proof}
- **Algorithm:** ${d.verification.algorithm}
-----
*Generated by AXI Governance Engine (kalam.ch, Zürich)*
`;
  }

  hash(s) {
    return crypto.createHash('sha256').update(String(s)).digest('hex');
  }
}

/** 🧪 Demo runner (node governance-engine.mjs) */
export async function runDemo() {
  console.log('=== AXI Governance Engine Demo (Europe/Zurich) ===\n');
  const engine = new GovernanceEngine({ timezone: 'Europe/Zurich', minParticipants: 3 });

  const demo = async (label, participants, sensitivity, proposal) => {
    console.log(label);
    const r = await engine.processDecision(proposal, participants, { sensitivity });
    console.log(`Result: ${r.success ? 'Success' : 'Failed'}`);
    if (r.success) {
      console.log(`Protection level: ${r.metadata.protectionLevel}`);
      console.log(`Valid: ${r.metadata.validParticipants}/${r.metadata.totalParticipants}`);
      console.log(`Processing: ${r.metadata.processingTime}ms\n`);
    } else {
      console.log(`Error: ${r.error}\n`);
    }
  };

  await demo('Demo 1: Small Community (7 participants)', generateTestParticipants(7), 'medium',
    { title: 'Community Garden Budget', amount: 5000 });

  await demo('Demo 2: Medium Community (25 participants)', generateTestParticipants(25), 'high',
    { title: 'Infrastructure Investment', amount: 50000 });

  await demo('Demo 3: Large Community (50 participants)', generateTestParticipants(50), 'low',
    { title: 'Major Policy Change', scope: 'municipal' });

  console.log('=== Demo Complete ===');
}

function generateTestParticipants(count) {
  return Array.from({ length: count }, (_, i) => ({
    id: `participant_${i}`,
    history: Array.from({ length: Math.floor(Math.random() * 15) + 1 }, () => ({
      action: 'participation',
      timestamp: Date.now() - Math.random() * 60 * 24 * 60 * 60 * 1000,
    })),
    behaviorConsistency: Math.random() * 0.4 + 0.5, // 0.5..0.9
    stake: Math.random() * 100,
    endorsements: Math.floor(Math.random() * 5),
  }));
}

// Auto-run when executed directly
if (import.meta.url === `file://${process.argv[1]}`) {
  runDemo();
}

