// canon.js
import {sha256, blake3, canonicalJsonHash} from "./hashes.js";
export function canonStamp(obj, anchors) {
  const ts = median([Date.now(), anchors.ntp, anchors.anchorTime]);
  const cjson = canonicalize(obj);
  const h1 = sha256(cjson), h2 = blake3(cjson), h3 = canonicalJsonHash(cjson);
  const composite = xorHashes([h1,h2,h3]);
  return {ts, hashes:{sha256:h1, blake3:h2, cjson:h3, composite}};
}
