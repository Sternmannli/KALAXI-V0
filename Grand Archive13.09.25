  reliability: "<MTTRΔ, rollback fidelity>"
  abuse_resistance: "<Sybil/coord precision/recall>"
ethics_notes: "<consent, bias, surveillance risks>"
swiss_notes: "<DPA articles, AML triggers, storage locality>"
deps: "<people/libraries/data needed>"
estimates:
  effort: "<S/M/L>"
  runtime_cost: "<$ or compute class>"
decision: "<go | learn-more | no-go>"
signature: "@<role-handle>"

Ground rules
