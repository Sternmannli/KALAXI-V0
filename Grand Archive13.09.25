Preview (no write):
for f in cathedral.manifest.v0.1-spec.json RUN_LOG_APEX_*.json major_policy_change_donor_1.json; do
  [ -f "$f" ] && ./axi_canon_check.sh "$f" || true
done
Apply (write canonical back):
for f in cathedral.manifest.v0.1-spec.json RUN_LOG_APEX_*.json major_policy_change_donor_1.json; do
  [ -f "$f" ] && ./axi_canon.py < "$f" > "$f.canon" && mv "$f.canon" "$f" || true
done
 
Optional guardrail (Git pre-commit hook)

Creates a gentle fail if any JSON is non-canonical.

.git/hooks/pre-commit:
#!/usr/bin/env bash
fail=0
jsons=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.json$' || true)
[ -z "$jsons" ] && exit 0
for f in $jsons; do
  if [ -f "$f" ]; then
    ./axi_canon_check.sh "$f" || fail=1
  fi
done
exit $fail
chmod +x .git/hooks/pre-commit
 
